@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Components.Shared.Summaries

@inject DialogService DialogService
@inject NavigationManager NavigationManager

<RadzenStack>
	<CashDiscountSummary Rows="Rows" RequestAudit="RequestAudit" />

	<RadzenRow JustifyContent="JustifyContent.End" Gap="0.5rem">
		<RadzenStack Visible="true" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
			<button @onclick="@((args) => DialogService.Close(true))" class="btn btn-outline-dark">
				Close
			</button>
			<button @onclick="@Submit" class="btn btn-dark">
				Export
			</button>
		</RadzenStack>
	</RadzenRow>
</RadzenStack>
@code {
	[Parameter] public IEnumerable<CashDiscountRowDto> Rows { get; set; }
	[Parameter] public Func<Task> OnSubmit { get; set; }
	[Parameter] public RequestAuditDto RequestAudit { get; set; }
	[Parameter] public string SucccessSubmissionRoute { get; set; }

	public async Task Submit()
	{
		try
		{
			NavigationManager.NavigateTo(SucccessSubmissionRoute, true);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task Export()
	{
		try
		{
			await DialogService.Alert("Can't Export. This is not yet Implemented", "Request Export Failed");
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Export Failed");
		}
	}
}
