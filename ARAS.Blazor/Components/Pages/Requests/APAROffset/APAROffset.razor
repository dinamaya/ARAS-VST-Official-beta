@page "/requests/apar-offset"

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting.Modal
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Requestor")]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject ICashDiscountService CashDiscountService

<h2>AP AR : Offset</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />

	<RadzenRow Gap="1.5rem">
		<RadzenColumn Size="6">
		<div  class="text-center">
			<h3 class="pb-0 mb-0">AP GROUP</h3>
		</div>
			<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid @ref="adjustmentGrid"
							AllowFiltering="false"
							AllowColumnResize="true"
							AllowAlternatingRows="false"
							AllowSorting="true"
							PageSize="20"
							AllowPaging="true"
							PagerHorizontalAlign="HorizontalAlign.Left"
							ShowPagingSummary="true"
							Data="@APAdjustments"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice Number">
						<FooterTemplate>
							<b>Total Amount:</b>
						</FooterTemplate>
					</RadzenDataGridColumn>
						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Invoice Amount">
						<Template Context="data">
							@data.InvoiceAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
						</Template>
						<FooterTemplate>
								<b>@APAdjustments.Sum(a => a.InvoiceAmount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b>
							</FooterTemplate>
					</RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</div>
		</RadzenColumn>
		<RadzenColumn Size="6">
			<div class="text-center">
				<h3 class="pb-0 mb-0">AR GROUP</h3>
			</div>

			<div class="py-4 px-3 w-100 card">
				<RadzenDataGrid TItem="APAROffsetARRowDto"
								@ref="arGrid"
								Data="@ARAdjustments"
								AllowFiltering="false"
								AllowPaging="false"
								AllowSorting="false"
								EditMode="DataGridEditMode.Single"
								AllowRowInsert="true"
								AllowRowEdit="true"
								AllowRowDelete="true"
								RowCreate="@OnCreateRow"
								RowUpdate="@OnUpdateRow"
								RowRemove="@OnRemoveRow"
								ShowPagingSummary="false">

					<Columns>
						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Title="Description">
							<Template Context="data">
								@if (data.RowType == ARRowType.Invoice)
								{
									@data.InvoiceNumber
								}
								else
								{
									@data.AdjustmentReason
								}
							</Template>

							<EditTemplate Context="data">
								@if (data.RowType == ARRowType.Invoice)
								{
									<RadzenTextBox @bind-Value="data.InvoiceNumber" Style="width:100%" />
								}
								else
								{
									<RadzenDropDown @bind-Value="data.AdjustmentReason"
													Data="@adjustmentReasons"
													Style="width:100%" />
								}
							</EditTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Property="Amount" Title="Amount">
							<Template Context="data">
								@data.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
							</Template>
							<EditTemplate Context="data">
								<RadzenNumeric @bind-Value="data.Amount"
											   Style="width:100%"
											   Step="0.01"
											   Min="0" />
							</EditTemplate>

							<FooterTemplate>
								<b>Total:</b> @ARAdjustments.Sum(a => a.Amount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))
							</FooterTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Context="data" TextAlign="TextAlign.Center" Width="150px">
							<Template Context="data">
								<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@((args) => arGrid.EditRow(data))" />
								<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@((args) => OnRemoveRow(data))" />
							</Template>
							<EditTemplate Context="data">
								<RadzenButton Icon="save" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@((args) => arGrid.UpdateRow(data))" />
								<RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@((args) => arGrid.CancelEditRow(data))" />
							</EditTemplate>
						</RadzenDataGridColumn>
					</Columns>
				</RadzenDataGrid>
				<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mt-2 rz-mb-2" JustifyContent="JustifyContent.Center">
					<RadzenButton Text="Add Invoice no." Icon="add" ButtonStyle="ButtonStyle.Primary"
								   Click="@(args => AddInvoiceRow())" Style="min-width:140px" Size="ButtonSize.ExtraSmall" />

					<RadzenButton Text="Add Adjustment Reason" Icon="add_circle" ButtonStyle="ButtonStyle.Secondary"
								   Click="@(args => AddAdjustmentReasonRow())" Style="min-width:200px" Size="ButtonSize.ExtraSmall" />
				</RadzenStack>
		</div>

		</RadzenColumn>
	</RadzenRow>

	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter] public IList<APAROffsetAPRowDto> APAdjustments { get; set; }
	[Parameter] public IList<APAROffsetARRowDto> ARAdjustments { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<APAROffsetAPRowDto> adjustmentGrid;
	private RequestAuditDto requestAudit;

	private bool isOnSearch;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		APAdjustments = new List<APAROffsetAPRowDto>();
		ARAdjustments = new List<APAROffsetARRowDto>();
		searchedInvoiceNumber = new InvoiceDetailsDto(); 
		requestAudit = new RequestAuditDto();

		requestAudit.Requestor = await AuthService.GetLastFirstName();
	}

	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		await DialogService.OpenAsync<AddAPAROffsetting>(
			"Confirm Invoice Number",
			new Dictionary<string, object>()
			{
				{ "Rows", APAdjustments },
				{ "Grid", adjustmentGrid },
				{ "InvoiceDetails", invoiceDetails }
			},
			new DialogOptions() { Width = "800px", Height = "auto" }
		);
	}

	public async Task OpenEdit(APAROffsetAPRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditARInvoiceOffsetting>(
				"Edit Cash Discount Adjustment",
				new Dictionary<string, object>()
				{
				{ "Rows", APAdjustments },
				{ "Grid", adjustmentGrid },
				{ "Data", data }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			if (!ARAdjustments.Any())
				throw new InvalidOperationException("Can't submit request because there are no adjustment in the current request");

			if (isLoading)
				throw new InvalidOperationException("Can't submit request while search operation is ongoing");

			await DialogService.OpenAsync<ARInvoiceOffsettingModalSummary>(
				"Submit AR Invoice Offsetting",
				new Dictionary<string, object>()
				{
					{ "Rows", APAdjustments },
					{ "RequestAudit", requestAudit },
					{ "OnSubmit", SubmitRequest },
					{ "SucccessSubmissionRoute", "/requests/ar-invoice-offsetting" },
				},
				new DialogOptions() { Width = "1500px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		// await CashDiscountService.Create(Adjustments, no);
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

	private RadzenDataGrid<APAROffsetARRowDto> arGrid;

	private async Task AddInvoiceRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			RowType = ARRowType.Invoice,
			InvoiceNumber = string.Empty,
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		await arGrid.Reload();
		await InvokeAsync(() =>
		{
			arGrid.EditRow(newRow);
		});
	}

	private async Task AddAdjustmentReasonRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			RowType = ARRowType.Adjustment,
			AdjustmentReason = null,
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		await arGrid.Reload();
		await InvokeAsync(() =>
		{
			arGrid.EditRow(newRow);
		});
	}

	private void OnCreateRow(APAROffsetARRowDto item)
	{
		// ARAdjustments.Add(item);
	}

	private void OnUpdateRow(APAROffsetARRowDto item)
	{
		// Optionally save to temporary collection or validate
	}

	private async Task OnRemoveRow(APAROffsetARRowDto item)
	{
		ARAdjustments.Remove(item);
		await arGrid.Reload();
	}

	private List<string> adjustmentReasons = new()
	{
		"Write Off",
		"Bank Charge",
		"Discount"
	};

}
