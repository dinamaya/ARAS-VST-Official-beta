@using ARAS.Blazor.Components.Shared
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Models.DTOs

@inject IInvoiceService InvoiceService
@inject IConfigService ConfigService
@inherits ComponentBase

<MainSearchBar OnSearch="HandleSearch" TextFields="textFields" SearchGroups="@(UseRecordTypeSearch ? SearchGroups : null)" OnSearchGroupChangedCallback="HandleSearchGroupChanged" PlaceSearchButtonBelowDate="@PlaceSearchButtonBelowDate" AlignSearchFields="@AlignSearchFields">
	<ResultTemplate Context="isLoading">
		@if (ResultHeader is not null)
		{
			@ResultHeader
		}
		<SearchInvoiceDataTable IsLoading="isLoading" InvoiceRows="results" Select="OnSelectChanged" ShowReceiptColumns="@isReceiptSearch" />
	</ResultTemplate>
</MainSearchBar>

@code{
	[Parameter] public EventCallback<InvoiceDetailsDto> OnSelectInvoice { get; set; }
	[Parameter] public EventCallback<bool> OnReceiptSearchChanged { get; set; }
	[Parameter] public EventCallback<string> OnSearchGroupChanged { get; set; }
	[Parameter] public bool UseRecordTypeSearch { get; set; }
	[Parameter] public bool PlaceSearchButtonBelowDate { get; set; }
	[Parameter] public bool AlignSearchFields { get; set; }
	[Parameter] public RenderFragment? ResultHeader { get; set; }
	private IEnumerable<InvoiceDetailsDto> results { get; set; }
	private IEnumerable<string> textFields { get; set; }
	private bool isReceiptSearch;
	private Dictionary<string, IEnumerable<string>> SearchGroups { get; set; } = new()
	{
		["Invoice"] = ["Invoice Number", "Invoice Customer Name"],
		["Receipt"] = ["Receipt Number", "Receipt Customer Name"]
	};

	protected override async Task OnInitializedAsync()
	{
		textFields = ConfigService.GetRequstorSearchInvoiceCategories();
		SearchGroups = ConfigService.GetRequestorSearchGroups();
	}

	private async Task HandleSearch(SearchRequestDto request)
	{
		isReceiptSearch = request.Category.StartsWith("Receipt", StringComparison.OrdinalIgnoreCase);
		await OnReceiptSearchChanged.InvokeAsync(isReceiptSearch);
		results = isReceiptSearch
			? await InvoiceService.GetReceiptDetailsList(request)
			: await InvoiceService.GetDetailsList(request);
	}

	private async Task HandleSearchGroupChanged(string group)
	{
		await OnSearchGroupChanged.InvokeAsync(group);
	}

	protected async Task OnSelectChanged(InvoiceDetailsDto invoiceDetails)
	{
		invoiceDetails.OriginalInvoiceBalance ??= invoiceDetails.InvoiceBalance;
		invoiceDetails.OriginalReceiptBalance ??= invoiceDetails.ReceiptBalance;
		await OnSelectInvoice.InvokeAsync(invoiceDetails);
	}
}
