@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Models.DTOs
@inject DialogService DialogService

<RadzenCard Style="padding:1rem;">
    <ChildContent>
        <RadzenStack Gap="1em" Orientation="Orientation.Vertical">
            <RadzenSelectBar @bind-Value="selectedSource" TValue="string">
                <Items>
                    <RadzenSelectBarItem Text="AP" Value="@("AP")" />
                    <RadzenSelectBarItem Text="AR" Value="@("AR")" />
                </Items>
            </RadzenSelectBar>
            <RadzenStack Gap="0.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
                @if (selectedSource == "AR")
                {
                    <h3 style="margin:0 0 0rem 0">AR Invoice Search</h3>
                    <SearchInvoiceDetails OnAdd="OpenAddAR" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />
                }
                else
                {
                    <h3 style="margin:0 0 0rem 0">AP Invoice Search</h3>   
                    <SearchInvoiceAPDetails OnAdd="OpenAddAP" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />
                }
            </RadzenStack>
        </RadzenStack>
    </ChildContent>
</RadzenCard>

@code {
    private string selectedSource = "AP"; // Default to AP

    [Parameter] public IList<APAROffsetAPRowDto> APAdjustments { get; set; }
    [Parameter] public IList<APAROffsetARRowDto> ARAdjustments { get; set; }

    [Parameter] public RadzenDataGrid<APAROffsetAPRowDto> APGrid { get; set; }
    [Parameter] public RadzenDataGrid<APAROffsetARRowDto> ARGrid { get; set; }

    private bool isOnSearch;
    private bool isLoading;

    public async Task OpenAddAR(InvoiceDetailsDto invoiceDetails)
    {
        await DialogService.OpenAsync<AddAPAROffsettingAR>(
            "Confirm AR Invoice Number",
            new Dictionary<string, object>()
            {
                { "Rows", ARAdjustments },
                { "Grid", ARGrid },
                { "InvoiceDetails", invoiceDetails }
            },
            new DialogOptions() { Width = "800px", Height = "auto" }
        );
    }

    public async Task OpenAddAP(InvoiceDetailsDto invoiceDetails)
    {
        await DialogService.OpenAsync<AddAPAROffsettingAP>(
            "Confirm AP Invoice Number",
            new Dictionary<string, object>()
            {
                { "Rows", APAdjustments },
                { "Grid", APGrid },
                { "InvoiceDetails", invoiceDetails }
            },
            new DialogOptions() { Width = "800px", Height = "auto" }
        );
    }

    private void HandleSearchChanged(bool value)
    {
        isOnSearch = value;
    }

    private void HandleLoadingChanged(bool value)
    {
        isLoading = value;
    }
}