@page "/requests/cash-discount"
@attribute [Authorize(Roles = "Requestor")]
@inherits CreateRequestBaseComponent<CashDiscountRowDto, ICashDiscountService>

@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@inject DialogService DialogService
@inject ITestService TestService

<h2>Cash Discount</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="OnLoadingChanged" OnSearchChanged="OnSearchToggle" />
	<CashDiscountDataTable @ref="dataTable" Adjustments="Adjustments" ReasonCodes="ReasonCodes" AdjustmentActivity="@AdjustmentActivity"/>
	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>

@code {
	private CashDiscountDataTable dataTable;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		await TestService.GenerateAdjustmentRows(Adjustments, ReasonCodes, AdjustmentActivity);
		await dataTable.Reload();
	}

	protected async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		await ModalTemplates.Add.CashDiscount(
			DialogService,
			dataTable.DataGrid,
			Adjustments,
			ReasonCodes,
			invoiceDetails,
			AdjustmentActivity
		);
	}

	protected override async Task OnSubmit()
	{
		try
		{
			await base.OnSubmit();

			await ModalTemplates.Summary.CashDiscount(DialogService, Adjustments, RequestAudit, SubmitRequest);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}
}
