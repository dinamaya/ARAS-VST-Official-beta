@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces

@inject IInvoiceService InvoiceService
@inject DialogService DialogService
@inherits ComponentBase

<RadzenRow>
	<div class="px-3 pt-2 pb-0 w-100 card">
		<RadzenRow AlignItems="AlignItems.Start"
				   JustifyContent="JustifyContent.Start"
				   class="w-100"
				   Gap="1rem">
			<RadzenColumn Size="12"
						  SizeLG="8"
						  SizeMD="7"
						  SizeXL="10">
				<RadzenFormField class="w-100 border-0" Text="Invoice Number" Variant="Variant.Outlined">
					<RadzenTextBox @bind-Value="@searchInvoiceNo" />
				</RadzenFormField>
			</RadzenColumn>
			<RadzenColumn Size="12"
						  SizeMD="5"
						  SizeLG="4"
						  SizeXL="2">
				<RadzenContent>
					<button class="btn btn-primary w-100 mt-2" @onclick="SearchInvoice">
						Search
					</button>
				</RadzenContent>
			</RadzenColumn>
		</RadzenRow>
	</div>
</RadzenRow>

@if (isOnSearch)
{
	<div>
		<h3 class="pb-0 mb-0">Search Result</h3>
	</div>
	<RadzenRow>
		<div class="card blur shadow-blur w-100">
			<div class="card-header shadow-lg">
				<RadzenRow>
					<RadzenColumn Size="12" SizeMD="6" SizeLG="8">
						<div class="d-flex align-items-center">
							<div class="icon-shape bg-gradient-dark shadow text-center border-radius-md">
								<div>
									<RadzenIcon Icon="receipt_long" />
								</div>
							</div>
							<div class="ms-3">
								<h3 class="mb-0 d-block">Invoice Details</h3>
								@if (isLoading)
								{
									<RadzenRow class="pt-2" Style="width: 15em">
										<RadzenSkeleton Animation="SkeletonAnimation.Wave" class="w-100" Style="height:15px;" />
									</RadzenRow>
								}
								else
								{
									<span class="text-sm text-dark opacity-8">@Utils.GetTimestamp("Date issued ", invoiceDetails.InvoiceDate)</span>
								}
							</div>
						</div>
					</RadzenColumn>

					<RadzenColumn Size="12" SizeMD="6" SizeLG="4" class="d-flex align-items-center justify-content-end mt-md-0 mt-3">
						@if (!isLoading)
						{
							<button class="btn btn-primary border-1 my-0 px-5 w-100 w-md-auto" @onclick="@(args => OnAdd.InvokeAsync(invoiceDetails))">
								<i class="fa-regular fa-add d-md-none d-lg-inline-block"></i>
								<span class="ms-1">Add Adjustment</span>
							</button>
						}
					</RadzenColumn>
				</RadzenRow>
			</div>
			<div class="card-body overflow-auto overflow-x-hidden">
				<RadzenRow class="py-3" Gap="1em">
					<RadzenColumn Size="12" SizeLG="5">
						<h4 class="mb-3">Invoice Number</h4>
						<div class="border-dashed border-1 border-secondary border-radius-md p-3">
							<div class="d-flex align-items-center">
								<div class="form-group w-100">
									@if (isLoading)
									{
										<RadzenRow class="w-100">
											<RadzenSkeleton Animation="SkeletonAnimation.Wave" class="w-100" Style="height:25px;" />
										</RadzenRow>
									}
									else
									{
										<div class="input-group bg-gray-200">
											<input class="form-control form-control-sm" @bind-value="@invoiceDetails.InvoiceNumber" type="text" disabled>
										</div>
									}
								</div>
								<button class="btn btn-sm btn-outline-secondary ms-2 px-3">Copy</button>
							</div>
							<p class="text-xs mb-1">You cannot generate <b>Invoice Number</b></p>
						</div>
					</RadzenColumn>

					<RadzenColumn Size="12" SizeLG="7" class="mt-3 mt-lg-0">
						<h4 class="mb-3">Other Information</h4>
						<RadzenRow Gap="1em" class="border-0 p-3 border-radius-md bg-gray-100">
							@if (isLoading)
							{
								<RadzenColumn Size="12" SizeMD="6">
									<div class="mb-2 text-sm">
										Customer Name:
										<RadzenSkeleton Animation="SkeletonAnimation.Wave" class="w-100" Style="height:15px;" />
									</div>
									<div class="mb-2 text-sm">
										Customer Number:
										<RadzenSkeleton Animation="SkeletonAnimation.Wave" class="w-100" Style="height:15px;" />
									</div>
								</RadzenColumn>
								<RadzenColumn Size="12" SizeMD="6">
									<div class="mb-2 text-sm">
										Invoice Date:
										<RadzenSkeleton Animation="SkeletonAnimation.Wave" class="w-100" Style="height:15px;" />
									</div>
									<div class="mb-2 text-sm">
										Invoice Amount:
										<RadzenSkeleton Animation="SkeletonAnimation.Wave" class="w-100" Style="height:15px;" />
									</div>
								</RadzenColumn>
							}
							else
							{
								<RadzenColumn Size="12" SizeMD="6">
									<div class="mb-2 text-sm">Customer Name: <div class="text-dark font-weight-bold ms-2">@invoiceDetails.CustomerName</div></div>
									<div class="mb-2 text-sm">Customer Number: <div class="text-dark ms-2 font-weight-bold letter-spacing-1">@invoiceDetails.CustomerNumber</div></div>
								</RadzenColumn>
								<RadzenColumn Size="12" SizeMD="6">
									<div class="mb-2 text-sm">Invoice Date: <div class="text-dark font-weight-bold ms-2">@invoiceDetails.InvoiceDate</div></div>
									<div class="mb-2 text-sm">Invoice Amount: <div class="text-dark font-weight-bold ms-2">@invoiceDetails.InvoiceAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))</div></div>
								</RadzenColumn>
							}
						</RadzenRow>
					</RadzenColumn>
				</RadzenRow>
			</div>
		</div>
	</RadzenRow>
}
@code {
	[Parameter] public EventCallback<InvoiceDetailsDto> OnAdd { get; set; }
	[Parameter] public EventCallback<bool> OnSearchChanged { get; set; }
	[Parameter] public EventCallback<bool> OnLoadingChanged { get; set; }

	private InvoiceDetailsDto invoiceDetails { get; set; }
	private bool isOnSearch { get; set; }
	private bool isLoading { get; set; }
	private string searchInvoiceNo = "";

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	public async Task SearchInvoice()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(searchInvoiceNo.Length < 3, "Please provided 3 or more character in the search invoice number field");

			if (isLoading)
			{
				await DialogService.Alert("Please wait until the current search operation is complete");
				return;
			}

			await SetIsOnSearch(true);
			await SetIsLoading(true);

			invoiceDetails = await InvoiceService.GetDetails(searchInvoiceNo);
		}
		catch (Exception ex)
		{
			await SetIsOnSearch(false);
			await DialogService.Alert(ex.Message, "Search Invoice Number Details failed");
		}
		await SetIsLoading(false);
	}


	private async Task SetIsOnSearch(bool value)
	{
		isOnSearch = value;
		await OnSearchChanged.InvokeAsync(value);
	}

	private async Task SetIsLoading(bool value)
	{
		isLoading = value;
		await OnLoadingChanged.InvokeAsync(value);
	}
}