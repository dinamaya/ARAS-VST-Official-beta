@page "/requests/receipt"
@attribute [Authorize(Roles = "Requestor")]
@inherits CreateReceiptRequestBaseComponent

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Others
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject DialogService DialogService
@inject NavigationManager NavManager
@inject IAdjustmentService AdjustmentService
@inject IRequestService RequestService
@inject IQueryService QueryService
@inject IJSRuntime JS
<h2>Receipt Adjustment</h2>

<FusionPostingOverlay @ref="submitOverlay" />

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnSelectInvoice="OnInvoiceSelected" OnReceiptSearchChanged="SetReceiptSearch" OnSearchGroupChanged="HandleSearchGroupChanged" UseRecordTypeSearch="true" PlaceSearchButtonBelowDate="true" AlignSearchFields="true">
		<ResultHeader>
			@if (Utils.Equals(QueryAction, Queries.Success.CREATE))
			{
				<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
					Receipt Adjustment created successfully
				</RadzenAlert>
			}
		</ResultHeader>
	</SearchInvoiceDetails>
	@code { [Parameter, SupplyParameterFromQuery(Name = "q")] public string? QueryAction { get; set; } }
	@if (isReady && !string.IsNullOrEmpty(SearchedInvoice.CustomerName))
		{
	<RadzenRow Gap="2.5em">
		<RadzenColumn Size="12">
			<div id="receipt-adjustment-types" class="rz-text-align-center pb-3">
				<RadzenLabel class="fs-5" Text="Select Adjustment Types to Submit" />
			</div>
			<div class="pb-3 rz-text-align-center">
				@* Types that don't fit the selected document are shown but disabled. *@
				<RadzenSelectBar Disabled="@IsSubmitting"
								 Multiple="true"
								 @bind-Value="@selectedAdjustmentTypes"
								 TValue="IEnumerable<string>"
								 Change="OnAdjustmentTypeSelectionChanged">
					<Items>
						@foreach (var option in ReceiptAdjustmentTypes)
						{
							<RadzenSelectBarItem Text="@option.Name" Value="@option.Name" Disabled="@(!IsAdjustmentTypeAllowed(option.Name))" />
						}
					</Items>
				</RadzenSelectBar>
			</div>
			@if (UnavailableTypeHints.Any())
			{
				<div class="pb-3 rz-text-align-center text-sm text-secondary">
					@foreach (var hint in UnavailableTypeHints)
					{
						<div>@hint</div>
					}
				</div>
			}
		</RadzenColumn>
		<RadzenColumn Size="12" SizeMD="@(selectedAdjustmentTypes.Any() ? 5 : 12)">
			<RadzenRow>
				<RadzenColumn Size="@(selectedAdjustmentTypes.Any() ? 12 : 6)">
								@if (isReceiptSearch)
								{
									<ReceiptSummary ReceiptDetails="SearchedInvoice" />
								}
								else
								{
									<InvoiceSummary InvoiceDetails="SearchedInvoice" />
								}
				</RadzenColumn>
				<RadzenColumn Size="@(selectedAdjustmentTypes.Any() ? 12 : 6)">
					<CardStandard HeaderText="Calculations">
						<BodyTtemplate>
							<RadzenStack Orientation="Orientation.Vertical" Gap="1.3em">
								<div>
									<div class="mb-2">
										<RadzenLabel Text="Total Adjustment Amount:" />
									</div>
									<div class="input-group ps-3">
										<input class="form-control form-control-sm fs-6 px-3 py-2" type="text" disabled value="@TotalAdjustmentAmount.ToPhp()">
									</div>
								</div>
								@if (_applyReceiptState.IsEnabled)
								{
									<div>
										<div class="mb-2">
											<RadzenLabel Text="Total Applied Amount:" />
										</div>
										<div class="input-group ps-3">
											<input class="form-control form-control-sm fs-6 px-3 py-2" type="text" disabled value="@TotalAppliedAmount.ToPhp()">
										</div>
									</div>
								}
								<div>
									<div class="mb-2">
										<RadzenLabel Text="Projected Remaining Balance:" />
									</div>
									<div class="input-group ps-3">
										<input class="form-control form-control-sm fs-6 px-3 py-2" type="text" disabled value="@RemainingBalance.ToPhp()">
									</div>
								</div>
								<div>
									<p class="text-xs mb-1">
										Only relevant totals are shown based on selected workflow.
									</p>
								</div>
							</RadzenStack>
						</BodyTtemplate>
					</CardStandard>
				</RadzenColumn>
			</RadzenRow>
		</RadzenColumn>

		@if (selectedAdjustmentTypes.Any())
				{
		<RadzenColumn Size="12" SizeMD="7">
			<CreateReceiptAdjustment @ref="receiptAdjustment" IsDisabled="@IsSubmitting" InvoiceDetails="SearchedInvoice" SelectedAdjustmentTypes="selectedAdjustmentTypes" AdjustmentAmountChanged="HandleAdjustmentChange" ApplyReceiptStateChanged="HandleApplyReceiptStateChange" />
		</RadzenColumn>
				}

	</RadzenRow>

	<ReceiptAttachmentsDatatable @ref="receiptAttachments" SelectedAdjustmentTypes="selectedAdjustmentTypes" Notes="Notes" IsDownloadable=false />
	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
		<button class="btn btn-primary mt-2" @onclick="OnSubmit" disabled="@(IsSubmitting || isSubmitConfirmationOpen)">
			@if (IsSubmitting)
						{
			<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
			<span>Submitting...</span>
						}
						else
			{
				<span>Submit</span>
			}
		</button>
	</RadzenStack>
		}
</RadzenStack>

@code
{
	private IEnumerable<AdjustmentTypeSelectBarOption> ReceiptAdjustmentTypes;
	private IEnumerable<string> selectedAdjustmentTypes = ["Cash Discount"];
	private readonly Dictionary<string, ReceiptAdjustmentEntry> _adjustments = new();

	private double RemainingBalance = 0d;
	private double TotalAdjustmentAmount = 0d;
	private double TotalAppliedAmount = 0d;
	private bool isReady = false;
	private bool isSubmitConfirmationOpen = false;
	private bool _scrollToAdjustmentTypes;
	private bool isReceiptSearch;
	private ReceiptAttachmentsDatatable receiptAttachments;
	private CreateReceiptAdjustment? receiptAdjustment;
	private ApplyReceiptStateDto _applyReceiptState = new();
	private bool IsReceiptSource => !string.IsNullOrWhiteSpace(SearchedInvoice.ReceiptNumber);
	private double AvailableBalance =>
		SearchedInvoice.OriginalReceiptBalance
		?? SearchedInvoice.ReceiptBalance
		?? SearchedInvoice.OriginalInvoiceBalance
		?? SearchedInvoice.InvoiceBalance;

	protected override async Task OnInitializedAsync()
	{
		ReceiptAdjustmentTypes = (await AdjustmentService.GetReceiptTypes()).Select((t, i) => new AdjustmentTypeSelectBarOption(i, t));
		await base.OnInitializedAsync();
		isReady = true;
	}

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		if (Utils.Equals(QueryAction, Queries.Success.CREATE))
		{
			// A successful navigation starts a fresh request workflow.
			IsSubmitting = false;
			isSubmitConfirmationOpen = false;
			Reset();
			Notes?.Clear();
			SearchedInvoice = new();
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_scrollToAdjustmentTypes)
			return;

		_scrollToAdjustmentTypes = false;
		await JS.InvokeVoidAsync("scrollToElement", "receipt-adjustment-types");
	}

	protected async Task OnInvoiceSelected(InvoiceDetailsDto invoiceDetails)
	{
		// Selecting an invoice starts a new editable request attempt.
		IsSubmitting = false;
		isSubmitConfirmationOpen = false;

		// Receipt searches may not return an InvoiceNumber. Compare only populated
		// stable identifiers so the first receipt result is not treated as already selected.
		var isSameSelection =
			(!string.IsNullOrWhiteSpace(invoiceDetails.InvoiceNumber) && invoiceDetails.InvoiceNumber == SearchedInvoice.InvoiceNumber) ||
			(!string.IsNullOrWhiteSpace(invoiceDetails.ReceiptNumber) && invoiceDetails.ReceiptNumber == SearchedInvoice.ReceiptNumber) ||
			(!string.IsNullOrWhiteSpace(invoiceDetails.Id) && invoiceDetails.Id == SearchedInvoice.Id);

		if (isSameSelection)
			return;

		SearchedInvoice = invoiceDetails;
		RemainingBalance = invoiceDetails.ReceiptBalance ?? invoiceDetails.InvoiceBalance;
		_applyReceiptState = new ApplyReceiptStateDto();

		_scrollToAdjustmentTypes = true;
		Reset();
	}

	private void SetReceiptSearch(bool value) => isReceiptSearch = value;

	private void HandleSearchGroupChanged(string group)
	{
		isReceiptSearch = string.Equals(group, "Receipt", StringComparison.OrdinalIgnoreCase);
		SearchedInvoice = new();
		_applyReceiptState = new ApplyReceiptStateDto();
		Reset();
	}

	private void HandleAdjustmentChange(AdjustmentEntry data)
	{
		_adjustments[data.Name] = new ReceiptAdjustmentEntry()
		{
			Amount = data.Amount,
			Remarks = data.Remarks
		};

		Calculate();
	}

	private void HandleApplyReceiptStateChange(ApplyReceiptStateDto state)
	{
		_applyReceiptState = state ?? new ApplyReceiptStateDto();
		Calculate();
	}

	private async Task OnAdjustmentTypeSelectionChanged()
	{
		// Defensive: never keep a type that is not allowed for the selected document.
		selectedAdjustmentTypes = selectedAdjustmentTypes.Where(IsAdjustmentTypeAllowed).ToList();

		var allTypes = ReceiptAdjustmentTypes.Select(t => t.Name);
		var notExisting = allTypes
			.Where(k => !selectedAdjustmentTypes.Contains(k))
			.ToList();

		var notesToRemove = Notes
			.Where(n => !selectedAdjustmentTypes.Contains(n.AdjustmentType))
			.ToList();

		foreach (var key in notExisting)
			_adjustments.Remove(key);

		foreach (var note in notesToRemove)
			await receiptAttachments.OnRemoveNote(note);

		Calculate();
	}


	private void Calculate()
	{
		TotalAdjustmentAmount = _adjustments.Values.Sum(a => a.Amount);
		TotalAppliedAmount = _applyReceiptState.IsEnabled
			? _applyReceiptState.SelectedApplications.Sum(a => a.AppliedAmount)
			: 0d;
		// Reflect both selected invoice applications and the adjustment amounts
		// currently entered by the user.
		RemainingBalance = Math.Round(AvailableBalance - TotalAppliedAmount - TotalAdjustmentAmount, 2);
		StateHasChanged();
	}

	private void Reset()
	{
		_adjustments.Clear();
		selectedAdjustmentTypes = [];
		TotalAdjustmentAmount = 0;
		TotalAppliedAmount = 0;
		Calculate();
	}

	protected override async Task OnSubmit()
	{
		if (IsSubmitting || isSubmitConfirmationOpen)
			return;

		if (IsReceiptSource && HasSelectedAdjustmentType("Cash Discount"))
		{
			await DialogService.Alert(
				"Cash Discount can only be applied to invoices. Please select an invoice.",
				"Invalid Transaction Type");
			return;
		}

		if (!IsReceiptSource && HasSelectedAdjustmentType("Bank Charges"))
		{
			await DialogService.Alert(
				"Bank Charges can only be applied to receipts. Please select a receipt.",
				"Invalid Transaction Type");
			return;
		}

		try
		{
			if (receiptAdjustment is not null)
				_applyReceiptState = receiptAdjustment.GetApplyReceiptState();

			await base.OnSubmit();

			isSubmitConfirmationOpen = true;
			StateHasChanged();
			bool isConfirmed = await DialogService.Confirm("Would you like to submit the following \"Receipt Adjustment(s)\"?", "Create Receipt Adjustment(s)") ?? false;

			if (!isConfirmed) return;

			isSubmitConfirmationOpen = false;
			IsSubmitting = true;
			StateHasChanged();

			IList<BaseReceiptAdjustmentCreateDto> requests = new List<BaseReceiptAdjustmentCreateDto>();

			Guards.ThrowInvalidOperationIf(
				AvailableBalance <= 0,
				"Cannot apply adjustment(s) because the current receipt is non-adjustable because its balance is less than or equal to 0.");

			if (_applyReceiptState.IsEnabled)
			{
				Guards.ThrowInvalidOperationIf(
					!_applyReceiptState.SelectedApplications.Any(),
					"Enable Apply Receipt requires at least one selected invoice with a positive applied amount.");

				Guards.ThrowInvalidOperationIf(
					TotalAppliedAmount > AvailableBalance,
					"Total applied amount cannot be greater than the available receipt balance.");
			}

			Guards.ThrowInvalidOperationIf(
				RemainingBalance < 0,
				"Cannot apply adjustment(s) because the remaining receipt balance is less than 0.");

			// Apply Receipt is submitted with exactly one request (Write-Off: Small Amount first,
			// otherwise Bank Charges) so the invoices are applied in Fusion only once.
			string? applyReceiptOwner = IsReceiptSource && _applyReceiptState.IsEnabled
				? CreateReceiptAdjustment.ApplyReceiptOwnerFor(selectedAdjustmentTypes)
				: null;

			foreach (var adj in _adjustments)
			{
				Guards.ThrowInvalidOperationIf(
					string.IsNullOrEmpty(adj.Value.Remarks),
					$"Cannot apply adjustment(s) because there is no remarks on {adj.Key} adjustment field.");

				Guards.ThrowInvalidOperationIf(
					adj.Value.Amount <= 0,
					"Cannot apply adjustment(s) because the adjustment amount is less than or equal to 0.");

				requests.Add(new BaseReceiptAdjustmentCreateDto(
					adj.Key,
					SearchedInvoice,
					adj.Value,
					IsReceiptSource ? "Receipt" : "Invoice")
				{
					ApplyReceiptEnabled = string.Equals(adj.Key, applyReceiptOwner, StringComparison.OrdinalIgnoreCase),
					ReceiptApplications = string.Equals(adj.Key, applyReceiptOwner, StringComparison.OrdinalIgnoreCase)
						? _applyReceiptState.SelectedApplications
						: []
				});
			}

			await submitOverlay.RunAsync(
				FusionPostingOverlay.SubmittingTitle,
				DescribeSubmission(requests),
				FusionPostingOverlay.SubmittingNote,
				() => RequestService.Create(requests, Notes));

			// The page is reused for the next request (no full reload), so clear the
			// attachments now. Otherwise this request's files are uploaded again with
			// the next one and can't be removed (they already have a request ID).
			if (receiptAttachments is not null)
				await receiptAttachments.ClearNotes();
			else
				Notes?.Clear();

			var uri = NavManager.GetUriWithQueryParameter("q", Queries.Success.CREATE);
			NavManager.NavigateTo(uri);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
			IsSubmitting = false;
		}
		finally
		{
			IsSubmitting = false;
			isSubmitConfirmationOpen = false;
			StateHasChanged();
		}
	}

	// Which document each receipt adjustment type can be raised against.
	// Kept in sync with the server-side check in the SSMS API (BaseReceiptAdjustmentRepository).
	private bool IsAdjustmentTypeAllowed(string adjustmentType) => adjustmentType switch
	{
		_ when string.Equals(adjustmentType, "Cash Discount", StringComparison.OrdinalIgnoreCase) => !IsReceiptSource,
		_ when string.Equals(adjustmentType, "Bank Charges", StringComparison.OrdinalIgnoreCase) => IsReceiptSource,
		_ => true
	};

	private IEnumerable<string> UnavailableTypeHints => (ReceiptAdjustmentTypes ?? [])
		.Select(option => option.Name)
		.Where(name => !IsAdjustmentTypeAllowed(name))
		.Select(name => IsReceiptSource
			? $"{name} is available for invoices only."
			: $"{name} is available for receipts only.");

	private FusionPostingOverlay submitOverlay = default!;

	private IEnumerable<string?> DescribeSubmission(IEnumerable<BaseReceiptAdjustmentCreateDto> requests)
	{
		foreach (var request in requests)
			yield return $"{request.AdjustmentType} of {FusionPostingOverlay.FormatSummaryAmount(request.AdjustmentAmount)} on {request.InvoiceNumber}";

		var applications = requests.SelectMany(r => r.ReceiptApplications ?? []).ToList();
		if (applications.Count > 0)
			yield return $"Apply receipt to {applications.Count} {(applications.Count == 1 ? "invoice" : "invoices")} ({FusionPostingOverlay.FormatSummaryAmount(applications.Sum(a => a.AppliedAmount))})";

		yield return FusionPostingOverlay.DescribeAttachments(Notes);
	}

	private bool HasSelectedAdjustmentType(string adjustmentType) =>
		selectedAdjustmentTypes.Any(type => string.Equals(type, adjustmentType, StringComparison.OrdinalIgnoreCase));
}
