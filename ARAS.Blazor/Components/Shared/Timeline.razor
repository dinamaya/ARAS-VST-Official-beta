@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces

@inject ITransactionService TransactionService
<RadzenStack>
	<div class="card w-100">
		<div class="card-header pb-0">
			<h4>Request Timeline</h4>
		</div>
		<div class="card-body p-3">
			<div class="timeline timeline-one-side" data-timeline-axis-style="dotted">
				@if (Transactions != null)
				{
					@foreach (var transaction in Transactions)
					{
						<TransactionHistoryRow TransactionHistory="transaction"/>
					}
				}
			</div>
		</div>
	</div>
</RadzenStack>

@code {
	[Parameter] public long RequestId { get; set; }
	[Parameter] public IEnumerable<TransactionHistoryDto>? Transactions { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		Transactions ??= await TransactionService.GetHistoryByRequestId(RequestId);
		StateHasChanged();
	}
}