@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Components.UI
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces

@inherits ComponentBase
@inject DialogService DialogService
@typeparam TRow where TRow : AdjustmentRow

<RadzenStack Orientation="Orientation.Vertical" Style="height: 100%;" Gap="1.6em">
	<RadzenColumn Size="12">
		<h4 class="mb-3">Invoice Number</h4>
		<div class="border-dashed border-1 border-secondary border-radius-md p-3">
			<div class="d-flex align-items-center">
				<div class="form-group w-100">
					<div class="input-group bg-gray-200">
						<input class="form-control form-control-sm fs-6 letter-spacing-2 px-3 py-2" @bind-value="@InvoiceDetails.InvoiceNumber" type="text" disabled>
					</div>
				</div>
			</div>
			<p class="text-xs mb-1">You cannot generate <b>Invoice Number</b></p>
		</div>
	</RadzenColumn>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenRow>
			<RadzenLabel Style="width: 100%;" Text="Reason Codes" />
		</RadzenRow>
		<RadzenRow>
			<RadzenDropDown @bind-Value=@reasonCode Data=@ReasonCodes Style="width: 100%;" Name="Reason Codes" />
		</RadzenRow>
		<ComponentValidator ValidationName="ReasonCode" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Adjustment Amount" Variant="Variant.Outlined">
			<RadzenNumeric @bind-Value="@adjustmentAmount" Max="(decimal)InvoiceDetails.InvoiceAmount" />
		</RadzenFormField>
		<ComponentValidator ValidationName="AdjustmentAmount" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Remarks" Variant="@Variant.Outlined" Max>
			<RadzenTextArea @bind-Value="@remarks" Rows="4" />
		</RadzenFormField>
		<ComponentValidator ValidationName="Remarks" />
	</RadzenStack>
		

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
		<button @onclick="@Delete" class="btn btn-danger">
			Delete
		</button>
		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
			<button @onclick="@((args) => DialogService.Close(true))" class="btn btn-outline-dark">
				Close
			</button>
			<button @onclick="Edit" class="btn btn-primary">
				Edit
			</button>
		</RadzenStack>
	</RadzenStack>

</RadzenStack>

@code {
	[Parameter] public TRow InvoiceDetails { get; set; }
	[Parameter] public IList<TRow> Rows { get; set; }
	[Parameter] public IEnumerable<string> ReasonCodes { get; set; }
	[Parameter] public RadzenDataGrid<TRow> Grid { get; set; }
	[Parameter] public Func<double, string, string, TRow, Task>? OnValidate { get; set; }

	private IEnumerable<string> invoices = new List<string>();
	private string adjustmentAmount = string.Empty;
	private string remarks = string.Empty;
	private string reasonCode = string.Empty;

	protected override async Task OnInitializedAsync() => await base.OnInitializedAsync();

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		remarks = InvoiceDetails.Remarks;
		adjustmentAmount = InvoiceDetails.AdjustmentAmount.ToString();
		reasonCode = InvoiceDetails.ReasonCode ?? ReasonCodes.First();
	}

	private async Task Edit()
	{
		try
		{
			double parsedAmount;
			// Multiple Invoice Number Validation
			Guards.ThrowInvalidOperationIf(string.IsNullOrEmpty(adjustmentAmount), "The provided adjustment amount is empty. Please provide a valid and not greater than the current Invoice Amount");
			bool isAdjustmentAmountValid = double.TryParse(adjustmentAmount, out parsedAmount);
			Guards.ThrowInvalidOperationIf(!isAdjustmentAmountValid, $"The provided Invoice Amount contains unwanted characters. Please check the Invoice Amount or contact the administrator for help.");

			OnValidate?.Invoke(parsedAmount, remarks, reasonCode, InvoiceDetails);

			var row = Rows.FirstOrDefault(r => r.Id == InvoiceDetails.Id) ?? throw new Exception("Data is not found in the adjustment table");

			row.SetValues((float)parsedAmount, remarks, reasonCode, "");
			
			await Grid.Reload();
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(Exceptions.GetMessage(ex), "Add Adjustment Failed");
		}
	}

	private async Task Delete()
	{
		try
		{
			Rows.Remove(InvoiceDetails);
			await Grid.Reload();
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(Exceptions.GetMessage(ex), "Add Adjustment Failed");
		}
	}
}
