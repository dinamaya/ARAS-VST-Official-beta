@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Components.Shared.Summaries

<RadzenStack Gap="1.5rem">
    <RequestAuditSummary Data="RequestAudit" />

    <RadzenRow Gap="1.5rem">
        <RadzenColumn Size="6">
            <div class="text-center">
                <h3 class="pb-0 mb-0">AP GROUP</h3>
            </div>
            <div class="py-4 px-3 w-100 card">
                <RadzenDataGrid Data="@APAdjustments" TItem="APAROffsetAPRowDto"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                ShowPagingSummary="false">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice Number">
                            <FooterTemplate>
                                <b>Total Amount:</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Invoice Amount">
                            <Template Context="data">
                                @data.InvoiceAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </Template>
                            <FooterTemplate>
                                <b>@APAdjustments.Sum(a => a.InvoiceAmount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <div class="text-center">
                <h3 class="pb-0 mb-0">AR GROUP</h3>
            </div>
            <div class="py-4 px-3 w-100 card">
                <RadzenDataGrid Data="@ARAdjustments" TItem="APAROffsetARRowDto"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                ShowPagingSummary="false">
                    <Columns>
                        <RadzenDataGridColumn Title="Description">
                            <Template Context="data">
                                @if (data.RowType == ARRowType.Invoice)
                                {
                                    @data.InvoiceNumber
                                }
                                else
                                {
                                    @data.AdjustmentReason
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Amount" Title="Amount">
                            <Template Context="data">
                                @data.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </Template>
                            <FooterTemplate>
                                <b>Total:</b> @ARAdjustments.Sum(a => a.Amount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </RadzenColumn>
    </RadzenRow>

    <NotesSummary Notes="Notes" />
</RadzenStack>

@code {
    [Parameter] public IEnumerable<APAROffsetAPRowDto> APAdjustments { get; set; }
    [Parameter] public IEnumerable<APAROffsetARRowDto> ARAdjustments { get; set; }
    [Parameter] public RequestAuditDto RequestAudit { get; set; }
    [Parameter] public IEnumerable<NoteRowDto> Notes { get; set; }
}
