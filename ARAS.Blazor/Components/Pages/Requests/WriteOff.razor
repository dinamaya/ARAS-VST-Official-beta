@page "/requests/write-off"
@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Requestor")]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject ITestService TestService
@inject IAuthService AuthService
@inject ISearchOptionService SearchOptionService
@inject IBankChargeService BankChargeService

<h2>Write Off Adjustment</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />

	<RadzenRow>
		<div>
			<h3 class="pb-0 mb-0">Write Off</h3>
		</div>
		<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid class="border-0"
							@ref="adjustmentGrid"
							AllowFiltering="true"
							AllowColumnResize="true"
							AllowAlternatingRows="false"
							FilterMode="FilterMode.Advanced"
							AllowSorting="true"
							PageSize="20"
							AllowPaging="true"
							PagerHorizontalAlign="HorizontalAlign.Left"
							ShowPagingSummary="true"
							Data="@Adjustments"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
					<RadzenDataGridColumn Frozen="true" Title="Edit" Sortable="false" Filterable="false" Width="80px" TextAlign="TextAlign.Center">
						<Template Context="data">
							<RadzenButton Icon="Edit" Variant="Variant.Outlined" Click="@(args => OpenEdit(data))" />
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.AdjustmentAmount)" Width="120px" Title="Adjustment Amount">
						<Template Context="data">
							@data.AdjustmentAmount.ToPhp()
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.InvoiceAmount)" Title="Invoice Amount">
						<Template Context="data">
							@data.InvoiceAmount.ToPhp()
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.InvoiceDate)" Title="Invoice Date" />
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.InvoiceNumber)" Title="Invoice Number" />
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.CustomerName)" Title="Customer Name" />
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.CustomerNumber)" Title="Customer Number" />
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.ReasonCode)" Title="Reason Code" />
					<RadzenDataGridColumn Property="@nameof(BankChargeRowDto.Remarks)" Title="Remarks" />
				</Columns>
			</RadzenDataGrid>
		</div>

	</RadzenRow>

	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>



@code {
	[Parameter] public IList<BankChargeRowDto> Adjustments { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();
	private IEnumerable<string> reasonCodes { get; set; }

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<BankChargeRowDto> adjustmentGrid;
	private RequestAuditDto requestAudit;

	private bool isOnSearch;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		Adjustments = new List<BankChargeRowDto>();
		searchedInvoiceNumber = new InvoiceDetailsDto();
		requestAudit = new RequestAuditDto();

		reasonCodes = await SearchOptionService.GetReasonCodes();
		await TestService.GenerateBankChargeRows(Adjustments, reasonCodes);
		await adjustmentGrid.Reload();

		requestAudit.Requestor = await AuthService.GetLastFirstName();
	}

	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		try
		{
			await DialogService.OpenAsync<AddBankChargeModal>(
				"Add Write Off Adjustment",
				new Dictionary<string, object>()
				{
					{ nameof(AddBankChargeModal.ReasonCodes), reasonCodes },
					{ nameof(AddBankChargeModal.Rows), Adjustments },
					{ nameof(AddBankChargeModal.Grid), adjustmentGrid },
					{ nameof(AddBankChargeModal.InvoiceDetails), invoiceDetails }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Add Adjustment Failed");
		}
	}

	public async Task OpenEdit(BankChargeRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditBankChargeModal>(
				"Edit Write Off Adjustment",
				new Dictionary<string, object>()
				{
					{ nameof(EditBankChargeModal.ReasonCodes), reasonCodes },
					{ nameof(EditBankChargeModal.Rows), Adjustments },
					{ nameof(EditBankChargeModal.Grid), adjustmentGrid },
					{ nameof(EditBankChargeModal.Data), data }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(!Adjustments.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			await DialogService.OpenAsync<RequestAdjustmentsModalSummary>(
				"Submit Bank Charge Adjustment",
				new Dictionary<string, object>()
				{
					{ "Rows", Adjustments },
					{ "RequestAudit", requestAudit },
					{ "OnSubmit", SubmitRequest },
					{ "SucccessSubmissionRoute", "/requests/bank-charge" },
				},
				new DialogOptions() { Width = "1500px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		await BankChargeService.Create(Adjustments, Notes);
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

}
