@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.UI
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces

@inherits ComponentBase
@inject DialogService DialogService
@inject ICashDiscountService CashDiscountService

<RadzenStack Orientation="Orientation.Vertical" Style="height: 100%;" Gap="1.6em">
	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Invoice Number to adjust" Variant="@Variant.Outlined">
			<RadzenTextBox @bind-Value="@Data.InvoiceNumber" ReadOnly />
		</RadzenFormField>
		<ComponentValidator ValidationName="@nameof(CashDiscountCreateValidationDto.InvoiceNumber)" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenRow>
			<RadzenLabel Style="width: 100%;" Text="Reason Codes" />
		</RadzenRow>
		<RadzenRow>
			<RadzenDropDown @bind-Value=@reasonCode Data=@ReasonCodes Style="width: 100%;" Name="Reason Codes" />
		</RadzenRow>
		<ComponentValidator ValidationName="Reason Code" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Adjustment Amount" Variant="Variant.Outlined">
			<RadzenNumeric @bind-Value="@Data.AdjustmentAmount" Max="(decimal)Data.InvoiceAmount" />
		</RadzenFormField>
		<ComponentValidator ValidationName="@nameof(CashDiscountCreateValidationDto.DiscountPercentage)" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Remarks" Variant="@Variant.Outlined" Max>
			<RadzenTextArea @bind-Value="@Data.Remarks" Rows="4" />
		</RadzenFormField>
		<ComponentValidator ValidationName="@nameof(CashDiscountCreateValidationDto.Remarks)" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
		<button @onclick="@OnDelete" class="btn btn-dark">
			Delete
		</button>
		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
			<button @onclick="@((args) => DialogService.Close(true))" class="btn btn-danger">
				Close
			</button>
			<button @onclick="OnEdit" class="btn btn-outline-primary">
				Edit
			</button>
		</RadzenStack>
	</RadzenStack>

</RadzenStack>

@code {
	[Parameter] public IEnumerable<string> ReasonCodes { get; set; }
	[Parameter] public IList<BankChargeRowDto> Rows { get; set; }
	[Parameter] public RadzenDataGrid<BankChargeRowDto> Grid { get; set; }
	[Parameter] public BankChargeRowDto Data { get; set; }

	private IEnumerable<string> invoices = new List<string>();
	private string reasonCode = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		reasonCode = Data.ReasonCode;
	}

	private async Task OnEdit()
	{
		try
		{
			var row = Rows.FirstOrDefault(r => r.Id == Data.Id) ?? throw new Exception("Data is not found in the bank charge adjustment table");
			row.SetValues((float) Data.AdjustmentAmount, Data.Remarks, reasonCode);

			await Grid.Reload();
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(Exceptions.GetMessage(ex), "Failed to Edit Bank Charge Details");
		}
	}

	private async Task OnDelete()
	{
		Rows.Remove(Data);
		await Grid.Reload();
		DialogService.Close(true);
	}
}
