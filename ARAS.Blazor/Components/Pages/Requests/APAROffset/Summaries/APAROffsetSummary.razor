@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Components.Shared.Summaries

@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inherits ComponentBase

<RadzenStack Gap="0">
    <RadzenImage Path="@Assets["/img/icons/VST-ECS.png"]" Style="width: 170px" />

    <div class="px-3 py-2 mt-2 mb-2">
        <RadzenRow Gap="1.5rem">
            <RadzenColumn Size="6">
                <div style="font-size: 0.9rem;">
                    <b>NAME:</b>
                    <span class="pl-1">@nameof(APAROffsetAPRowDto.CustomerName)</span>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <div style="font-size: 0.9rem;">
                    <b>REF. NO:</b>
                    @* <span class="pl-1">@ReferenceNumber</span> *@
                </div>
            </RadzenColumn>
        </RadzenRow>
    </div>
    
    <RadzenRow Gap="1.5rem">
        <RadzenColumn Size="6">
            <div class="text-center">
                <h3 class="pb-0 mb-0">AP GROUP</h3>
            </div>
            <div class="py-4 px-3 w-100 card">
                <RadzenDataGrid Data="@APAdjustments" TItem="APAROffsetAPRowDto"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                ShowPagingSummary="false">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice Number">
                            <FooterTemplate>
                                <b>Total Amount:</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Invoice Amount">
                            <Template Context="data">
                                @data.InvoiceAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </Template>
                            <FooterTemplate>
                                <b>@APAdjustments.Sum(a => a.InvoiceAmount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <div class="text-center">
                <h3 class="pb-0 mb-0">AR GROUP</h3>
            </div>
            <div class="py-4 px-3 w-100 card">
                <RadzenDataGrid Data="@ARAdjustments" TItem="APAROffsetARRowDto"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                ShowPagingSummary="false">
                    <Columns>
                        <RadzenDataGridColumn Title="Description">
                            <Template Context="data">
                                @if (data.RowType == ARRowType.Invoice)
                                {
                                    @data.InvoiceNumber
                                }
                                else
                                {
                                    @data.AdjustmentReason
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Amount" Title="Amount">
                            <Template Context="data">
                                @data.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </Template>
                            <FooterTemplate>
                                <b>Total:</b> @ARAdjustments.Sum(a => a.Amount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </RadzenColumn>
    </RadzenRow>

    <RadzenTable class="w-100 pb-2" GridLines="DataGridGridLines.Both" AllowAlternatingRows="false">
        <RadzenTableBody>
            <RadzenTableRow>
                <RadzenTableCell Style="width: 220px; text-align: center">
                    <b>Requested By:</b>
                </RadzenTableCell>
                <RadzenTableCell Style="width: 170px; text-align: center">
                    <b>Approved By:</b>
                </RadzenTableCell>
                <RadzenTableCell Style="width: 220px; text-align: center">
                    <b>Validated By:</b>
                </RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell Style="width: 220px; text-align: center">
                    @RequestAudit?.Requestor
                </RadzenTableCell>
                <RadzenTableCell Style="width: 170px; text-align: center">
                    @RequestAudit?.Approver
                </RadzenTableCell>
                <RadzenTableCell Style="width: 220p; text-align: center">
                    @RequestAudit?.Validator
                </RadzenTableCell>
            </RadzenTableRow>
        </RadzenTableBody>
    </RadzenTable>
    
</RadzenStack>

@code {
    [Parameter] public IEnumerable<APAROffsetAPRowDto> APAdjustments { get; set; }
    [Parameter] public IEnumerable<APAROffsetARRowDto> ARAdjustments { get; set; }
    [Parameter] public RequestAuditDto RequestAudit { get; set; }
    [Parameter] public IEnumerable<NoteRowDto> Notes { get; set; }
}
