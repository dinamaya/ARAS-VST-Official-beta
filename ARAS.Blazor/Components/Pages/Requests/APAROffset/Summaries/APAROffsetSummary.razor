@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Components.Shared.Summaries

@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inherits ComponentBase

<RadzenStack Gap="0">
    <RadzenImage Path="@Assets["/img/icons/VST-ECS.png"]" Style="width: 170px" />

    <div class="px-3 py-2 mt-2 mb-2">
        <RadzenRow Gap="1.5rem">
            <RadzenColumn Size="6">
                <div style="font-size: 1.2rem;">
                    <b>NAME:</b>
                    <span class="pl-1">@APAdjustments?.FirstOrDefault()?.CustomerName</span>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="6"> 
                <div style="font-size: 1.2rem;">
                    <b>REF. NO:</b>
                    <span class="pl-1">@RequestAudit?.ReferenceNumber</span>
                </div>
            </RadzenColumn>
        </RadzenRow>
    </div>
    
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="6">
            <div class="py-2 text-center border border-1">
                <h3 class="mb-0">AP GROUP</h3>
            </div>
            <div class="py-4 w-100">
                <RadzenDataGrid Data="@apDisplay" TItem="APAROffsetAPRowDto"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                ShowPagingSummary="false">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice Number">
                            <FooterTemplate>
                                <b>TOTAL</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Invoice Amount">
                            <Template Context="data">
                                @if (string.IsNullOrWhiteSpace(data?.InvoiceNumber))
                                {
                                    <span style="visibility:hidden">
                                        @data.InvoiceAmount.ToPhp()
                                    </span>
                                }
                                else
                                {
                                    @data.InvoiceAmount.ToPhp()
                                }
                            </Template>
                            <FooterTemplate>
                                <b>@APAdjustments?.Sum(a => a.InvoiceAmount).ToPhp()</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>

                    </Columns>
                </RadzenDataGrid>
            </div>
        </RadzenColumn>
        <RadzenColumn Size="6" >
            <div class="py-2 text-center border border-1">
                <h3 class="mb-0">AR GROUP</h3>
            </div>
            <div class="py-4 w-100">
                <RadzenDataGrid Data="@arDisplay" TItem="APAROffsetARRowDto"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="false"
                                ShowPagingSummary="false">
                    <Columns>
                        <RadzenDataGridColumn Title="Description">
                            <Template Context="data">
                                @if (data.RowType == ARRowType.Invoice)
                                {
                                    @data.InvoiceNumber
                                }
                                else
                                {
                                    @data.AdjustmentReason
                                }
                            </Template>
                            <FooterTemplate>
                                <b>TOTAL</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="Amount" Title="Amount">
                            <Template Context="data">
                                @if (string.IsNullOrWhiteSpace(data?.InvoiceNumber) && string.IsNullOrWhiteSpace(data?.AdjustmentReason))
                                {
                                    <span style="visibility:hidden">
                                        @data.Amount.ToPhp()
                                    </span>
                                }
                                else
                                {
                                    @data.Amount.ToPhp()
                                }
                            </Template>

                            <FooterTemplate>
                                <b>@ARAdjustments?.Sum(a => a.Amount).ToPhp()</b>
                            </FooterTemplate>
                        </RadzenDataGridColumn>

                    </Columns>
                </RadzenDataGrid>
            </div>
        </RadzenColumn>
    </RadzenRow>

    <RadzenTable class="w-100 pb-2" GridLines="DataGridGridLines.Both" AllowAlternatingRows="false">
        <RadzenTableBody>
            <RadzenTableRow>
                <RadzenTableCell Style="width: 220px; text-align: center">
                    <b>Requested By:</b>
                </RadzenTableCell>
                <RadzenTableCell Style="width: 170px; text-align: center">
                    <b>Approved By:</b>
                </RadzenTableCell>
                <RadzenTableCell Style="width: 220px; text-align: center">
                    <b>Validated By:</b>
                </RadzenTableCell>
            </RadzenTableRow>
            <RadzenTableRow>
                <RadzenTableCell Style="width: 220px; text-align: center">
                    @RequestAudit?.Requestor
                </RadzenTableCell>
                <RadzenTableCell Style="width: 170px; text-align: center">
                    @RequestAudit?.Approver
                </RadzenTableCell>
                <RadzenTableCell Style="width: 220p; text-align: center">
                    @RequestAudit?.Validator
                </RadzenTableCell>
            </RadzenTableRow>
        </RadzenTableBody>
    </RadzenTable>
    
</RadzenStack>

@code {
    [Parameter] public IEnumerable<APAROffsetAPRowDto> APAdjustments { get; set; }
    [Parameter] public IEnumerable<APAROffsetARRowDto> ARAdjustments { get; set; }
    [Parameter] public RequestAuditDto RequestAudit { get; set; }
    [Parameter] public string ReferenceNumber { get; set; }

    // Display lists padded so both grids always have the same number of rows
    private List<APAROffsetAPRowDto> apDisplay = new();
    private List<APAROffsetARRowDto> arDisplay = new();

    protected override Task OnParametersSetAsync()
    {
        PadAndPrepareDisplays();
        return base.OnParametersSetAsync();
    }

    private void PadAndPrepareDisplays()
    {
        var ap = APAdjustments?.ToList() ?? new List<APAROffsetAPRowDto>();
        var ar = ARAdjustments?.ToList() ?? new List<APAROffsetARRowDto>();

        var max = Math.Max(ap.Count, ar.Count);

        // Ensure padding rows have zero amounts (APAROffsetAPRowDto has a non-zero default in its class,
        // so explicitly set InvoiceAmount = 0)
        while (ap.Count < max)
        {
            ap.Add(new APAROffsetAPRowDto
            {
                InvoiceNumber = string.Empty,
                InvoiceAmount = 0.0,
                CustomerName = string.Empty,
                CustomerNumber = string.Empty
            });
        }

        while (ar.Count < max)
        {
            ar.Add(new APAROffsetARRowDto
            {
                InvoiceNumber = string.Empty,
                AdjustmentReason = string.Empty,
                Amount = 0.0,
                RowType = ARRowType.Invoice
            });
        }

        apDisplay = ap;
        arDisplay = ar;
    }
}
