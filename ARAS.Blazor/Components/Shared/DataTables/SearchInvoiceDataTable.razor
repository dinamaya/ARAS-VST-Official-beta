@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.Skeletons
@using ARAS.Blazor.Models.DTOs
<RadzenRow class="w-100">
	<div class="card blur shadow-blur w-100">
		<div class="card-body overflow-auto overflow-x-hidden">
			<RadzenRow>
				<h3 class="mb-4">Search Result</h3>
			</RadzenRow>
			@if (IsLoading )
			{
				<div>
					<DatatableSkeleton RowCount="4" ColumnCount="5"/>
				</div>
			}
			else {
			<RadzenDataGrid @ref=dataGrid
				class="border-1"
				AllowFiltering="true"
				AllowColumnResize="true"
				AllowAlternatingRows="false"
				FilterMode="FilterMode.Advanced"
				AllowSorting="true"
				PageSize="5"
				AllowPaging="true"
				PagerHorizontalAlign="HorizontalAlign.Left"
				ShowPagingSummary="true"
				Data="@InvoiceRows"
				LogicalFilterOperator="LogicalFilterOperator.Or"
				SelectionMode="DataGridSelectionMode.Single">
				<Columns>
					<RadzenDataGridColumn Frozen="true" Title="Option" Sortable="false" Filterable="false" Width="160px" TextAlign="TextAlign.Center">
						<Template Context="data">
							<RadzenButton Icon="edit_document" Text="Select" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="@(args => OnSelect(data))" />
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Visible="false" Property="@nameof(InvoiceDetailsDto.Id)" Title="Id" />
					<RadzenDataGridColumn Property="@nameof(InvoiceDetailsDto.CustomerName)" Title="Customer Name" />
					<RadzenDataGridColumn Visible="false" Property="@nameof(InvoiceDetailsDto.CustomerNumber)" Title="Customer Number" />
						<RadzenDataGridColumn Property="@nameof(InvoiceDetailsDto.InvoiceNumber)" Title="Invoice Number" />
						<RadzenDataGridColumn Property="@nameof(InvoiceDetailsDto.InvoiceDate)" Title="Invoice Date">
							<Template Context="data">
								@data.InvoiceDate.ToString(Formats.Date.DISPLAY2)
							</Template>
						</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(InvoiceDetailsDto.InvoiceAmount)" Title="Invoice Amount" >
						<Template Context="data">
							@data.InvoiceAmount.ToPhp()
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(InvoiceDetailsDto.InvoiceBalance)" Title="Invoice Balance" >
						<Template Context="data">
							@data.InvoiceBalance.ToPhp()
						</Template>
					</RadzenDataGridColumn>

				</Columns>
			</RadzenDataGrid>
			}
		</div>
	</div>
</RadzenRow>

@code{
	[Parameter] public EventCallback<InvoiceDetailsDto> Select { get; set; }
	[Parameter] public IEnumerable<InvoiceDetailsDto> InvoiceRows { get; set; }
	[Parameter] public bool IsLoading { get; set; }
	private RadzenDataGrid<InvoiceDetailsDto> dataGrid;
	private InvoiceDetailsDto searchedInvoice;

	private async Task OnSelect(InvoiceDetailsDto invoice)
	{
		if (Select.HasDelegate)
			await Select.InvokeAsync(invoice);
    }
}