@using ARAS.Blazor.Components.Shared
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Models.DTOs

@inject IInvoiceService InvoiceService
@inject IConfigService ConfigService
@inject DialogService DialogService
@inherits ComponentBase

<MainSearchBar OnSearch="HandleSearch"
               TextFields="textFields"
               SearchGroups="@SearchGroups"
               PlaceSearchButtonBelowDate="@PlaceSearchButtonBelowDate"
               AlignSearchFields="@AlignSearchFields">
	<ResultTemplate Context="isLoading">
		@if (ResultHeader is not null)
		{
			@ResultHeader
		}
		<SearchInvoiceDataTable ButtonSelectIcon="add"
								ButtonSelectText="Add to List"
								IsLoading="isLoading"
								InvoiceRows="results"
								Select="OnSelectChanged" />
	</ResultTemplate>

	<OptionsTemplate>
		<RadzenSelectBar class="mt-2" @bind-Value="selectedSource" TValue="string">
			<Items>
				<RadzenSelectBarItem Text="AP" Value="@("AP")" />
				<RadzenSelectBarItem Text="AR" Value="@("AR")" />
			</Items>
		</RadzenSelectBar>
	</OptionsTemplate>
</MainSearchBar>

@code {
	[Parameter] public EventCallback<InvoiceDetailsDto> OnAPAdd { get; set; }
	[Parameter] public EventCallback<InvoiceDetailsDto> OnARAdd { get; set; }
	[Parameter] public RenderFragment? ResultHeader { get; set; }
	[Parameter] public bool PlaceSearchButtonBelowDate { get; set; }
	[Parameter] public bool AlignSearchFields { get; set; }

	private IEnumerable<InvoiceDetailsDto> results { get; set; } = [];
	private IEnumerable<string> textFields { get; set; } = [];
	private Dictionary<string, IEnumerable<string>> SearchGroups { get; set; } = [];

	private string selectedSource = "AP";

	protected override Task OnInitializedAsync()
	{
		textFields = ConfigService.GetRequstorSearchInvoiceCategories();
		var requestorSearchGroups = ConfigService.GetRequestorSearchGroups();

		SearchGroups = new Dictionary<string, IEnumerable<string>>
		{
			["Invoice"] = requestorSearchGroups["Invoice"]
		};

		return Task.CompletedTask;
	}

	private async Task HandleSearch(SearchRequestDto request)
	{
		var apiRequest = new SearchRequestDto
		{
			Category = request.Category == "Invoice Customer Name"
				? "Customer Name"
				: request.Category,
			Value = request.Value,
			StartDate = request.StartDate,
			EndDate = request.EndDate
		};

		results = selectedSource == "AR"
			? await InvoiceService.GetDetailsList(apiRequest)
			: await InvoiceService.GetAPDetailsList(apiRequest);
	}

	protected async Task OnSelectChanged(InvoiceDetailsDto invoiceDetails)
	{
		if (invoiceDetails.DataSource == "AR")
		{
			await OnARAdd.InvokeAsync(invoiceDetails);
		}
		else
		{
			await OnAPAdd.InvokeAsync(invoiceDetails);
		}
	}
}
