<RadzenPanelMenuItem Text="@MenuText" Icon="@MenuIcon" Style="border: none">

	<RadzenPanelMenuItem Text="Receipt" Style="border: none">
		<MenuItem Text="Cash Discount" Route="@GetPath("cash-discount")" />
		<MenuItem Text="Bank Charge" Route="@GetPath("bank-charge")" />
		<MenuItem Text="Small Amount" Route="@GetPath("small-amount")" />
	</RadzenPanelMenuItem>

	<RadzenPanelMenuItem Text="Invoice" Style="border: none">
		<MenuItem Text="AP-AR" Route="@GetPath("apar-offset")" />
		<MenuItem Text="AR Invoice" Route="@GetPath("ar-invoice-offsetting")" />
		<MenuItem Text="SR Auto Net" Route="@GetPath("sr-auto-net")" />
	</RadzenPanelMenuItem>
</RadzenPanelMenuItem>

@code{
	[Parameter] public string MenuText { get; set; }
	[Parameter] public string MenuIcon { get; set; }
	[Parameter] public string RootDirectory { get; set; }

	private string GetPath(string param) => $"/{RootDirectory}/{param}";
}