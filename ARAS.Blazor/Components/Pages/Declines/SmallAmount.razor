@page "/declines/small-amount/{RequestId:long}"
@using ARAS.Blazor.Models.DTOs
@inject DialogService DialogService
@inject ISmallAmountService IService
@inject ITestService TestService

<BaseAdjustmentRequestDecline
	TRow="@SmallAmountRowDto"
	TCreate="@AdjustmentCreateDto"
	RequestId="RequestId"
	Title="Small Amount"
	SubmissionRoute="small-amount"
	CreateStatusRepository="IService"
	AdjustmentReaderRepository="IService"
	OnOpenAdd="OpenAdd"
	OnOpenEdit="OpenEdit"
	/>

@code{
	[Parameter] public long RequestId { get; set; }

	public async Task OpenAdd(
		IList<SmallAmountRowDto> rows,
		IEnumerable<string> reasonCodes,
		RadzenDataGrid<SmallAmountRowDto> dataGrid,
		string adjustmentActivity,
		InvoiceDetailsDto invoiceDetails)
	{
		await ModalTemplates.Add.SmallAmount(
			DialogService,
			rows,
			reasonCodes,
			dataGrid,
			invoiceDetails,
			adjustmentActivity
		);
	}

	public async Task OpenEdit(
		IList<SmallAmountRowDto> rows,
		IEnumerable<string> reasonCodes,
		SmallAmountRowDto data,
		RadzenDataGrid<SmallAmountRowDto> dataGrid
	)
	{
		await ModalTemplates.Edit<SmallAmountRowDto>.Adjustment(
			DialogService,
			"Small Amount",
			data,
			rows,
			reasonCodes,
			dataGrid,
			null
		);
	}
}
