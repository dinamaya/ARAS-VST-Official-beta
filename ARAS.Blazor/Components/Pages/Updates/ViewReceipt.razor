@page "/approvals/receipt/{TypeCode}/{RequestId:long}"
@page "/submissions/receipt/{TypeCode}/{RequestId:long}"
@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Repositories.Interfaces
@using ARAS.Blazor.Components.Shared.Others
@using ARAS.Blazor.Components.Shared.Summaries
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IRequestService RequestService
@inject IQueryService QueryService
@inject IAuthService AuthService

<h2>@adjustmentName</h2>

<FusionPostingOverlay @ref="postingOverlay" RunningChanged="@(value => isPosting = value)" />

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	@if (isReady && invoice is not null && details is not null)
	{
		<RadzenRow>
			@if (Utils.Equals(QueryAction, Queries.Success.CREATE))
			{
				<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
					@adjustmentName Adjustment updated successfully
				</RadzenAlert>
			}
			@if (Utils.Equals(QueryAction, Queries.Success.APPROVED))
			{
				<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
					Request approved and sent to the next approver.
				</RadzenAlert>
			}
			@if (Utils.Equals(QueryAction, Queries.Success.POSTED))
			{
				<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
					Request approved and posted to Oracle Fusion.
				</RadzenAlert>
			}
			@if (isStatusChangeable)
			{
				<RadzenColumn Size="12">
					<RadzenStack JustifyContent="JustifyContent.Right" Orientation="Orientation.Horizontal">
						<RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Reject" class="btn-danger" Icon="cancel" Click="OnReject" Disabled="@isPosting" />
						<RadzenButton ButtonStyle="ButtonStyle.Warning" Text="Decline" class="btn-dark" Icon="thumb_down" Click="OnDecline" Disabled="@isPosting" />
						<RadzenButton ButtonStyle="ButtonStyle.Success" Text="Approve" class="btn-success" Icon="thumb_up" Click="OnApprove" Disabled="@isPosting" />
					</RadzenStack>
				</RadzenColumn>
			}

			<RadzenColumn Size="12" SizeLG="@(isRequestUpdatable ? 4 : 6)">
				@if (ShouldRenderReceiptSummary())
				{
					<ReceiptSummary ReceiptDetails="@invoice" />
				}
				else
				{
					<InvoiceSummary InvoiceDetails="@invoice" />
				}
			</RadzenColumn>

			@if (isRequestUpdatable)
			{
				<RadzenColumn Size="12" SizeLG="8">
					<CardStandard HeaderIcon="edit" HeaderText="Update Adjustment">
						<HeaderActions>
							<RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Submit" class="btn-primary" Icon="send" Click="OnSubmit" Disabled="@isPosting" />
						</HeaderActions>
						<BodyTtemplate>
							@if(TypeCode == "cdr")
							{
								<CreateCashDiscountAdjustment
									@ref="cashDiscountAdjustment"
									AdjustmentAmountChanged="HandleAdjustment"
									InitialRemarks="@details.Remarks"
									InitialDiscount="@details.AdjustmentAmount"
									InvoiceAmount="@invoice.InvoiceAmount"
									InvoiceBalance="@invoice.InvoiceBalance"
									RemarksRowCount="11" />
							}
							else
							{
								<BaseReceiptAdjustment
									@ref="baseReceiptAdjustment"
									AdjustmentName="@adjustmentName"
									IsAdjustable="true"
									InitialRemarks="@details.Remarks"
									InitialAdjustment="@details.AdjustmentAmount"
									AdjustmentAmountChanged="HandleAdjustment" />
								@if (CanEditApplyReceipt)
								{
									@* The requestor can correct the invoice applications along with the amount and remarks. *@
									<ApplyReceiptEditor @ref="applyReceiptEditor"
										ReceiptNumber="@details.Invoice.InvoiceNumber"
										ReceiptBalance="@ReceiptBalance"
										AdjustmentAmount="@data.AdjustmentAmount"
										InitialApplications="@details.ReceiptApplications"
										IsDisabled="@isPosting" />
								}
							}
						</BodyTtemplate>
					</CardStandard>
				</RadzenColumn>
			}
			else
			{
				<RadzenColumn Size="12" SizeLG="6">
					<CardStandard HeaderIcon="update" HeaderText="Update Adjustment">
						<BodyTtemplate>
							<RadzenColumn Size="12" class="mt-3 mt-lg-0">
								<h4 class="mb-3">Other Information</h4>
								<RadzenRow Gap="1em" class="border-0 p-3 border-radius-md bg-gray-100">
									<RadzenColumn Size="12" SizeXL="6" SizeXS="12">
										@if (TypeCode == "cdr")
										{
												<div class="mb-2 text-sm">Discount Percentage: <div class="text-dark font-weight-bold ms-2">@(invoice.InvoiceBalance == 0 ? 0 : Math.Round((details.AdjustmentAmount / invoice.InvoiceBalance) * 100, 2)) %</div></div>
											<div class="mb-2 text-sm">Discount Value: <div class="text-dark font-weight-bold ms-2">@details.AdjustmentAmount.ToPhp()</div></div>
										}
										else
										{
											<div class="mb-2 text-sm">Adjustment Amount: <div class="text-dark font-weight-bold ms-2">@details.AdjustmentAmount.ToPhp()</div></div>
										}
									</RadzenColumn>
									<RadzenColumn Size="12" SizeXL="6" SizeXS="12">
										<div class="mb-2 text-sm">Remarks: </div>
										<RadzenTextArea class="w-100" Disabled="true" Value="@details.Remarks"/>
									</RadzenColumn>
								</RadzenRow>
								@if ((TypeCode is "sar" or "bca") && details.ApplyReceiptEnabled && details.ReceiptApplications.Any())
								{
									<ApplyReceiptApplicationsDisplay Applications="@details.ReceiptApplications" />
								}
							</RadzenColumn>
						</BodyTtemplate>
					</CardStandard>
				</RadzenColumn>
			}
		</RadzenRow>

		<RadzenRow>
			<RadzenColumn Size="12" SizeMD="4">
				<Timeline Transactions="details.TransactionHistories" />
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="8">
				<AttachmentsDatatable Notes="@details.Notes" ShowOtherColumns=true />
			</RadzenColumn>
		</RadzenRow>
	}
	else if (isReady)
	{
		<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Danger" Size="AlertSize.Medium">
			Failed to load receipt details. Please refresh the page or contact support if the issue persists.
		</RadzenAlert>
	}
</RadzenStack>

@code {
	[Parameter] public long RequestId { get; set; }
	[Parameter] public string TypeCode { get; set; }
	[Parameter, SupplyParameterFromQuery(Name = "q")] public string? QueryAction { get; set; }

	private RequestAuditDto requestAudit;
	private ReceiptAdjustmentUpdateResponseDto details;
	private InvoiceDetailsDto invoice;
	private ReceiptAdjustmentUpdateRequestDto data;
	private BaseReceiptAdjustment? baseReceiptAdjustment;
	private CreateCashDiscountAdjustment? cashDiscountAdjustment;
	private ApplyReceiptEditor? applyReceiptEditor;
	private FusionPostingOverlay postingOverlay = default!;
	private bool isPosting;

	private bool isOnSearch;
	private bool isLoading;
	private bool isReady;
	private bool isCashDiscountInitialized;
	private bool isUpdatable;
	private bool isStatusChangeable = false;
	private string role;
	private string requestStatus = string.Empty;
	private string adjustmentName;
	private string inputHash = string.Empty;
	private bool isRequestUpdatable => isUpdatable && role == "Requestor";

	// Apply Receipt can be corrected only on the request that already carries it
	// (Write-Off: Small Amount or Bank Charges raised against a receipt).
	private bool CanEditApplyReceipt =>
		(TypeCode is "sar" or "bca") &&
		details?.ApplyReceiptEnabled == true &&
		details.ReceiptApplications.Any() &&
		ShouldRenderReceiptSummary();

	private double ReceiptBalance => invoice?.ReceiptBalance ?? invoice?.InvoiceBalance ?? 0;

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnInitializedAsync()
	{
		isReady = false;

		switch (TypeCode)
		{
			case "cdr":
				adjustmentName = "Cash Discount";
				isCashDiscountInitialized = true;
				break;
			case "bca":
				adjustmentName = "Bank Charge";
				isCashDiscountInitialized = true;
				break;
			case "sar":
				adjustmentName = "Write Off Small Amount";
				break;
		}

		try
		{
			await base.OnInitializedAsync();

			details = await RequestService.GetReceiptDetails(RequestId);
			role = await AuthService.GetRole();

			var request = await RequestService.GetRequestDetails(RequestId);
			requestStatus = request.Status;
			isUpdatable = await RequestService.IsUpdatable(RequestId);
			isStatusChangeable = role.CanUpdateApprovalStatus(requestStatus);

			data = new ReceiptAdjustmentUpdateRequestDto
			{
				AdjustmentAmount = details.AdjustmentAmount,
				Remarks = details.Remarks
			};
			invoice = ToInvoiceDetails(details.Invoice, details.AdjustmentAmount);

			var savedApplications = details.ApplyReceiptEnabled
				? details.ReceiptApplications.Select(a => (a.PaymentScheduleId, a.AppliedAmount))
				: Enumerable.Empty<(long PaymentScheduleId, double AppliedAmount)>();
			inputHash = Utils.Security.ObjectHash(BuildChangeSnapshot(savedApplications));
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Initialization Failed");
		}
		finally
		{
			isReady = true;
		}
	}

	private static InvoiceDetailsDto? ToInvoiceDetails(
		InvoiceDetailsRequestDto? source,
		double adjustmentAmount)
	{
		if (source is null)
			return null;

		return new InvoiceDetailsDto
		{
			Id = source.InvoiceNumber,
			InvoiceNumber = source.InvoiceNumber,
			InvoiceAmount = source.InvoiceAmount,
			InvoiceBalance = source.InvoiceBalance > 0 ? source.InvoiceBalance : source.InvoiceAmount,
			InvoiceDate = source.InvoiceDate.ToDateTime(TimeOnly.MinValue),
			CustomerName = source.CustomerName,
			CustomerNumber = source.CustomerNumber,
			// Receipt requests are persisted using the legacy Invoice* columns.
			ReceiptNumber = source.InvoiceNumber,
			ReceiptDate = source.InvoiceDate.ToDateTime(TimeOnly.MinValue),
			ReceiptAmount = source.InvoiceAmount,
			ReceiptBalance = source.InvoiceBalance > 0
				? source.InvoiceBalance
				: Math.Max(0, source.InvoiceAmount - adjustmentAmount),
			DataSource = "SQL"
		};
	}

	public async Task OnSubmit()
	{
		if (isPosting) return;

		try
		{
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to submit the changes of the current request?", "Update Submit Confirmation") ?? false;

			if (!isConfirmed) return;

			SynchronizeAdjustmentInput();
			string? applyReceiptLine = SynchronizeApplyReceiptInput();
			bool hasFieldChanges = false;

			if (isRequestUpdatable)
			{
				var currentApplications = data.ApplyReceiptEnabled is null
					? (details.ApplyReceiptEnabled ? details.ReceiptApplications.Select(a => (a.PaymentScheduleId, a.AppliedAmount)) : Enumerable.Empty<(long PaymentScheduleId, double AppliedAmount)>())
					: (data.ReceiptApplications ?? []).Select(a => (a.PaymentScheduleId, a.AppliedAmount));
				string newHash = Utils.Security.ObjectHash(BuildChangeSnapshot(currentApplications));
				hasFieldChanges = !newHash.Equals(inputHash);
				// A newly added attachment on its own counts as a change (it is uploaded without resubmitting the request).
				bool hasNewAttachments = details.Notes?.Any(n => n is not null && string.IsNullOrEmpty(n.Id)) == true;
				Guards.ThrowInvalidOperationIf(!hasFieldChanges && !hasNewAttachments, "No changes detected in the current request.");
			}

			await postingOverlay.RunAsync(
				FusionPostingOverlay.SubmittingChangesTitle,
				[$"{adjustmentName} of {FusionPostingOverlay.FormatSummaryAmount(data.AdjustmentAmount)}", applyReceiptLine, FusionPostingOverlay.DescribeAttachments(details.Notes)],
				FusionPostingOverlay.SubmittingNote,
				() => RequestService.Update(isRequestUpdatable && hasFieldChanges, RequestId, data, details.Notes));
			RefreshPage();
		}
		catch (AttachmentUploadException ex)
		{
			// The changes were saved; reload so they aren't submitted twice.
			await DialogService.Alert(ex.Message, AttachmentUploadException.Title);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	private void HandleAdjustment(AdjustmentEntry entry)
	{
		data.AdjustmentAmount = entry.Amount;
		data.Remarks = entry.Remarks;
	}

	private void SynchronizeAdjustmentInput()
	{
		AdjustmentEntry? entry = TypeCode == "cdr"
			? cashDiscountAdjustment?.GetCurrentEntry()
			: baseReceiptAdjustment?.GetCurrentEntry();

		if (entry is null)
			return;

		data.AdjustmentAmount = entry.Amount;
		data.Remarks = entry.Remarks;
	}

	/// <summary>
	/// Copies the Apply Receipt editor's selection into the update and checks it.
	/// Returns a summary line for the progress overlay, or null when Apply Receipt isn't edited here.
	/// </summary>
	private string? SynchronizeApplyReceiptInput()
	{
		data.ApplyReceiptEnabled = null;
		data.ReceiptApplications = null;

		if (!isRequestUpdatable || !CanEditApplyReceipt || applyReceiptEditor is null)
			return null;

		Guards.ThrowInvalidOperationIf(
			!applyReceiptEditor.IsReady,
			"The open invoices for Apply Receipt haven't loaded. Please press Refresh in the Apply Receipt section and try again.");

		var state = applyReceiptEditor.GetState();
		data.ApplyReceiptEnabled = state.IsEnabled;
		data.ReceiptApplications = state.SelectedApplications;

		if (!state.IsEnabled)
			return "Apply receipt turned off";

		Guards.ThrowInvalidOperationIf(
			!state.SelectedApplications.Any(),
			"Enable Apply Receipt requires at least one selected invoice with a positive applied amount.");

		var total = Math.Round(state.TotalAppliedAmount + data.AdjustmentAmount, 2);
		Guards.ThrowInvalidOperationIf(
			ReceiptBalance > 0 && total > Math.Round(ReceiptBalance, 2),
			$"The adjustment amount plus the applied invoice amounts ({total:N2}) is more than the receipt balance ({ReceiptBalance:N2}).");

		var count = state.SelectedApplications.Count;
		return $"Apply receipt to {count} {(count == 1 ? "invoice" : "invoices")} ({FusionPostingOverlay.FormatSummaryAmount(state.TotalAppliedAmount)})";
	}

	/// <summary>The values that count as a change: amount, remarks and the invoice applications.</summary>
	private object BuildChangeSnapshot(IEnumerable<(long PaymentScheduleId, double AppliedAmount)> applications) => new
	{
		data.AdjustmentAmount,
		data.Remarks,
		Applications = applications
			.Where(a => a.AppliedAmount > 0)
			.OrderBy(a => a.PaymentScheduleId)
			.Select(a => $"{a.PaymentScheduleId}:{a.AppliedAmount:0.00}")
			.ToList()
	};

	private void HandleSearchChanged(bool value) => isOnSearch = value;
	private void HandleLoadingChanged(bool value) => isLoading = value;

	protected async Task OnApprove()
	{
		if (isPosting) return;

		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"APPROVE\" this request?", "Approve Request") ?? false;
			if (!isConfirmed) return;

			bool isFinalApprover = await RequestService.IsFinalApprover();

			if (isFinalApprover)
			{
				// Final approval posts to Oracle Fusion, which can take a while.
				await postingOverlay.RunAsync(
					FusionPostingOverlay.FusionPostingTitle,
					["Preparing the posting details…"],
					FusionPostingOverlay.FusionPostingNote,
					async () =>
					{
						var stagingDetails = await RequestService.GetReceiptStagingDataByRequestId(RequestId);
						await postingOverlay.SetLinesAsync(FusionPostingOverlay.DescribePostings(stagingDetails));
						await RequestService.Approve(RequestId, details.Notes, stagingDetails);
					});
			}
			else
			{
				await postingOverlay.RunAsync(
					"Approving request…",
					null,
					null,
					() => RequestService.Approve(RequestId, details.Notes, null));
			}

			RefreshPage(isFinalApprover ? Queries.Success.POSTED : Queries.Success.APPROVED);
		}
		catch (Exception ex)
		{
			var (title, message) = FusionPostingOverlay.DescribeFailure(ex, GetApprovalFailureTitle(ex));
			await DialogService.Alert(message, title);
		}
	}

	private static string GetApprovalFailureTitle(Exception exception)
	{
		var message = exception.ToString();

		if (message.Contains("applyReceipt", StringComparison.OrdinalIgnoreCase)
			|| message.Contains("Apply Receipt", StringComparison.OrdinalIgnoreCase)
			|| message.Contains("ReceiptId is required", StringComparison.OrdinalIgnoreCase)
			|| message.Contains("invoice applications were provided", StringComparison.OrdinalIgnoreCase))
		{
			return "Apply Receipt Posting Failed";
		}

		if (message.Contains("write-off", StringComparison.OrdinalIgnoreCase)
			|| message.Contains("write off", StringComparison.OrdinalIgnoreCase))
		{
			return "Write-Off Posting Failed";
		}

		return "Request Approval Failed";
	}

	protected async Task OnDecline()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"DECLINE\" this request?", "Decline Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Decline(RequestId, details.Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Decline Failed");
		}
	}

	protected async Task OnReject()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"REJECT\" this request?", "Reject Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Reject(RequestId, details.Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Decline Failed");
		}
	}

	protected void RefreshPage(string query = Queries.Success.CREATE)
	{
		var uri = NavigationManager.GetUriWithQueryParameter("q", query);
		NavigationManager.NavigateTo(uri, true);
	}

	private bool ShouldRenderReceiptSummary()
	{
		if (!string.IsNullOrWhiteSpace(details?.Invoice?.SourceType))
			return string.Equals(details.Invoice.SourceType, "Receipt", StringComparison.OrdinalIgnoreCase);

		return TypeCode is "bca" or "cdr" or "sar";
	}
}
