@page "/requests/apar"

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.Pages.Requests.CashDiscount
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Requestor")]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject ICashDiscountService CashDiscountService

<h2>APAR Adjustment</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />

	<RadzenRow>
		<div>
			<h3 class="pb-0 mb-0">Cash Discount</h3>
		</div>
		<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid class="border-0"
							@ref="adjustmentGrid"
							AllowFiltering="true"
							AllowColumnResize="true"
							AllowAlternatingRows="false"
							FilterMode="FilterMode.Advanced"
							AllowSorting="true"
							PageSize="20"
							AllowPaging="true"
							PagerHorizontalAlign="HorizontalAlign.Left"
							ShowPagingSummary="true"
							Data="@Adjustments"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
					<RadzenDataGridColumn Frozen="true" Title="Edit" Sortable="false" Filterable="false" Width="80px" TextAlign="TextAlign.Center">
						<Template Context="data">
							<RadzenButton Icon="Edit" Variant="Variant.Outlined" Click="@(args => OpenEdit(data))" />
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.AdjustmentAmount)" Width="120px" Title="Adjustment Amount">
						<Template Context="data">
							@data.AdjustmentAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.InvoiceAmount)" Title="Invoice Amount">
						<Template Context="data">
							@data.InvoiceAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.InvoiceDate)" Title="Invoice Date" />
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.InvoiceNumber)" Title="Invoice Number" />
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.CustomerName)" Title="Customer Name" />
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.CustomerNumber)" Title="Customer Number" />
					<RadzenDataGridColumn Property="@nameof(CashDiscountRowDto.Remarks)" Title="Remarks" />
				</Columns>
			</RadzenDataGrid>
		</div>

	</RadzenRow>

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>



@code {
	[Parameter] public IList<CashDiscountRowDto> Adjustments { get; set; }
	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<CashDiscountRowDto> adjustmentGrid;
	private RequestAuditDto requestAudit;

	private bool isOnSearch;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		Adjustments = new List<CashDiscountRowDto>();
		searchedInvoiceNumber = new InvoiceDetailsDto();
		requestAudit = new RequestAuditDto();
		// TestCashDiscountRows(); // For testing Only

		requestAudit.Requestor = await AuthService.GetLastFirstName();
	}

	private void TestCashDiscountRows()
	{
		// For Demo Purposes Only - Remove this on Production
		string[] firstNames = { "James", "Emma", "Michael", "Olivia", "William", "Sophia", "Daniel", "Isabella", "Matthew", "Ava" };
		string[] lastNames = { "Smith", "Johnson", "Williams", "Brown", "Jones", "Miller", "Davis", "Garcia", "Rodriguez", "Martinez" };  

		Random rand = new Random();
		double min = 1000.00;
		double max = 10000000.00;

		for (int x = 0; x < rand.Next(1, 10); x++)
		{
			float discountValue = (float)rand.NextDouble();

			var invoiceDetails = new InvoiceDetailsDto();
			string first = firstNames[rand.Next(firstNames.Length)];
			string last = lastNames[rand.Next(lastNames.Length)];

			invoiceDetails.InvoiceAmount = rand.NextDouble() * (max - min) + min;
			invoiceDetails.InvoiceNumber = rand.Next(20_000, 9_000_000).ToString();
			invoiceDetails.InvoiceDate = DateTime.Now.AddDays(-rand.Next(10, 200));
			invoiceDetails.CustomerName = first + " " + last;
			invoiceDetails.CustomerNumber = "09123456789";

			var row = new CashDiscountRowDto(
				discountValue,
				$"{(discountValue * 100).ToString("N2")}% Discount Remarks",
				invoiceDetails
			);

			Adjustments.Add(row);
		}
	}


	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		await DialogService.OpenAsync<AddCashDiscount>(
			"Add Cash Discount Adjustment",
			new Dictionary<string, object>()
			{
				{ "Rows", Adjustments },
				{ "Grid", adjustmentGrid },
				{ "InvoiceDetails", invoiceDetails }
			},
			new DialogOptions() { Width = "800px", Height = "auto" }
		);
	}

	public async Task OpenEdit(CashDiscountRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditCashDiscount>(
				"Edit Cash Discount Adjustment",
				new Dictionary<string, object>()
				{
				{ "Rows", Adjustments },
				{ "Grid", adjustmentGrid },
				{ "Data", data }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			if (!Adjustments.Any())
				throw new InvalidOperationException("Can't submit request because there are no adjustment in the current request");

			if (isLoading)
				throw new InvalidOperationException("Can't submit request while search operation is ongoing");

			await DialogService.OpenAsync<CashDiscountModalSummary>(
				"Submit Cash Discount Adjustment",
				new Dictionary<string, object>()
				{
					{ "Rows", Adjustments },
					{ "RequestAudit", requestAudit },
					{ "OnSubmit", SubmitRequest },
					{ "SucccessSubmissionRoute", "/requests/cash-discount" },
				},
				new DialogOptions() { Width = "1500px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		await CashDiscountService.Create(Adjustments);
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

}
