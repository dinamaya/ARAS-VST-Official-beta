@using ARAS.Blazor.App_Code.Globals.Enums
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Repositories.Interfaces
@using ARAS.Blazor.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@typeparam TRow where TRow : AdjustmentRow
@inject IRequestService RequestService
@inject INoteService NoteService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

@inherits ComponentBase

<h3>Update @Title</h3>
<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<RadzenRow>
		@if (isApprovable)
		{
			<RadzenStack class="w-100" JustifyContent="JustifyContent.End" Orientation="Orientation.Horizontal">
				<RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Reject" class="btn-danger" Icon="cancel" Click="OnReject" />
				<RadzenButton ButtonStyle="ButtonStyle.Warning" Text="Decline" class="btn-dark" Icon="thumb_down" Click="OnDecline" />
				
				@if (AdjustmentStage == AdjustmentStageType.APPROVAL)
				{
					<RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Approve" class="btn-primary" Icon="thumb_up" Click="OnApprove" />
				}
				else if (AdjustmentStage == AdjustmentStageType.VALIDATION)
				{
					<RadzenButton ButtonStyle="ButtonStyle.Success" Text="Validate" class="btn-success" Icon="assignment_turned_in" Click="OnValidate" />
				}

			</RadzenStack>
		}
	</RadzenRow>
	<RadzenRow>
		<div class="py-4 px-3 w-100 card">
			@if (Summary == null)
			{
				<RequestAdjustmentsSummary Rows="rows" RequestAudit="requestAudit" Title="@Title" />
			}
			else
			{
				@Summary(new() { Rows = rows, RequestAudit = requestAudit })
			}
		</div>
	</RadzenRow>
	<RadzenRow>
		<RadzenColumn Size="4">
			<Timeline RequestId="@RequestId" />
		</RadzenColumn>
		<RadzenColumn Size="8">
			<AttachmentsDatatable Notes="@notes" ShowOtherColumns=isApprovable />
		</RadzenColumn>
	</RadzenRow>
</RadzenStack>

@code {
	[Parameter] public AdjustmentStageType AdjustmentStage { get; set; }
	[Parameter] public long RequestId { get; set; }
	[Parameter] public string Title { get; set; }
	[Parameter] public string Route { get; set; }
	[Parameter] public ICreateStatusRepository<TRow> CreateStatusRepository { get; set; }
	[Parameter] public IAdjustmentReaderRepository<TRow> AdjustmentReaderRepository { get; set; }
	[Parameter] public RenderFragment<SummaryDataTableContext<TRow>>? Summary { get; set; }

	private IEnumerable<TRow> rows;
	private IList<NoteRowDto> notes;
	private RequestAuditDto requestAudit;
	private bool isApprovable = false;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		var request = await RequestService.GetRequestDetails(RequestId);
		rows = await AdjustmentReaderRepository.GetAdjustments(RequestId);
		notes = await NoteService.GetRows(RequestId);

		isApprovable = AdjustmentStage switch
		{
			AdjustmentStageType.APPROVAL => await RequestService.IsApprovable(RequestId),
			AdjustmentStageType.VALIDATION => await RequestService.IsValidatable(RequestId),
			_ => false,
		};

		requestAudit = new RequestAuditDto(request);
	}

	protected async Task OnApprove()
	{
		bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"APPROVE\" this request?", "Approve Request") ?? false;
		if (!isConfirmed) return;

		await CreateStatusRepository.Approve(RequestId, notes);
		RedirectToList();
	}

	protected async Task OnValidate()
	{
		bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"VALIDATE\" this request?", "Validate Request") ?? false;
		if (!isConfirmed) return;

		await CreateStatusRepository.Validate(RequestId, notes);
		RedirectToList();
	}

	protected async Task OnDecline() => await ModalTemplates.UpdateStatus.Decline(DialogService, Decline);
	protected async Task OnReject() => await ModalTemplates.UpdateStatus.Reject(DialogService, Reject);

	private async Task Decline(string remarks)
	{
		var createDto = new NegateRequestDto()
		{
			Remarks = remarks,
			RequestId = RequestId
		};

		await CreateStatusRepository.Decline(createDto, notes);
		RedirectToList();
	}

	private async Task Reject(string remarks)
	{
		var createReject = new NegateRequestDto()
		{
			Remarks = remarks,
			RequestId = RequestId
		};

		await CreateStatusRepository.Reject(createReject, notes);
		RedirectToList();
	}

	private void RedirectToList()
	{
		string baseRoute = AdjustmentStage switch
		{
			AdjustmentStageType.APPROVAL => "approvals",
			AdjustmentStageType.VALIDATION => "validations",
			_ => throw new InvalidOperationException("Invalid Adjustment Stage Type"),
		};
		NavigationManager.NavigateTo($"/{baseRoute}/{Route}", true);
	}
}
