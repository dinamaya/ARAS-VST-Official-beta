@page "/submissions/invoice/arr/{RequestId:long}"

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Pages.Requests.APAROffset
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting
@using ARAS.Blazor.Components.Pages.Requests.APAROffset.Modal
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization
@inject DialogService DialogService

@attribute [Authorize]
@inherits ComponentBase
@inject NavigationManager NavigationManager
@inject IQueryService QueryService
@inject IAuthService AuthService
@inject ISearchOptionService SearchOptionService
@inject IAPAROffsetService APAROffsetService
@inject IRequestService RequestService
@inject INoteService NoteService


<h2>AP AR : Offset</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	@if (isRequestUpdatable)
	{
		<SearchInvoiceAPARDetails OnAPAdd="AddAP" OnARAdd="AddAR" />
	}

	@code { [Parameter, SupplyParameterFromQuery(Name = "q")] public string? QueryAction { get; set; } }
	@if (Utils.Equals(QueryAction, Queries.Success.CREATE))
	{
		<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
			Invoice Adjustment updated successfully
		</RadzenAlert>
	}

	@if (isReady)
	{
		<RadzenRow Gap="1.5rem">
			<RadzenColumn Size="5">
				<div class="text-center pb-3">
					<h3 class="pb-0 mb-0">AP GROUP</h3>
				</div>
				<div class="py-4 px-3 w-100 card">
					<RadzenDataGrid @ref="apGrid"
									AllowFiltering="false"
									AllowColumnResize="true"
									AllowAlternatingRows="false"
									AllowSorting="true"
									PageSize="20"
									AllowPaging="true"
									PagerHorizontalAlign="HorizontalAlign.Left"
									ShowPagingSummary="true"
									Data="@APAdjustments"
									LogicalFilterOperator="LogicalFilterOperator.Or"
									SelectionMode="DataGridSelectionMode.Single">
						<Columns>
							<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice No.">
								<FooterTemplate>
									<b>Total Amount:</b>
								</FooterTemplate>
							</RadzenDataGridColumn>

							<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.CustomerName)" Title="Customer Name">
								<Template Context="data">
									@((string.IsNullOrWhiteSpace(data.CustomerName) ? data.CustomerNumber : data.CustomerName))
								</Template>
							</RadzenDataGridColumn>

							<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Amount">
								<Template Context="data">
									@data.InvoiceAmount.ToPhp()
								</Template>
								<FooterTemplate>
									<b>@APAdjustments?.Sum(a => a.InvoiceAmount).ToPhp()</b>
								</FooterTemplate>
							</RadzenDataGridColumn>

							@if (isRequestUpdatable)
							{
							<RadzenDataGridColumn TItem="APAROffsetAPRowDto" Context="data" TextAlign="TextAlign.Right">
								<Template Context="data">
									<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@((args) => OnRemoveAPRow(data))" />
								</Template>
							</RadzenDataGridColumn>
							}
						</Columns>
					</RadzenDataGrid>
				</div>
			</RadzenColumn>
			<RadzenColumn Size="7">
				<div class="text-center pb-3">
					<h3 class="pb-0 mb-0">AR GROUP</h3>
				</div>

				<div class="py-4 px-3 w-100 card">
					<RadzenDataGrid TItem="APAROffsetARRowDto"
									@ref="arGrid"
									Data="@ARAdjustments"
									AllowFiltering="false"
									AllowColumnResize="true"
									AllowPaging="false"
									AllowSorting="false"
									EditMode="DataGridEditMode.Single"
									ShowPagingSummary="false"
									RowUpdate="@OnARRowUpdate">

						<Columns>
							<RadzenDataGridColumn TItem="APAROffsetARRowDto" Title="Invoice No.">
								<Template Context="data">
									@if (data.RowType == ARRowType.Invoice)
									{
										@data.InvoiceNumber
									}
									else
									{
										@data.AdjustmentReason
									}
								</Template>

								<FooterTemplate>
									<div><b>Total Amount:</b></div>
									<div class="mt-1"><b class="text-danger">Net Balance to Offset:</b></div>
								</FooterTemplate>

								<EditTemplate Context="data">
									@if (data.RowType == ARRowType.Invoice)
									{
										{
											<div>@data.InvoiceNumber</div>
										}
									}
									else
									{
										<RadzenDropDown @bind-Value="data.AdjustmentReason" Style="width:100%" Data="@reasonCodes"
														Name="@($"AdjustmentReason_{data.Id}")" />
										<RadzenRequiredValidator Component="@($"AdjustmentReason_{data.Id}")"
																 Text="Adjustment reason is required"
																 Popup=true Style="z-index: 9999 !important; position: absolute; margin-top:30px" />
									}
								</EditTemplate>
							</RadzenDataGridColumn>

							<RadzenDataGridColumn TItem="APAROffsetARRowDto" Title="Customer Name">
								<Template Context="data">
									@if (data.RowType == ARRowType.Invoice)
									{
										@(string.IsNullOrWhiteSpace(data.CustomerName) ? data.CustomerNumber : data.CustomerName)
									}
									else
									{
										@string.Empty
									}
								</Template>
							</RadzenDataGridColumn>

							<RadzenDataGridColumn TItem="APAROffsetARRowDto" Property="Amount" Title="Invoice Amount">
								<Template Context="data">
									@if (data.RowType == ARRowType.Invoice)
									{
										@data.InvoiceAmount.ToPhp()
									}
									else
									{
										@string.Empty
									}
								</Template>


								<EditTemplate Context="data">
									@if (isRequestUpdatable)
									{
										@if (data.RowType == ARRowType.Invoice)
										{
											<div style="position: relative; z-index: 1;">
												<RadzenNumeric @bind-Value="data.Amount" Name="@($"Amount_{data.Id}")" Style="width:100%" Step="0.01" />
											</div>
											<RadzenRequiredValidator Component="@($"Amount_{data.Id}")" Text="Amount is required" Popup=true Style="z-index: 9999 !important; position: absolute; margin-top:30px" />
										}
										else
										{
											@string.Empty
										}
									}
								</EditTemplate>
							</RadzenDataGridColumn>


							<RadzenDataGridColumn TItem="APAROffsetARRowDto" Property="Amount" Title="Balance Amount">
								<Template Context="data">
									@data.Amount.ToPhp()
								</Template>
								<EditTemplate Context="data">
									<div style="position: relative; z-index: 1;">
										<RadzenNumeric @bind-Value="data.Amount" Name="@($"Amount_{data.Id}")" Style="width:100%" Step="0.01" />
									</div>

									<RadzenRequiredValidator Component="@($"Amount_{data.Id}")"
															 Text="Amount is required"
															 Popup=true Style="z-index: 9999 !important; position: absolute; margin-top:30px" />

								</EditTemplate>

								<FooterTemplate>
									<div><b>@ARAdjustments.Sum(a => a.Amount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b></div>
									<div class="mt-1"><b class="text-danger">@NetBalance.ToPhp()</b></div>
								</FooterTemplate>
							</RadzenDataGridColumn>

							@if (isRequestUpdatable)
							{
								<RadzenDataGridColumn TItem="APAROffsetARRowDto" Context="data" TextAlign="TextAlign.Right">
									<Template Context="data">
										<RadzenStack Gap="0.6em" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">
											@if (data.RowType == ARRowType.Adjustment)
											{
												<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@((args) => arGrid.EditRow(data))" />
											}
											<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@((args) => OnRemoveRow(data))" />
										</RadzenStack>
									</Template>
									<EditTemplate Context="data">
										<RadzenStack Gap="0.6em" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">
											@if (data.RowType == ARRowType.Adjustment)
											{
												<RadzenButton Icon="save" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@((args) => arGrid.UpdateRow(data))" />
											}
											<RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@((args) => CancelEditRow(data))" />
										</RadzenStack>
									</EditTemplate>
								</RadzenDataGridColumn>
							}
						</Columns>
					</RadzenDataGrid>
					@if (isRequestUpdatable)
					{
						<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mt-2" JustifyContent="JustifyContent.Center">
							<RadzenButton Icon="add_circle" Text="Add Adjustment Reason" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="@(args => AddAdjustmentReasonRow())" />
						</RadzenStack>
					}
				</div>

			</RadzenColumn>
		</RadzenRow>

		<RadzenRow>
			<RadzenColumn Size="12" SizeMD="4">
				<Timeline RequestId="@RequestId" />
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="8">
				<AttachmentsDatatable Notes="Notes" ShowOtherColumns="true" />
			</RadzenColumn>
		</RadzenRow>

		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
			<RadzenRow>
				<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
					Submit
				</button>
			</RadzenRow>
		</RadzenStack>
	}
</RadzenStack>

@code 
	{
	[Parameter] public long RequestId { get; set; }

	[Parameter] public IList<APAROffsetAPRowDto> APAdjustments { get; set; }
	[Parameter] public IList<APAROffsetARRowDto> ARAdjustments { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();
	private IEnumerable<string> reasonCodes { get; set; }

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<APAROffsetAPRowDto> apGrid;
	private RadzenDataGrid<APAROffsetARRowDto> arGrid;

	private bool isOnSearch;
	private bool isLoading;
	private bool isReady = false;
	private bool isUpdatable = false;
	private bool isRequestUpdatable => isUpdatable && role == "Requestor";
	private string role;

	private double NetBalance => (APAdjustments?.Sum(a => a.InvoiceAmount) ?? 0) - (ARAdjustments?.Sum(a => a.Amount) ?? 0);

	// track newly added rows so we can remove them on cancel if they remain empty
	private HashSet<string> newlyAddedRowIds = new();
	
	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		var adjustments = await APAROffsetService.GetAdjustments(RequestId);
		APAdjustments = adjustments.APGroup.ToList();
		ARAdjustments = adjustments.ARGroup.ToList();
		searchedInvoiceNumber = new InvoiceDetailsDto();
		reasonCodes = await SearchOptionService.GetReasonCodes();
		role = await AuthService.GetRole();
		isReady = true;
		isUpdatable = await RequestService.IsUpdatable(RequestId);
		Notes = await NoteService.GetRows(RequestId);
		StateHasChanged();
		await apGrid.Reload();
		await arGrid.Reload();
	}

	public async Task OpenEdit(APAROffsetAPRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditARInvoiceOffsetting>(
				"Edit Cash Discount Adjustment",
				new Dictionary<string, object>()
				{
				{ "Rows", APAdjustments },
				{ "Grid", apGrid },
				{ "Data", data }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(!ARAdjustments.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			bool isConfirmed = await DialogService.Confirm("Would you like to submit the following \"Invoice Adjustment(s)\"?", "Update AP-AR Offset Request") ?? false;
			if (!isConfirmed)
				return;

			// row-level validation before opening modal
			if (!ValidateARRows(out var message))
			{
				await DialogService.Alert(message, "Validation Failed");
				return;
			}

			var apTotal = APAdjustments.Sum(a => a.InvoiceAmount);
			var arTotal = Math.Round(ARAdjustments.Sum(a => a.Amount), 2);

			Guards.ThrowInvalidOperationIf((apTotal != arTotal), "AP and AR amounts must balance.");

			await SubmitRequest();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		await APAROffsetService.Update(isRequestUpdatable, RequestId, APAdjustments, ARAdjustments, Notes);

		var uri = NavigationManager.GetUriWithQueryParameter("q", Queries.Success.CREATE);
		NavigationManager.NavigateTo(uri, true);
	}

	protected async Task AddAR(InvoiceDetailsDto data)
	{
		await DialogService.OpenAsync<AddAPAROffsettingAR>(
			"Confirm AR Invoice Number",
			new Dictionary<string, object>()
			{
				{ "Rows", ARAdjustments },
				{ "Grid", arGrid },
				{ "InvoiceDetails", data },
			},
			ModalTemplates.Variant.XSMALL
		);
	}

	protected async Task AddAP(InvoiceDetailsDto data)
	{
		await DialogService.OpenAsync<AddAPAROffsettingAP>(
			"Confirm AP Invoice Number",
			new Dictionary<string, object>()
			{
				{ "Rows", APAdjustments },
				{ "Grid", apGrid },
				{ "InvoiceDetails", data }
			},
			ModalTemplates.Variant.XSMALL
		);
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

	private async Task AddInvoiceRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			Id = Guid.NewGuid().ToString(),
			RowType = ARRowType.Invoice,
			InvoiceNumber = string.Empty,
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		newlyAddedRowIds.Add(newRow.Id);
		await arGrid.Reload();
		await arGrid.EditRow(newRow);
		StateHasChanged();
	}

	private void OnARRowUpdate(APAROffsetARRowDto args)
	{
		StateHasChanged();
	}

	private void OnAPRowUpdate(APAROffsetAPRowDto args)
	{
		StateHasChanged();
	}

	private async Task AddAdjustmentReasonRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			Id = Guid.NewGuid().ToString(),
			RowType = ARRowType.Adjustment,
			AdjustmentReason = reasonCodes.FirstOrDefault(),
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		newlyAddedRowIds.Add(newRow.Id);
		await arGrid.Reload();
		await arGrid.EditRow(newRow);
		StateHasChanged();
	}

	private async Task OnRemoveRow(APAROffsetARRowDto item)
	{
		ARAdjustments.Remove(item);
		newlyAddedRowIds.Remove(item?.Id);
		await arGrid.Reload();
		StateHasChanged();
	}

	private async Task OnRemoveAPRow(APAROffsetAPRowDto item)
	{
		APAdjustments.Remove(item);
		await apGrid.Reload();
		StateHasChanged();
	}

	private async Task CancelEditRow(APAROffsetARRowDto data)
	{
		arGrid.CancelEditRow(data);

		if (data != null && !string.IsNullOrEmpty(data.Id) && newlyAddedRowIds.Contains(data.Id))
		{
			if (IsRowEffectivelyEmpty(data))
			{
				ARAdjustments.Remove(data);
				newlyAddedRowIds.Remove(data.Id);
				await arGrid.Reload();
			}
			else
			{
				newlyAddedRowIds.Remove(data.Id);
			}
		}
		StateHasChanged();
	}

	private bool IsRowEffectivelyEmpty(APAROffsetARRowDto row)
	{
		if (row == null) return true;

		if (row.RowType == ARRowType.Invoice)
		{
			return string.IsNullOrWhiteSpace(row.InvoiceNumber) && (row.Amount == 0.0);
		}
		else
		{
			return string.IsNullOrWhiteSpace(row.AdjustmentReason) && (row.Amount == 0.0);
		}
	}

	private bool ValidateARRows(out string message)
	{
		message = string.Empty;

		if (ARAdjustments == null || !ARAdjustments.Any())
		{
			message = "AR Group has no rows.";
			return false;
		}

		foreach (var ar in ARAdjustments)
		{
			if (ar == null)
			{
				message = "AR Group contains an invalid row.";
				return false;
			}

			if (ar.RowType == ARRowType.Invoice)
			{
				if (string.IsNullOrWhiteSpace(ar.InvoiceNumber))
				{
					message = "AR Group: Invoice number is required for invoice rows.";
					return false;
				}
			}
			else
			{
				if (string.IsNullOrWhiteSpace(ar.AdjustmentReason))
				{
					message = "AR Group: Adjustment reason is required for adjustment rows.";
					return false;
				}
			}

			if (ar.Amount == 0.0)
			{
				var id = ar.RowType == ARRowType.Invoice ? ar.InvoiceNumber : ar.AdjustmentReason;
				message = $"AR Group: Amount must not be 0.00 for '{id ?? "unknown"}'.";
				return false;
			}
		}

		return true;
	}
}