@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces

@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inherits ComponentBase

<RadzenStack Gap="0">
	<RadzenImage Path="@Assets["/img/icons/VST-ECS.png"]" Style="width: 170px" />
	<RadzenStack class="w-100" AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
		<div class="h-100">
			<h2 class="text-capitalize m-0">
				Write Off: Sales Return Auto Net
			</h2>
		</div>
		<RadzenTable class="w-25 border-0 mb-2" GridLines="DataGridGridLines.None" AllowAlternatingRows="false">
			<RadzenTableBody>
				<RadzenTableRow>
					<RadzenTableCell class="p-1">
						Request No:
					</RadzenTableCell>
					<RadzenTableCell class="p-1">
						<b>@RequestAudit?.ReferenceNumber</b>
					</RadzenTableCell>
				</RadzenTableRow>

				<RadzenTableRow>
					<RadzenTableCell class="p-1">
						Date Requested
					</RadzenTableCell>
					<RadzenTableCell class="p-1">
						<b>@RequestAudit?.DateRequested</b>
					</RadzenTableCell>
				</RadzenTableRow>
			</RadzenTableBody>
		</RadzenTable>
	</RadzenStack>

	<div style="overflow-x:auto; width:100%;">
		<RadzenTable class="w-100 pb-2" GridLines="DataGridGridLines.Both" AllowAlternatingRows="false">
			<RadzenTableHeader>
				<RadzenTableHeaderRow>
					<RadzenTableHeaderCell Style="min-width: 170px; width: 170px; text-align: center">
						Adjustment <br />Amount
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 220px; width: 220px; text-align: center">
						GL Date
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 170px; width: 170px; text-align: center">
						Adjustment<br />Activity
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 220px; width: 220px; text-align: center">
						Invoice Number
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 400px; width: 400px; text-align: center">
						Customer Name
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 220px; width: 220px; text-align: center">
						Customer Number
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 120px; width: 120px; text-align: center">
						Reason<br />Code
					</RadzenTableHeaderCell>
					<RadzenTableHeaderCell Style="min-width: 500px; width: 500px; text-align: center; padding: 0px;">
						<RadzenTable GridLines="DataGridGridLines.Both" Style="padding: 0px; border: none;">
							<RadzenTableHeader>
								<RadzenTableHeaderCell Style="text-align: center">
									Remarks
								</RadzenTableHeaderCell>
							</RadzenTableHeader>
						</RadzenTable>
						<RadzenTable GridLines="DataGridGridLines.Both" Style="padding: 0px; margin: 0px;">
							<RadzenTableHeader>
								<RadzenTableHeaderRow>
									<RadzenTableHeaderCell Style="text-align: center">
										CN REF
									</RadzenTableHeaderCell>
									<RadzenTableHeaderCell Style="text-align: center">
										CN AMT
									</RadzenTableHeaderCell>
									<RadzenTableHeaderCell Style="text-align: center">
										WT
									</RadzenTableHeaderCell>
								</RadzenTableHeaderRow>
							</RadzenTableHeader>
						</RadzenTable>
					</RadzenTableHeaderCell>
				</RadzenTableHeaderRow>
			</RadzenTableHeader>
			<RadzenTableBody>
				@if (Rows != null)
				{
					@foreach (var data in Rows)
					{
						<RadzenTableRow>
							<RadzenTableCell Style="min-width: 170px; width: 170px; text-align: end">
								@data.AdjustmentAmount.ToPhp()
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 170px; width: 170px; text-align: center">
								@data.InvoiceDate
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 170px; width: 170px; text-align: end">
								@data.AdjustmentActivity
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 220px; width: 220px; text-align: center">
								@data.InvoiceNumber
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 400px; width: 400px; text-align: center">
								@data.CustomerName
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 220px; width: 220px; text-align: center">
								@data.CustomerNumber
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 120px; width: 120px; text-align: center">
								@data.ReasonCode
							</RadzenTableCell>
							<RadzenTableCell Style="min-width: 500px; width: 500px; text-align: center; padding: 0px;">
								<RadzenTable GridLines="DataGridGridLines.Both">
									<RadzenTableBody Style="padding: 0px; margin: 0px;">
										@foreach (var item in data.Remarks)
										{
											<RadzenTableRow>
												<RadzenTableCell Style="text-align: center">
													@item.CNRef
												</RadzenTableCell>
												<RadzenTableCell Style="text-align: end">
													@item.CNAmt.ToPhp()
												</RadzenTableCell>
												<RadzenTableCell Style="text-align: end">
													@item.WT.ToPhp()
												</RadzenTableCell>
											</RadzenTableRow>
										}
									</RadzenTableBody>
								</RadzenTable>
							</RadzenTableCell>
						</RadzenTableRow>
					}
				}
			</RadzenTableBody>
		</RadzenTable>

		<RadzenTable class="w-100 pb-2" GridLines="DataGridGridLines.Both" AllowAlternatingRows="false">
			<RadzenTableBody>
				<RadzenTableRow>
					<RadzenTableCell Style="width: 220px; text-align: center">
						<b>Requested By:</b>
					</RadzenTableCell>
					<RadzenTableCell Style="width: 170px; text-align: center">
						<b>CNC Approved By:</b>
					</RadzenTableCell>
					<RadzenTableCell Style="width: 220px; text-align: center">
						<b>FSG Validated By:</b>
					</RadzenTableCell>
				</RadzenTableRow>
				<RadzenTableRow>
					<RadzenTableCell Style="width: 220px; text-align: center">
						@RequestAudit?.Requestor
					</RadzenTableCell>
					<RadzenTableCell Style="width: 170px; text-align: center">
						@RequestAudit?.Approver
					</RadzenTableCell>
					<RadzenTableCell Style="width: 220p; text-align: center">
						@RequestAudit?.Validator
					</RadzenTableCell>
				</RadzenTableRow>
			</RadzenTableBody>
		</RadzenTable>
	</div>

</RadzenStack>


@code {
	[Parameter] public IEnumerable<SRAutoNetRowDto> Rows { get; set; }
	[Parameter] public RequestAuditDto RequestAudit { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}
}