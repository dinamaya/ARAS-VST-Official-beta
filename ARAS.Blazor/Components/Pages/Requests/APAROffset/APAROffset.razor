@page "/requests/apar-offset"

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting
@using ARAS.Blazor.Components.Pages.Requests.APAROffset.Modal
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization
@inject DialogService DialogService

@attribute [Authorize(Roles = "Requestor")]
@inherits ComponentBase
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject ISearchOptionService SearchOptionService
@inject IAPAROffsetService APAROffsetService

<h2>AP AR : Offset</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />

	<RadzenRow Gap="1.5rem">
		<RadzenColumn Size="6">
		<div  class="text-center">
			<h3 class="pb-0 mb-0">AP GROUP</h3>
		</div>
			<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid @ref="apGrid"
							AllowFiltering="false"
							AllowColumnResize="true"
							AllowAlternatingRows="false"
							AllowSorting="true"
							PageSize="20"
							AllowPaging="true"
							PagerHorizontalAlign="HorizontalAlign.Left"
							ShowPagingSummary="true"
							Data="@APAdjustments"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice No.">
						<FooterTemplate>
							<b>Total Amount:</b>
						</FooterTemplate>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Amount">
						<Template Context="data">
							@data.InvoiceAmount.ToPhp()
						</Template>
						<FooterTemplate>
								<b>@APAdjustments?.Sum(a => a.InvoiceAmount).ToPhp()</b>
							</FooterTemplate>
					</RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</div>
		</RadzenColumn>
		<RadzenColumn Size="6">
			<div class="text-center">
				<h3 class="pb-0 mb-0">AR GROUP</h3>
			</div>

			<div class="py-4 px-3 w-100 card">
				<RadzenDataGrid TItem="APAROffsetARRowDto"
								@ref="arGrid"
								Data="@ARAdjustments"
								AllowFiltering="false"
								AllowPaging="false"
								AllowSorting="false"
								EditMode="DataGridEditMode.Single"
								ShowPagingSummary="false">

					<Columns>
						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Title="Invoice No.">
							<Template Context="data">
								@if (data.RowType == ARRowType.Invoice)
								{
									@data.InvoiceNumber
								}
								else
								{
									@data.AdjustmentReason
								}
							</Template>

							<FooterTemplate>
								<b>Total Amount:</b>
							</FooterTemplate>

							<EditTemplate Context="data">
								@if (data.RowType == ARRowType.Invoice)
								{
									<RadzenStack Orientation="Orientation.Vertical">  
										<RadzenTextBox @bind-Value="data.InvoiceNumber"
													   Name="InvoiceNumber"
													   Style="width:100%" />

										<RadzenRegexValidator Component="InvoiceNumber"
															  Text="Please enter numbers only"
															  Pattern="^\d+$"
															  Popup=true Style="z-index: 9999 !important; position: absolute; margin-top:30px"/>
									</RadzenStack>
								}
								else
								{
									<RadzenDropDown @bind-Value="data.AdjustmentReason" Style="width:100%" Data="@reasonCodes" />
								}
							</EditTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Property="Amount" Title="Amount">
							<Template Context="data">
								@data.Amount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
							</Template>
							<EditTemplate Context="data">
								<div style="position: relative; z-index: 1;">
								<RadzenNumeric @bind-Value="data.Amount"
											   Style="width:100%"
											   Step="0.01"
											    />
								</div>
							</EditTemplate>

							<FooterTemplate>
								<b>@ARAdjustments.Sum(a => a.Amount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b>
							</FooterTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Context="data" TextAlign="TextAlign.Center" Width="150px">
							<Template Context="data">
								<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@((args) => arGrid.EditRow(data))" />
								<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@((args) => OnRemoveRow(data))" />
							</Template>
							<EditTemplate Context="data">
								<RadzenButton Icon="save" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@((args) => arGrid.UpdateRow(data))" />
								<RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@((args) => arGrid.CancelEditRow(data))" />
							</EditTemplate>
						</RadzenDataGridColumn>
					</Columns>
				</RadzenDataGrid>
				<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mt-2 rz-mb-2" JustifyContent="JustifyContent.Center">
					<RadzenButton Text="Add Invoice no." Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Shade="Shade.Lighter"
								   Click="@(args => AddInvoiceRow())" Style="min-width:140px" Size="ButtonSize.Medium" />

					<RadzenButton Text="Add Adjustment Reason" Icon="add_circle" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Shade="Shade.Lighter"
								   Click="@(args => AddAdjustmentReasonRow())" Style="min-width:200px" Size="ButtonSize.Medium" />
				</RadzenStack>
		</div>

		</RadzenColumn>
	</RadzenRow>

	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter] public IList<APAROffsetAPRowDto> APAdjustments { get; set; }
	[Parameter] public IList<APAROffsetARRowDto> ARAdjustments { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();
	private IEnumerable<string> reasonCodes { get; set; }

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<APAROffsetAPRowDto> apGrid;
	private RadzenDataGrid<APAROffsetARRowDto> arGrid;
	private RequestAuditDto requestAudit;

	private bool isOnSearch;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		APAdjustments = new List<APAROffsetAPRowDto>();
		ARAdjustments = new List<APAROffsetARRowDto>();
		searchedInvoiceNumber = new InvoiceDetailsDto(); 
		requestAudit = new RequestAuditDto();

		reasonCodes = await SearchOptionService.GetReasonCodes();
		requestAudit.Requestor = await AuthService.GetLastFirstName();
	}

	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		await DialogService.OpenAsync<AddAPAROffsetting>(
			"Confirm Invoice Number",
			new Dictionary<string, object>()
			{
				{ "Rows", APAdjustments },
				{ "Grid", apGrid },
				{ "InvoiceDetails", invoiceDetails }
			},
			new DialogOptions() { Width = "800px", Height = "auto" }
		);
	}

	public async Task OpenEdit(APAROffsetAPRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditARInvoiceOffsetting>(
				"Edit Cash Discount Adjustment",
				new Dictionary<string, object>()
				{
				{ "Rows", APAdjustments },
				{ "Grid", apGrid },
				{ "Data", data }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(!ARAdjustments.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			var apTotal = APAdjustments.Sum(a => a.InvoiceAmount);
			var arTotal = ARAdjustments.Sum(a => a.Amount);

			Guards.ThrowInvalidOperationIf((apTotal != arTotal), "AP and AR amounts must balance.");

			await DialogService.OpenAsync<APAROffsetModalSummary>(
				"Submit AP AR Offsetting",
				new Dictionary<string, object>()
				{
					{ "APAdjustments", APAdjustments },
					{ "ARAdjustments", ARAdjustments },
					{ "Notes", Notes },
					{ "RequestAudit", requestAudit },
					// { "ReferenceNumber", "07.01.2025-001" },
					{ "OnSubmit", SubmitRequest },
					{ "SuccessSubmissionRoute", "/requests/apar-offset" },
				},
				new DialogOptions() { Width = "1500px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		await APAROffsetService.Create(APAdjustments, ARAdjustments, Notes);
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

	private async Task AddInvoiceRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			RowType = ARRowType.Invoice,
			InvoiceNumber = string.Empty,
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		await arGrid.Reload();
		await arGrid.EditRow(newRow);
	}

	private async Task AddAdjustmentReasonRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			RowType = ARRowType.Adjustment,
			AdjustmentReason = reasonCodes.FirstOrDefault(),
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		await arGrid.Reload();
		await arGrid.EditRow(newRow);
	}

	private async Task OnRemoveRow(APAROffsetARRowDto item)
	{
		ARAdjustments.Remove(item);
		await arGrid.Reload();
	}
}
