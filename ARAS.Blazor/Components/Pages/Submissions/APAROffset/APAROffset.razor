@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables;
@using Microsoft.AspNetCore.Authorization

@page "/submissions/apar-offset"

@attribute [Authorize]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IAPAROffsetService APAROffsetService

<h3>AP AR : Offset</h3>

<RequestDataTable ViewRoute="submissions/apar-offset" UpdateRoute="declines/apar-offset" SelectButtonTitle="View" OnDateLoad="@(OnDataLoad)" />

@code {

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	private async Task<IEnumerable<TransactionRequestRowDto>> OnDataLoad()
	{
		return await APAROffsetService.GetSubmissions();
	}
}
