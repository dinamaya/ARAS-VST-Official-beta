@using ARAS.Blazor.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Components.Shared
@using System.Globalization

@page "/"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject ITokenService TokenService
@inject ITransactionService TransactionService
@inject IAuthService AuthService
@inject IRequestService RequestService

@inherits ComponentBase

<RadzenStack>
    <RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
        <div class="card card-body blur shadow-blur mx-4 mt-4 overflow-hidden">
            <div class="row gx-4">
                <div class="col-auto">
                    <div class="avatar avatar-xl position-relative">
                        <img src="@profileImageUrl" alt="profile_image" class="w-100 border-radius-lg shadow-sm" onerror="this.onerror=null;this.src='/img/avatar.png';">
                    </div>
                </div>
                <div class="col-auto my-auto">
                    <div class="h-100">
                        <h5 class="mb-1">
                            @(accountDetails?.FullName ?? "User")
                        </h5>
                        <p class="mb-0 font-weight-bold text-sm">
                            @(accountDetails?.AccountRole ?? "Role")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </RadzenStack>

    <RadzenStack>
        <div class="row mx-4">
            <div class="col-xl-2 col-sm-6 mb-xl-0 mb-4">
                <div class="card">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="text-sm mb-0 text-capitalize font-weight-bold">For CNC Approval</p>
                                    <h5 class="font-weight-bolder mb-0">
                                        @pendingCount
                                    </h5>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
                                    <div>
                                        <i class="ni ni-active-40 text-lg opacity-10" aria-hidden="true"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-sm-6 mb-xl-0 mb-4">
                <div class="card">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="text-sm mb-0 text-capitalize font-weight-bold">For ERP Posting</p>
                                    <h5 class="font-weight-bolder mb-0">
                                        @approvedCount
                                    </h5>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
                                    <i class="ni ni-like-2 text-lg opacity-10" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-sm-6 mb-xl-0 mb-4">
                <div class="card">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="text-sm mb-0 text-capitalize font-weight-bold">Declined</p>
                                    <h5 class="font-weight-bolder mb-0">
                                        @declinedCount
                                    </h5>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
                                    <i class="ni ni-bold-down text-lg opacity-10" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-sm-6 mb-xl-0 mb-4">
                <div class="card">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="text-sm mb-0 text-capitalize font-weight-bold">FSG Review</p>
                                    <h5 class="font-weight-bolder mb-0">
                                        @resubmittedCount
                                    </h5>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
                                    <i class="ni ni-user-run text-lg opacity-10" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-sm-6 mb-xl-0 mb-4">
                <div class="card">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="text-sm mb-0 text-capitalize font-weight-bold">Posted</p>
                                    <h5 class="font-weight-bolder mb-0">
                                        @postedCount
                                    </h5>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
                                    <i class="ni ni-check-bold text-lg opacity-10" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-sm-6">
                <div class="card">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-8">
                                <div class="numbers">
                                    <p class="text-sm mb-0 text-capitalize font-weight-bold">Rejected</p>
                                    <h5 class="font-weight-bolder mb-0">
                                        @rejectedCount
                                    </h5>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
                                    <i class="ni ni-fat-remove text-lg opacity-10" aria-hidden="true"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </RadzenStack>

    <RadzenStack>
        <div class="row mx-4">
            <div class="col-sm-6">
                <div class="card h-100">
                    <div class="card-header pb-0 p-3">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="mb-0">Latest Transactions</h6>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <ul class="list-group">
                            @if (latestTransactions != null && latestTransactions.Any())
                            {
                                @for (int i = 0; i < latestTransactions.Count; i++)
                                {
                                    var item = latestTransactions[i];
                                    var isLast = i == latestTransactions.Count - 1;

                                    <li class="list-group-item border-0 justify-content-between ps-0 @(isLast ? "mb-2" : "pb-0") border-radius-lg">
                                        <div class="d-flex">
                                            <div class="d-flex align-items-center">
                                                <div class="d-flex flex-column">
                                                    <h6 class="mb-1 text-dark text-sm">@item.Activity <b>@item.Status</b></h6>
                                                    <span class="text-xs">
                                                        @if (IsActionStatus(item.Status))
                                                        {
                                                            @:By @item.Creator
                                                        }
                                                        on @item.DateCreated
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center text-muted text-sm font-weight-bold ms-auto">
                                                # @item.RequestNumber
                                            </div>
                                        </div>
                                        @if (!isLast)
                                        {
                                            <hr class="horizontal dark mt-3 mb-2" />
                                        }
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item border-0 ps-0">
                                    <span class="text-sm">No recent transactions found.</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-md-0 mt-4">
                <div class="card z-index-2">
                    <div class="card-header p-3 pb-0">
                        <h6>Total Requests</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="chart">
                            <RadzenChart SeriesClick=@OnSeriesClick style="height: 400px">
                                <RadzenBarSeries Data="@requestCount" CategoryProperty="Request" Title="Type" LineType="LineType.Dashed" ValueProperty="Count" Fill="#344767" Stroke="#344767">
                                    <RadzenSeriesDataLabels Visible="@showDataLabels" />
                                </RadzenBarSeries>
                                <RadzenValueAxis Formatter="@(value => ((double)value).ToString("0", CultureInfo.InvariantCulture))">
                                    <RadzenGridLines Visible="true" />
                                    <RadzenAxisTitle Text="Total Count" />
                                </RadzenValueAxis>
                                <RadzenBarOptions Radius="5" />
                            </RadzenChart>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </RadzenStack>
</RadzenStack>

@code {
    AccountDetailsDto accountDetails = new();
    private List<TransactionHistoryDto> latestTransactions;
    private int pendingCount = 0;
    private int approvedCount = 0;
    private int declinedCount = 0;
    private int resubmittedCount = 0;
    private int postedCount = 0;
    private int rejectedCount = 0;
    private string profileImageUrl = "/img/avatar.png";
    //EventConsole console;
    bool showDataLabels = false;

    protected override async Task OnInitializedAsync()
    {
        accountDetails = await AuthService.GetAccountDetails();
        profileImageUrl = $"/api/auth/aad/photo?v={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";

            var result = await TransactionService.GetLatestTransactions();
            latestTransactions = result?.ToList() ?? new List<TransactionHistoryDto>();
            pendingCount = await RequestService.GetPendingRequestCount();
            approvedCount = await RequestService.GetApprovedRequestCount();
            declinedCount = await RequestService.GetDeclinedRequestCount();
            resubmittedCount = await RequestService.GetResubmittedRequestCount();
            postedCount = await RequestService.GetPostedRequestCount();
            rejectedCount = await RequestService.GetRejectedRequestCount();
        
        await base.OnInitializedAsync();
    }

    void OnSeriesClick(SeriesClickEventArgs args)
    {
        // console.Log(args);
    }

    class DataItem
    {
        public string Request { get; set; }
        public double Count { get; set; }
    }

    string FormatAsUSD(object value)
    {
        return ((double)value).ToString("C0", CultureInfo.CreateSpecificCulture("en-US"));
    }

    DataItem[] requestCount = new DataItem[] {
    new DataItem
    {
    Request = "Cash Discount",
    Count = 12
    },
    new DataItem
    {
    Request = "Write-Off",
    Count = 31
    },
    new DataItem
    {
    Request = "Bank Charge",
    Count = 6
    },
    new DataItem
    {
    Request = "APAR",
    Count = 19
    },
    new DataItem
    {
    Request = "AR Invoice",
    Count = 22
    },
    };

    private bool IsActionStatus(string status)
    {
        return status == "Approved" || status == "For ERP Posting" || status == "For FSG Validation" || status == "For FSG Approval" || status == "Rejected" || status == "Declined";
    }
}