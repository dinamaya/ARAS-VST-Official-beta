@page "/requests/small-amount"
@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Requestor")]
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject ITestService TestService
@inject ISmallAmountService Service

<BaseAdjustmentRequestCreate
	TRow="@SmallAmountRowDto"
	TCreate="@AdjustmentCreateDto"
	Title="Small Amount"
	RequestRoute="small-amount"
	CreateStatusRepository="Service"
	AdjustmentReaderRepository="Service"
	TestCallBack="(rows, reasons, activity) => TestService.GenerateAdjustmentRows(rows, reasons, activity)"
	OnOpenAdd="OpenAdd"
	OnOpenEdit="OpenEdit"
	/>

@code 
{
	public async Task OpenAdd(
		IList<SmallAmountRowDto> rows,
		IEnumerable<string> reasonCodes,
		RadzenDataGrid<SmallAmountRowDto> dataGrid,
		string adjustmentActivity,
		InvoiceDetailsDto invoiceDetails)
	{
		await ModalTemplates.Add.SmallAmount(
			DialogService,
			rows,
			reasonCodes,
			dataGrid,
			invoiceDetails,
			adjustmentActivity
		);
	}

	public async Task OpenEdit(
		IList<SmallAmountRowDto> rows,
		IEnumerable<string> reasonCodes,
		SmallAmountRowDto data,
		RadzenDataGrid<SmallAmountRowDto> dataGrid
	)
	{
		await ModalTemplates.Edit<SmallAmountRowDto>.Adjustment(
			DialogService,
			"Small Amount",
			data,
			rows,
			reasonCodes,
			dataGrid,
			null
		);
	}
}
