@page "/submissions/sr-auto-net/{RequestId:long}"
@using ARAS.Blazor.Models.DTOs
@using Microsoft.AspNetCore.Authorization
@using ARAS.Blazor.Components.Shared.Summaries

@attribute [Authorize]
@inject ISRAutoNetService Service

<ViewRequestAdjustment RequestId="RequestId" AdjustmentReaderService="Service" Title="Write Off: Sales Return Auto Net of CWT">
