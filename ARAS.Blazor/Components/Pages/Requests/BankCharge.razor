@page "/requests/bank-charge"
@attribute [Authorize(Roles = "Requestor")]

@using ARAS.Blazor.Models.DTOs
@using Microsoft.AspNetCore.Authorization

@inject DialogService DialogService
@inject IBankChargeService IService
@inject ITestService TestService

<BaseAdjustmentRequestCreate
	TRow="@BankChargeRowDto"
	TCreate="@AdjustmentCreateDto"
	Title="Bank Charge"
	RequestRoute="bank-charge"
	CreateStatusRepository="IService"
	TestCallBack="(rows, reasons) => TestService.GenerateAdjustmentRows(rows, reasons)"
	OnOpenAdd="OpenAdd"
	OnOpenEdit="OpenEdit"
	/>

@code 
{
	public async Task OpenAdd(
		IList<BankChargeRowDto> rows,
		IEnumerable<string> reasonCodes,
		RadzenDataGrid<BankChargeRowDto> dataGrid,
		InvoiceDetailsDto invoiceDetails)
	{
		await ModalTemplates.Add.BankCharge(
			DialogService,
			rows,
			reasonCodes,
			dataGrid,
			invoiceDetails
		);
	}

	public async Task OpenEdit(
		IList<BankChargeRowDto> rows,
		IEnumerable<string> reasonCodes,
		BankChargeRowDto data,
		RadzenDataGrid<BankChargeRowDto> dataGrid
	)
	{
		await ModalTemplates.Edit<BankChargeRowDto>.Adjustment(
			DialogService,
			"Bank Charge",
			data,
			rows,
			reasonCodes,
			dataGrid,
			null
		);
	}
}
