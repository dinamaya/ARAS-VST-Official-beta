@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Repositories.Interfaces
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject ISearchOptionService SearchOptionService
@typeparam TCreate where TCreate : class
@typeparam TRow where TRow : AdjustmentRow

<h2>@Title Adjustment</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />

	<RadzenRow>
		<AdjustmentDataTable 
			Title="@($"{Title} Adjustments")" 
			Adjustments="adjustments" 
			@ref="adjustmentGrid" 
			OpenEdit="OpenEdit" />
	</RadzenRow>

	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>



@code {
	[Parameter] public string Title { get; set; }
	[Parameter] public string RequestRoute { get; set; }
	[Parameter] public ICreateStatusRepository<TRow> CreateStatusRepository { get; set; }
	[Parameter] public Func<IList<TRow>, IEnumerable<string>, Task> TestCallBack { get; set; }
	[Parameter] public Func<IList<TRow>, IEnumerable<string>, InvoiceDetailsDto, Task> OnOpenAdd { get; set; }
	[Parameter] public Func<IList<TRow>, IEnumerable<string>, TRow, RadzenDataGrid<TRow>, Task> OnOpenEdit { get; set; }

	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();
	private IEnumerable<string> reasonCodes { get; set; }
	private IList<TRow> adjustments { get; set; }

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RequestAuditDto requestAudit;
	private AdjustmentDataTable<TRow> adjustmentGrid;

	private bool isOnSearch;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		adjustments = new List<TRow>();
		searchedInvoiceNumber = new InvoiceDetailsDto();
		requestAudit = new RequestAuditDto();

		reasonCodes = await SearchOptionService.GetReasonCodes();
		requestAudit.Requestor = await AuthService.GetLastFirstName();

		await TestCallBack.Invoke(adjustments, reasonCodes);
		await adjustmentGrid.Reload();
	}

	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		try
		{
			await OnOpenAdd.Invoke(adjustments, reasonCodes,invoiceDetails);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Add Adjustment Failed");
		}
	}

	public async Task OpenEdit(TRow data)
	{
		try
		{
			await OnOpenEdit.Invoke(adjustments, reasonCodes, data, adjustmentGrid.DataGrid);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(!adjustments.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			await ModalTemplates.Summary.Adjustment(DialogService, Title, adjustments, requestAudit, $"requests/{RequestRoute}", SubmitRequest);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest() => await CreateStatusRepository.Create(adjustments, Notes);
	private void HandleSearchChanged(bool value) => isOnSearch = value;
	private void HandleLoadingChanged(bool value) => isLoading = value;
}
