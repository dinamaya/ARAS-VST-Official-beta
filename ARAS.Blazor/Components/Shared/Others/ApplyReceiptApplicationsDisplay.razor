@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Models.DTOs

<RadzenFieldset Text="Apply Receipt (to Invoice)" AllowCollapse="true" Collapsed="false" class="mt-3">
	<RadzenDataGrid Data="@Applications" TItem="ReceiptInvoiceApplicationPostingDto" AllowPaging="false" AllowSorting="false" AllowFiltering="false" class="w-100">
		<Columns>
			<RadzenDataGridColumn TItem="ReceiptInvoiceApplicationPostingDto" Property="InvoiceNumber" Title="Invoice Number" />
			<RadzenDataGridColumn TItem="ReceiptInvoiceApplicationPostingDto" Property="AmountDue" Title="Amount Due">
				<Template Context="application">@application.AmountDue.ToPhp()</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ReceiptInvoiceApplicationPostingDto" Property="AppliedAmount" Title="Applied Amount">
				<Template Context="application">@application.AppliedAmount.ToPhp()</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ReceiptInvoiceApplicationPostingDto" Property="DiscountAmount" Title="Discount">
				<Template Context="application">@(application.DiscountAmount.HasValue ? application.DiscountAmount.Value.ToPhp() : "—")</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ReceiptInvoiceApplicationPostingDto" Property="CurrencyCode" Title="Currency" />
		</Columns>
	</RadzenDataGrid>
</RadzenFieldset>

@code {
	[Parameter] public IList<ReceiptInvoiceApplicationPostingDto> Applications { get; set; } = [];
}
