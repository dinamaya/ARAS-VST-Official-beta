@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.Complex
@typeparam TRow where TRow : AdjustmentRow

@inherits AdjustmentBaseComponent<TRow>
@inject DialogService DialogService

<RadzenStack Orientation="Orientation.Vertical" Style="height: 100%;" Gap="1.6em">
	<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
		<InvoiceSummary InvoiceDetails="InvoiceDetails"/>
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenRow>
			<RadzenLabel Style="width: 100%;" Text="Reason Codes" />
		</RadzenRow>
		<RadzenRow>
			<RadzenDropDown @bind-Value=@reasonCode Data=@ReasonCodes Style="width: 100%;" Name="Reason Codes" />
		</RadzenRow>
		<ComponentValidator ValidationName="Reason Code" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Adjustment Amount" Variant="Variant.Outlined">
			<RadzenNumeric @bind-Value="@adjustmentAmount" Max="(decimal) InvoiceDetails.InvoiceAmount" />
		</RadzenFormField>
		<ComponentValidator ValidationName="AdjustmentAmount" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Remarks" Variant="@Variant.Outlined" Max>
			<RadzenTextArea @bind-Value="@remarks" Rows="4" />
		</RadzenFormField>
		<ComponentValidator ValidationName="Remarks" />
	</RadzenStack>

	<RadzenStack Visible="true" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
		<button @onclick="@((args) => DialogService.Close(true))" class="btn btn-danger">
			Close
		</button>
		<button @onclick="OnAdd" class="btn btn-primary">
			Add
		</button>
	</RadzenStack>
</RadzenStack>

@code {
	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		reasonCode = ReasonCodes.FirstOrDefault();
	}

	protected async Task OnAdd()
	{
		try
		{
			double parsedAmount;
			Guards.ThrowInvalidOperationIf(string.IsNullOrEmpty(adjustmentAmount), "The provided adjustment amount is empty. Please provide a valid and not greater than the current Invoice Amount");

			bool isInvoiceExist = Rows.Any(i => i.InvoiceNumber == InvoiceDetails.InvoiceNumber);
			Guards.ThrowInvalidOperationIf(isInvoiceExist, $"Invoice Number {InvoiceDetails.InvoiceNumber} has been added in the " + Title + " adjustment table");

			bool isAdjustmentAmountValid = double.TryParse(adjustmentAmount, out parsedAmount);
			Guards.ThrowInvalidOperationIf(!isAdjustmentAmountValid, $"The provided Invoice Amount contains unwanted characters. Please check the Invoice Amount or contact the administrator for help.");
			
			TRow row = OnAdjustmentRowCreate?.Invoke(parsedAmount, remarks, reasonCode, InvoiceDetails);
			await base.OnAdd(DialogService, row);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(Exceptions.GetMessage(ex), "Add Adjustment Failed");
		}
	}
}
