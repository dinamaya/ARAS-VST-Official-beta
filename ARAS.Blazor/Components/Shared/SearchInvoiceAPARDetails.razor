@using ARAS.Blazor.Components.Shared
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Models.DTOs

@inject IInvoiceService InvoiceService
@inject IConfigService ConfigService
@inject DialogService DialogService
@inherits ComponentBase

<MainSearchBar OnSearch="HandleSearch" TextFields="textFields">
	<ResultTemplate Context="isLoading">
		<SearchInvoiceDataTable ButtonSelectIcon="add" ButtonSelectText="Add to List" IsLoading="isLoading" InvoiceRows="results" Select="OnSelectChanged" />
	</ResultTemplate>
	<OptionsTemplate>
		<RadzenSelectBar class="mt-2" @bind-Value="selectedSource" TValue="string">
			<Items>
				<RadzenSelectBarItem Text="AP" Value="@("AP")" />
				<RadzenSelectBarItem Text="AR" Value="@("AR")" />
			</Items>
		</RadzenSelectBar>
	</OptionsTemplate>
</MainSearchBar>

@code {
	[Parameter] public EventCallback<InvoiceDetailsDto> OnAPAdd { get; set; }
	[Parameter] public EventCallback<InvoiceDetailsDto> OnARAdd { get; set; }
	private IEnumerable<InvoiceDetailsDto> results { get; set; }

	private IEnumerable<string> textFields { get; set; }
	private string selectedSource = "AP"; // Default to AP

	protected override async Task OnInitializedAsync()
	{
		textFields = ConfigService.GetRequstorSearchInvoiceCategories();
	}

	private async Task HandleSearch(SearchRequestDto request)
	{
		results = await InvoiceService.GetDetailsList(request);
		if (selectedSource == "AR")
			results = await InvoiceService.GetDetailsList(request);
		else
			results = await InvoiceService.GetAPDetailsList(request);
	}

	protected async Task OnSelectChanged(InvoiceDetailsDto invoiceDetails)
	{
		if (invoiceDetails.DataSource == "AR")
			await OnARAdd.InvokeAsync(invoiceDetails);
		else
			await OnAPAdd.InvokeAsync(invoiceDetails);
	}
}