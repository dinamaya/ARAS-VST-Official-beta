@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.Skeletons

@inject IInvoiceService InvoiceService
@inject DialogService DialogService
@inherits ComponentBase

<RadzenRow AlignItems="AlignItems.Start"
			JustifyContent="JustifyContent.Start"
			class="w-100"
			Gap="1rem">
	<RadzenColumn Size="12"
					SizeLG="8"
					SizeMD="7"
					SizeXL="10">
		<RadzenFormField class="w-100 border-0" Text="Invoice Number" Variant="Variant.Outlined">
			<RadzenTextBox @bind-Value="@searchInvoiceNo" />
		</RadzenFormField>
	</RadzenColumn>
	<RadzenColumn Size="12"
					SizeMD="5"
					SizeLG="4"
					SizeXL="2">
		<RadzenContent>
			<SubmitButton Title="Search" ButtonClass="w-100 mt-2" Click="OnSearch" DisabledTitle="Searching" />
		</RadzenContent>
	</RadzenColumn>
</RadzenRow>

<RadzenRow>
	<h3>Searched CN Details</h3>
</RadzenRow>
<RadzenRow class="mt-2">
	@if (isLoading)
	{
		<div class="w-100">
			<DatatableSkeleton RowCount="2" ColumnCount="6" />
		</div>
	}
	else
	{
		<RadzenDataGrid @ref=dataGrid
						AllowColumnResize="true"
						AllowAlternatingRows="false"
						AllowSorting="true"
						PageSize="20"
						AllowPaging="true"
						PagerHorizontalAlign="HorizontalAlign.Left"
						ShowPagingSummary="true"
						Data="@list"
						SelectionMode="DataGridSelectionMode.Single">
			<Columns>
				<RadzenDataGridColumn Frozen="true" Title="Option" Sortable="false" Filterable="false" Width="160px" TextAlign="TextAlign.Center">
					<Template Context="data">
						<RadzenButton Icon="add" Text="Add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="(args) => OnAddEvent(data)" />
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn Visible=false Property="@nameof(SearchCNDetailsRowDto.Id)" Title="Id" />
				<RadzenDataGridColumn Visible=false Property="@nameof(SearchCNDetailsRowDto.CNRef)" Title="CN Ref" />
				<RadzenDataGridColumn Property="@nameof(SearchCNDetailsRowDto.CNAmt)" Title="CN Amount">
					<Template Context="data">
						@data.CNAmt.ToPhp()
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn Property="@nameof(SearchCNDetailsRowDto.WT)" Title="CN WT">
					<Template Context="data">
						@data.WT.ToPhp()
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn Property="@nameof(SearchCNDetailsRowDto.InvoiceDate)" Title="Invoice Date" />
				<RadzenDataGridColumn Property="@nameof(SearchCNDetailsRowDto.CustomerName)" Title="Customer Name" />
				<RadzenDataGridColumn Property="@nameof(SearchCNDetailsRowDto.CustomerNumber)" Title="Customer Number" />
			</Columns>
		</RadzenDataGrid>
	}
</RadzenRow>
@code {
	[Parameter] public EventCallback<SearchCNDetailsRowDto> OnAdd { get; set; }
	[Parameter] public EventCallback<bool> OnSearchChanged { get; set; }
	[Parameter] public EventCallback<bool> OnLoadingChanged { get; set; }

	private IEnumerable<SearchCNDetailsRowDto> list { get; set; }
	private bool isOnSearch { get; set; }
	private bool isLoading { get; set; }
	private string searchInvoiceNo = "";
	private RadzenDataGrid<SearchCNDetailsRowDto> dataGrid;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
	}

	public async Task OnSearch()
	{
		await Task.Delay(10);
		try
		{
			Guards.ThrowInvalidOperationIf(searchInvoiceNo.Length < 3, "Please provided 3 or more character in the search invoice number field");

			if (isLoading)
			{
				await DialogService.Alert("Please wait until the current search operation is complete");
				return;
			}

			await SetIsOnSearch(true);
			await SetIsLoading(true);
			list = [];
			await dataGrid.Reload();

			// list = await InvoiceService.GetSRAutoNetCNDetails(searchInvoiceNo);

			await dataGrid.Reload();
		}
		catch (Exception ex)
		{
			await SetIsOnSearch(false);
			await DialogService.Alert(ex.Message, "Search Invoice Number Details failed");
		}
		await SetIsLoading(false);
	}


	private async Task SetIsOnSearch(bool value)
	{
		isOnSearch = value;
		await OnSearchChanged.InvokeAsync(value);
	}

	private async Task SetIsLoading(bool value)
	{
		isLoading = value;
		await OnLoadingChanged.InvokeAsync(value);
	}

	private async Task OnAddEvent(SearchCNDetailsRowDto selectedRow)
	{
		await OnAdd.InvokeAsync(selectedRow);
	}
}