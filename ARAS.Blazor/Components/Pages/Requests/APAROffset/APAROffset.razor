@page "/requests/invoice/apar-offset"

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting
@using ARAS.Blazor.Components.Pages.Requests.APAROffset.Modal
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Components.Shared.Others
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject DialogService DialogService

@attribute [Authorize(Roles = "Requestor")]
@inherits ComponentBase
@inject NavigationManager NavigationManager
@inject IQueryService QueryService
@inject IAuthService AuthService
@inject ISearchOptionService SearchOptionService
@inject IAPAROffsetService APAROffsetService
@inject IJSRuntime JS


<h2>AP AR : Offset</h2>
<FusionPostingOverlay @ref="submitOverlay" RunningChanged="@(value => isSubmitting = value)" />

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	@if (Utils.Equals(QueryAction, Queries.Success.CREATE))
	{
		<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
			Invoice Adjustment created successfully
		</RadzenAlert>
	}

	<SearchInvoiceAPARDetails OnAPAdd="AddAP"
                          OnARAdd="AddAR"
							  IgnoreInitialQueryReplay="true"
							  ManualSearchTriggerOnly="true"
                          PlaceSearchButtonBelowDate="true"
                          AlignSearchFields="true" />
	@code { [Parameter, SupplyParameterFromQuery(Name = "q")] public string? QueryAction { get; set; } }
	<RadzenRow id="apar-offset-groups" Gap="1.5rem">
		<RadzenColumn Size="5">
			<div class="text-center pb-3">
				<h3 class="pb-0 mb-0">AP GROUP</h3>
			</div>
			<div class="py-4 px-3 w-100 card">
				<RadzenDataGrid @ref="apGrid"
								AllowFiltering="false"
								AllowColumnResize="true"
								AllowAlternatingRows="false"
								AllowSorting="true"
								PageSize="20"
								AllowPaging="true"
								PagerHorizontalAlign="HorizontalAlign.Left"
								ShowPagingSummary="true"
								Data="@APAdjustments"
								LogicalFilterOperator="LogicalFilterOperator.Or"
								SelectionMode="DataGridSelectionMode.Single">
					<Columns>
						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceNumber)" Title="Invoice No.">
							<FooterTemplate>
								<b>Total Amount:</b>
							</FooterTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.CustomerName)" Title="Customer Name">
							<Template Context="data">
								@((string.IsNullOrWhiteSpace(data.CustomerName) ? data.CustomerNumber : data.CustomerName))
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn Property="@nameof(APAROffsetAPRowDto.InvoiceAmount)" Title="Amount">
							<Template Context="data">
								@data.InvoiceAmount.ToPhp()
							</Template>
							<FooterTemplate>
								<b>@APAdjustments?.Sum(a => a.InvoiceAmount).ToPhp()</b>
							</FooterTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetAPRowDto" Context="data" TextAlign="TextAlign.Right">
							<Template Context="data">
								<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@((args) => OnRemoveAPRow(data))" />
							</Template>
						</RadzenDataGridColumn>

					</Columns>
				</RadzenDataGrid>
			</div>
		</RadzenColumn>
		<RadzenColumn Size="7">
			<div class="text-center pb-3">
				<h3 class="pb-0 mb-0">AR GROUP</h3>
			</div>

			<div class="py-4 px-3 w-100 card">
				<RadzenDataGrid TItem="APAROffsetARRowDto"
								@ref="arGrid"
								Data="@ARAdjustments"
								AllowFiltering="false"
								AllowColumnResize="true"
								AllowPaging="false"
								AllowSorting="false"
								EditMode="DataGridEditMode.Single"
								ShowPagingSummary="false"
								RowUpdate="@OnARRowUpdate">

					<Columns>
						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Title="Invoice No.">
							<Template Context="data">
								@data.InvoiceNumber
							</Template>

							<FooterTemplate>
								<div><b>Total Amount:</b></div>
								<div class="mt-1"><b class="text-danger">Net Balance to Offset:</b></div>
							</FooterTemplate>

							<EditTemplate Context="data">
								<div>@data.InvoiceNumber</div>
							</EditTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Title="Customer Name">
							<Template Context="data">
								@(string.IsNullOrWhiteSpace(data.CustomerName) ? data.CustomerNumber : data.CustomerName)
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Property="Amount" Title="Invoice Amount">
							<Template Context="data">
								@data.InvoiceAmount.ToPhp()
							</Template>

							<EditTemplate Context="data">
								<div style="position: relative; z-index: 1;">
									<RadzenNumeric @bind-Value="data.Amount" Name="@($"Amount_{data.Id}")" Style="width:100%" Step="0.01" />
								</div>
								<RadzenRequiredValidator Component="@($"Amount_{data.Id}")" Text="Amount is required" Popup=true Style="z-index: 9999 !important; position: absolute; margin-top:30px" />
							</EditTemplate>
						</RadzenDataGridColumn>


						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Property="Amount" Title="Balance Amount">
							<Template Context="data">
								@data.Amount.ToPhp()
							</Template>
							<EditTemplate Context="data">
								<div style="position: relative; z-index: 1;">
									<RadzenNumeric @bind-Value="data.Amount" Name="@($"Amount_{data.Id}")" Style="width:100%" Step="0.01" />
								</div>

								<RadzenRequiredValidator Component="@($"Amount_{data.Id}")"
														 Text="Amount is required"
														 Popup=true Style="z-index: 9999 !important; position: absolute; margin-top:30px" />

							</EditTemplate>

							<FooterTemplate>
								<div><b>@ARAdjustments.Sum(a => a.Amount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b></div>
								<div class="mt-1"><b class="text-danger">@NetBalance.ToPhp()</b></div>
							</FooterTemplate>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="APAROffsetARRowDto" Context="data" TextAlign="TextAlign.Right">
							<Template Context="data">
								<RadzenStack Gap="0.6em" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">
									<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@((args) => arGrid.EditRow(data))" />
									<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@((args) => OnRemoveRow(data))" />
								</RadzenStack>
							</Template>
							<EditTemplate Context="data">
								<RadzenStack Gap="0.6em" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right">
									<RadzenButton Icon="save" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@((args) => arGrid.UpdateRow(data))" />
									<RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@((args) => CancelEditRow(data))" />
								</RadzenStack>
							</EditTemplate>
						</RadzenDataGridColumn>
					</Columns>
				</RadzenDataGrid>
			</div>

		</RadzenColumn>
	</RadzenRow>

	@if (RequiresWriteOff)
	{
		<div class="card p-3">
			<RadzenRow Gap="1rem" AlignItems="AlignItems.Center" class="mb-2">
				<RadzenColumn Size="12" SizeMD="8">
					<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
						<RadzenLabel Text="WRITE-OFF TRANSACTION" class="fw-bold" />
						<span class="badge bg-warning text-dark">Required</span>
					</RadzenStack>
					<div class="text-sm text-muted">Required because there is a remaining difference to reconcile.</div>
				</RadzenColumn>
				<RadzenColumn Size="12" SizeMD="4" class="text-md-end">
					<span class="badge bg-light text-dark">Transaction 2 · Write-off</span>
				</RadzenColumn>
			</RadzenRow>

			<RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
				<RadzenColumn Size="12" SizeMD="4">
					<RadzenLabel Text="Write-off Amount" />
					<RadzenNumeric TValue="double" @bind-Value="WriteOffAmount" Style="width:100%" Step="0.01" Min="0" Change="@(args => OnWriteOffAmountChanged())" />
				</RadzenColumn>
				<RadzenColumn Size="12" SizeMD="4">
					<RadzenLabel Text="Write-off Reason" />
					<RadzenDropDown @bind-Value="WriteOffReason" Data="writeOffReasons" Style="width:100%" AllowClear="false" Placeholder="Select write-off reason" />
				</RadzenColumn>
				<RadzenColumn Size="12" SizeMD="4">
					<div class="d-flex align-items-center gap-2 px-3 py-2 border-radius-lg"
						 style="background: linear-gradient(180deg, #f6f9ff 0%, #edf3ff 100%); border: 1px solid #dbe8ff; color: #1f3b72; min-height: 56px;">
						<RadzenIcon Icon="info" Style="color:#1d5fd0; font-size: 1.2rem;" />
						<span class="fw-semibold text-sm">This will be submitted as a separate transaction in Oracle Fusion.</span>
					</div>
				</RadzenColumn>
			</RadzenRow>
		</div>
	}

	<div class="card p-3">
		<h4 class="mb-3">Reconciliation Summary</h4>
		<RadzenRow Gap="1rem">
			<RadzenColumn Size="12" SizeMD="3">
				<div class="border rounded p-2">
					<div class="text-sm">AP Total</div>
					<div class="fw-bold">@APGroupTotal.ToPhp()</div>
				</div>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="3">
				<div class="border rounded p-2">
					<div class="text-sm">AR Adjustment</div>
					<div class="fw-bold">@ARGroupTotal.ToPhp()</div>
				</div>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="3">
				<div class="border rounded p-2">
					<div class="text-sm">Write-off</div>
					<div class="fw-bold">@WriteOffAmount.ToPhp()</div>
				</div>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="3">
				<div class="border rounded p-2">
					<div class="text-sm">Remaining Difference</div>
					<div class="fw-bold @(HasBalancedTransactions ? "text-success" : "text-danger")">@RemainingDifference.ToPhp()</div>
				</div>
			</RadzenColumn>
		</RadzenRow>
	</div>

	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit" disabled="@isSubmitting">
				@SubmitButtonLabel
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter] public IList<APAROffsetAPRowDto> APAdjustments { get; set; }
	[Parameter] public IList<APAROffsetARRowDto> ARAdjustments { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();
	private FusionPostingOverlay submitOverlay = default!;
	private bool isSubmitting;

	private IEnumerable<string?> DescribeSubmission()
	{
		yield return $"AP group: {APAdjustments.Count} {(APAdjustments.Count == 1 ? "line" : "lines")} ({FusionPostingOverlay.FormatSummaryAmount(APGroupTotal)})";
		yield return $"AR group: {ARAdjustments.Count} {(ARAdjustments.Count == 1 ? "line" : "lines")} ({FusionPostingOverlay.FormatSummaryAmount(ARGroupTotal)})";
		if (RequiresWriteOff)
			yield return $"Write-off of {FusionPostingOverlay.FormatSummaryAmount(WriteOffAmount)}";
		yield return FusionPostingOverlay.DescribeAttachments(Notes);
	}
	private IEnumerable<string> writeOffReasons { get; set; } = [];

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<APAROffsetAPRowDto> apGrid;
	private RadzenDataGrid<APAROffsetARRowDto> arGrid;
	private RequestAuditDto requestAudit;

	private bool isOnSearch;
	private bool isLoading;
	private bool _scrollToOffsetGroups;
	private double WriteOffAmount;
	private string? WriteOffReason;
	private bool _writeOffAmountManuallyChanged;

	private double APGroupTotal => Math.Round(APAdjustments?.Sum(a => a.InvoiceAmount) ?? 0, 2);
	private double ARGroupTotal => Math.Round(ARAdjustments?.Sum(a => a.Amount) ?? 0, 2);
	private double NetBalance => Math.Round(ARGroupTotal - APGroupTotal, 2);
	private double SuggestedWriteOffAmount => Math.Round(Math.Abs(NetBalance), 2);
	private bool RequiresWriteOff => Math.Abs(NetBalance) > 0;
	private double RemainingDifference => Math.Round(ARGroupTotal - APGroupTotal - WriteOffAmount, 2);
	private bool HasBalancedTransactions => Math.Abs(RemainingDifference) < 0.01;
	private string SubmitButtonLabel => RequiresWriteOff ? "Submit 2 Transactions" : "Submit Adjustment";

	// track newly added rows so we can remove them on cancel if they remain empty
	private HashSet<string> newlyAddedRowIds = new();

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		APAdjustments = new List<APAROffsetAPRowDto>();
		ARAdjustments = new List<APAROffsetARRowDto>();
		searchedInvoiceNumber = new InvoiceDetailsDto();
		requestAudit = new RequestAuditDto();

		writeOffReasons = await SearchOptionService.GetReasonCodes();
		WriteOffReason = writeOffReasons.FirstOrDefault();
		requestAudit.Requestor = await AuthService.GetLastFirstName();

		await apGrid.Reload();
		await arGrid.Reload();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!_scrollToOffsetGroups)
			return;

		_scrollToOffsetGroups = false;
		await JS.InvokeVoidAsync("scrollToElement", "apar-offset-groups");
	}

	public async Task OpenEdit(APAROffsetAPRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditARInvoiceOffsetting>(
				"Edit Cash Discount Adjustment",
				new Dictionary<string, object>()
				{
				{ "Rows", APAdjustments },
				{ "Grid", apGrid },
				{ "Data", data }
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		if (isSubmitting)
			return;

		try
		{
			SyncWriteOffIfNeeded();

			Guards.ThrowInvalidOperationIf(!APAdjustments.Any(), "Can't submit request because AP Group has no rows");
			Guards.ThrowInvalidOperationIf(!ARAdjustments.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			var confirmMessage = RequiresWriteOff
				? "This request will submit 2 transactions (AP/AR Adjustment and Write-off). Continue?"
				: "Would you like to submit the AP/AR Adjustment transaction?";

			bool isConfirmed = await DialogService.Confirm(confirmMessage, "Create AP-AR Offset Request") ?? false;
			if (!isConfirmed)
				return;

			// row-level validation before opening modal
			if (!ValidateARRows(out var message))
			{
				await DialogService.Alert(message, "Validation Failed");
				return;
			}

			if (RequiresWriteOff)
			{
				Guards.ThrowInvalidOperationIf(WriteOffAmount <= 0, "Write-off amount must be greater than 0.00.");
				Guards.ThrowInvalidOperationIf(string.IsNullOrWhiteSpace(WriteOffReason), "Write-off reason is required.");
				Guards.ThrowInvalidOperationIf(!HasBalancedTransactions, "AP, AR and Write-off amounts must reconcile to 0.00 difference.");
			}
			else
			{
				Guards.ThrowInvalidOperationIf(Math.Abs(NetBalance) > 0.01, "AP and AR amounts must balance.");
			}

			await SubmitRequest();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		await submitOverlay.RunAsync(
			FusionPostingOverlay.SubmittingTitle,
			DescribeSubmission(),
			FusionPostingOverlay.SubmittingNote,
			() => APAROffsetService.Create(APAdjustments, ARAdjustments, Notes, GetWriteOffRow()));

		// Keep only the success flag so the search component does not replay the
		// previous query and repopulate results after a successful submission.
		var uri = $"{NavigationManager.Uri.Split('?')[0]}?q={Uri.EscapeDataString(Queries.Success.CREATE)}";
		NavigationManager.NavigateTo(uri, true);
	}

	protected async Task AddAR(InvoiceDetailsDto data){
		var result = await DialogService.OpenAsync<AddAPAROffsettingAR>(
			"Confirm AR Invoice Number",
            new Dictionary<string, object>()
            {
				{ "APRows", APAdjustments },
				{ "Rows", ARAdjustments },
                { "Grid", arGrid },
				{ "InvoiceDetails", data },
            },
			ModalTemplates.Variant.XSMALL
        );

		if (result is true)
		{
			SyncWriteOffIfNeeded();
			_scrollToOffsetGroups = true;
			StateHasChanged();
		}
	}

	protected async Task AddAP(InvoiceDetailsDto data){
		var result = await DialogService.OpenAsync<AddAPAROffsettingAP>(
			"Confirm AP Invoice Number",
			new Dictionary<string, object>()
			{
				{ "Rows", APAdjustments },
				{ "Grid", apGrid },
				{ "InvoiceDetails", data }
			},
			ModalTemplates.Variant.XSMALL
		);

		if (result is true)
		{
			SyncWriteOffIfNeeded();
			_scrollToOffsetGroups = true;
			StateHasChanged();
		}
	}
	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

	private async Task AddInvoiceRow()
	{
		var newRow = new APAROffsetARRowDto
		{
			Id = Guid.NewGuid().ToString(),
			RowType = ARRowType.Invoice,
			InvoiceNumber = string.Empty,
			Amount = 0.00d
		};

		ARAdjustments.Add(newRow);
		newlyAddedRowIds.Add(newRow.Id);
		await arGrid.Reload();
		await arGrid.EditRow(newRow);
		StateHasChanged();
	}

	private void OnARRowUpdate(APAROffsetARRowDto args)
	{
		SyncWriteOffIfNeeded();
		StateHasChanged();
	}

	private void OnAPRowUpdate(APAROffsetAPRowDto args)
	{
		SyncWriteOffIfNeeded();
		StateHasChanged();
	}

	private async Task AddAdjustmentReasonRow()
	{
		await Task.CompletedTask;
	}

	private async Task OnRemoveRow(APAROffsetARRowDto item)
	{
		ARAdjustments.Remove(item);
		newlyAddedRowIds.Remove(item?.Id);
		SyncWriteOffIfNeeded();
		await arGrid.Reload();
		StateHasChanged();
	}

	private async Task OnRemoveAPRow(APAROffsetAPRowDto item)
	{
		APAdjustments.Remove(item);
		SyncWriteOffIfNeeded();
		await apGrid.Reload();
		StateHasChanged();
	}

	private async Task CancelEditRow(APAROffsetARRowDto data)
	{
		arGrid.CancelEditRow(data);

		if (data != null && !string.IsNullOrEmpty(data.Id) && newlyAddedRowIds.Contains(data.Id))
		{
			if (IsRowEffectivelyEmpty(data))
			{
				ARAdjustments.Remove(data);
				newlyAddedRowIds.Remove(data.Id);
				await arGrid.Reload();
			}
			else
			{
				newlyAddedRowIds.Remove(data.Id);
			}
		}
		StateHasChanged();
	}

	private bool IsRowEffectivelyEmpty(APAROffsetARRowDto row)
	{
		if (row == null) return true;

		if (row.RowType == ARRowType.Invoice)
		{
			return string.IsNullOrWhiteSpace(row.InvoiceNumber) && (row.Amount == 0.0);
		}
		else
		{
			return string.IsNullOrWhiteSpace(row.AdjustmentReason) && (row.Amount == 0.0);
		}
	}

	private bool ValidateARRows(out string message)
	{
		message = string.Empty;

		if (ARAdjustments == null || !ARAdjustments.Any())
		{
			message = "AR Group has no rows.";
			return false;
		}

		foreach (var ar in ARAdjustments)
		{
			if (ar == null)
			{
				message = "AR Group contains an invalid row.";
				return false;
			}

			if (string.IsNullOrWhiteSpace(ar.InvoiceNumber))
			{
				message = "AR Group: Invoice number is required.";
				return false;
			}

			if (ar.Amount == 0.0)
			{
				var id = ar.InvoiceNumber;
				message = $"AR Group: Amount must not be 0.00 for '{id ?? "unknown"}'.";
				return false;
			}
		}

		return true;
	}

	private void OnWriteOffAmountChanged()
	{
		_writeOffAmountManuallyChanged = true;
	}

	private void SyncWriteOffIfNeeded()
	{
		if (!RequiresWriteOff)
		{
			WriteOffAmount = 0;
			WriteOffReason = writeOffReasons.FirstOrDefault();
			_writeOffAmountManuallyChanged = false;
			return;
		}

		if (!_writeOffAmountManuallyChanged)
			WriteOffAmount = SuggestedWriteOffAmount;
	}

	private APAROffsetARRowDto? GetWriteOffRow()
	{
		if (!RequiresWriteOff)
			return null;

		var contextRow = ARAdjustments.FirstOrDefault();
		if (contextRow is null)
			return null;

		return new APAROffsetARRowDto
		{
			Id = Guid.NewGuid().ToString(),
			RowType = ARRowType.Adjustment,
			Amount = WriteOffAmount,
			AdjustmentReason = WriteOffReason,
			CustomerName = contextRow.CustomerName,
			CustomerNumber = contextRow.CustomerNumber,
			CustomerTrxId = contextRow.CustomerTrxId,
			PaymentScheduleId = contextRow.PaymentScheduleId,
			CurrencyCode = contextRow.CurrencyCode,
			GlAccountingDate = contextRow.GlAccountingDate
		};
	}
}
