@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.UI
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables

@inherits ComponentBase
@inject DialogService DialogService

<RadzenStack Orientation="Orientation.Vertical" Style="height: 100%;" Gap="1.6em">
	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Invoice Number to adjust" Variant="@Variant.Outlined">
			<RadzenTextBox @bind-Value="@InvoiceDetails.InvoiceNumber" ReadOnly />
		</RadzenFormField>

		<ComponentValidator ValidationName="@nameof(ARInvoiceOffsettingCreateValidationDto.InvoiceNumber)" />
	</RadzenStack>


	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<RadzenFormField Text="Remarks" Variant="@Variant.Outlined" Max>
			<RadzenTextArea @bind-Value="@remarks" Rows="4" />
		</RadzenFormField>
		<ComponentValidator ValidationName="@nameof(ARInvoiceOffsettingCreateValidationDto.Remarks)" />
	</RadzenStack>

	<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
		<SearchInvoiceCNDetails OnCnInvoicesChanged="HandleCnInvoicesChanged" OnSearchChanged="(isOnSearch) => null" OnLoadingChanged="(isLoading) => null" />
	</RadzenStack>

	<RadzenStack Visible="true" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
		<button @onclick="@((args) => DialogService.Close(true))" class="btn btn-danger">
			Close
		</button>
		<button @onclick="OnAdd" class="btn btn-outline-primary">
			Add
		</button>
	</RadzenStack>
</RadzenStack>

@code {

	[Parameter] public IList<ARInvoiceOffsettingRowDto> Rows { get; set; }
	[Parameter] public RadzenDataGrid<ARInvoiceOffsettingRowDto> Grid { get; set; }
	[Parameter] public InvoiceDetailsDto InvoiceDetails { get; set; }

	private RadzenDataGrid<InvoiceDetailsDto> dataGrid;
	private IList<InvoiceDetailsDto> cnInvoices = new List<InvoiceDetailsDto>();
	private string remarks = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();

	}

	private async Task OnAdd()
	{
		try
		{
			bool isInvoiceDiscounted = Rows.Any(i => i.InvoiceNumber == InvoiceDetails.InvoiceNumber);

			Guards.ThrowInvalidOperationIf(isInvoiceDiscounted, $"Invoice Number {InvoiceDetails.InvoiceNumber} has been added in the AR Offsetting adjustment table");

			var row = new ARInvoiceOffsettingRowDto(
				remarks ?? string.Empty,
				InvoiceDetails
			);
			row.CNInvoices = cnInvoices; // Pass the CN Invoices of Search CNInvoice Details Razor here

			Rows.Add(row);

			await Grid.Reload();
			DialogService.Close(true);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(Exceptions.GetMessage(ex), "Add Adjustment Failed");
		}
	}

	private Task HandleCnInvoicesChanged(IList<InvoiceDetailsDto> invoices)
	{
		cnInvoices = invoices;
		return Task.CompletedTask;
	}
}
