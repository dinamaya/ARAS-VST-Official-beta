@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Models.DTOs
<RadzenRow class="p-3" Gap="1em">
	<RadzenColumn Size="12">
		<h4 class="mb-3">Invoice Number</h4>
		<div class="border-dashed border-1 border-secondary border-radius-md p-3">
			<div class="d-flex align-items-center">
				<div class="form-group w-100">
					<div class="input-group bg-gray-200">
						<input class="form-control form-control-sm fs-6 letter-spacing-2 px-3 py-2" @bind-value="@InvoiceDetails.InvoiceNumber" type="text" disabled>
					</div>
				</div>
			</div>
			<p class="text-xs mb-1">You cannot generate <b>Invoice Number</b></p>
		</div>
	</RadzenColumn>

	<RadzenColumn Size="12" class="mt-3 mt-lg-0">
		<h4 class="mb-3">Other Information</h4>
		<RadzenRow Gap="1em" class="border-0 p-3 border-radius-md bg-gray-100">
			<RadzenColumn Size="12" SizeXL="6" SizeXS="12">
				<div class="mb-2 text-sm">Customer Name: <div class="text-dark font-weight-bold ms-2">@InvoiceDetails.CustomerName</div></div>
				<div class="mb-2 text-sm">Customer Number: <div class="text-dark ms-2 font-weight-bold letter-spacing-1">@InvoiceDetails.CustomerNumber</div></div>
			</RadzenColumn>
			<RadzenColumn Size="12" SizeXL="6" SizeXS="12">
				<div class="mb-2 text-sm">Invoice Date: <div class="text-dark font-weight-bold ms-2">@InvoiceDetails.InvoiceDate</div></div>
				<div class="mb-2 text-sm">Invoice Amount: <div class="text-dark font-weight-bold ms-2">@InvoiceDetails.InvoiceAmount.ToPhp()</div></div>
				<div class="mb-2 text-sm">Invoice Balance: <div class="text-dark font-weight-bold ms-2">@InvoiceDetails.InvoiceBalance.ToPhp()</div></div>
			</RadzenColumn>
		</RadzenRow>
	</RadzenColumn>
</RadzenRow>

@code {
	[Parameter] public InvoiceDetailsDto InvoiceDetails { get; set; }
}