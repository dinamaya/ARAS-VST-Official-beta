@using ARAS.Blazor.Services.Interfaces
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Radzen.Blazor
@using Radzen

@using ARAS.Blazor.Components.Layout

@inject NavigationManager Navigation
@inject IAuthService AuthService
@inherits LayoutComponentBase

<div>
	<RadzenNotification />
	<RadzenDialog />
	<main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
		<RadzenLayout Style="grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body'">
			@if (isAuthenticated)
			{
				<NavMenu />
			}

			<!-- BODY -->
			<RadzenBody>
				<div class="px-4">
					@Body
				</div>
			</RadzenBody>
		</RadzenLayout>
	</main>
	<div class="deploy-marker">@DeployMarker</div>
</div>

@code {
	bool isAuthenticated = false;
	private const string DeployMarker = "UAT marker: receipt-fix-2026-03-25";
	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		isAuthenticated = await AuthService.IsAuthenticated();
	}
}

<style>

	.rz-navigation-item, .rz-navigation-item-wrapper {
		margin: 0.5em 0.6em;
		border-radius: 0.8em;
	}

	.rz-navigation-item-wrapper.rz-navigation-item-wrapper-active, .rz-navigation-item-link {
		border-radius: 0.8em;
	}

	.rz-panel-menu .rz-navigation-item-wrapper:hover {
		border-radius: 0.8em;
	}

	.deploy-marker {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 1100;
		padding: 0.45rem 0.7rem;
		border-radius: 999px;
		background: #1f2937;
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
		opacity: 0.92;
	}
</style>
