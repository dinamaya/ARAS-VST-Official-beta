@page "/submissions/invoice/ofr/{RequestId:long}"
@page "/approvals/invoice/ofr/{RequestId:long}"

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting
@using ARAS.Blazor.Components.Pages.Requests.ARInvoiceOffsetting.Modal
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Implementations
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IQueryService QueryService
@inject IAuthService AuthService
@inject IARInvoiceOffsettingService ARInvoiceOffsettingService
@inject IRequestService RequestService
@inject INoteService NoteService

<h2>AR Invoice Offsetting</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	@if (isRequestUpdatable)
	{
		<SearchInvoiceDetails OnSelectInvoice="OpenAdd" />
	}

	@code { [Parameter, SupplyParameterFromQuery(Name = "q")] public string? QueryAction { get; set; } }
	@if (Utils.Equals(QueryAction, Queries.Success.CREATE))
	{
		<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
			Invoice Adjustment updated successfully
		</RadzenAlert>
	}
	@if (isStatusChangeable)
	{
		<RadzenColumn Size="12">
			<RadzenStack JustifyContent="JustifyContent.Right" Orientation="Orientation.Horizontal">
				<RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Reject" class="btn-danger" Icon="cancel" Click="OnReject" />
				<RadzenButton ButtonStyle="ButtonStyle.Warning" Text="Decline" class="btn-dark" Icon="thumb_down" Click="OnDecline" />
				<RadzenButton ButtonStyle="ButtonStyle.Success" Text="Approve" class="btn-success" Icon="thumb_up" Click="OnApprove" />
			</RadzenStack>
		</RadzenColumn>
	}

	@if (isReady)
	{
		<ARInvoiceOffsettingGrids @ref="invoiceOffsettingGrids"
								  ARInvoice="ARInvoice"
								  CNInvoice="CNInvoice"
								  IsEditable="@isRequestUpdatable"
								  CnTitle="CN/Sales Invoices"
								  OnRemoveARRow="OnRemoveARRow"
								  OnRemoveCNRow="OnRemoveCNRow" />
	}

	<RadzenRow>
		<RadzenColumn Size="12" SizeMD="4">
			<Timeline RequestId="@RequestId" />
		</RadzenColumn>
		<RadzenColumn Size="12" SizeMD="8">
			<AttachmentsDatatable Notes="Notes" ShowOtherColumns="true" />
		</RadzenColumn>
	</RadzenRow>

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
		<RadzenRow>
			<RadzenColumn>
				<RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Submit" class="btn-primary" Icon="send" Click="OnSubmit" />
			</RadzenColumn>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>

<input type="hidden" value="@inputHash" />

@code {
	[Parameter] public long RequestId { get; set; }

	[Parameter] public IList<ARInvoiceOffsettingRowDto> ARInvoice { get; set; }
	[Parameter] public IList<ARInvoiceOffsettingRowDto> CNInvoice { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();

	private InvoiceDetailsDto searchedInvoiceNumber;
	private ARInvoiceOffsettingGrids? invoiceOffsettingGrids;

	private bool isOnSearch;
	private bool isLoading;
	private bool isReady = false;
	private bool isUpdatable = false;
	private bool isStatusChangeable = false;
	private bool isRequestUpdatable => isUpdatable && role == "Requestor";
	private string role;
	private string requestStatus = string.Empty;
	private string inputHash = string.Empty;	// track newly added rows so we can remove them on cancel if they remain empty
	private HashSet<string> newlyAddedRowIds = new();

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		var adjustments = await ARInvoiceOffsettingService.GetAdjustments(RequestId);
		CNInvoice = adjustments.Where(a => a.Type == "CN").ToList();
		ARInvoice = adjustments.Where(a => a.Type == "AR").ToList();
		searchedInvoiceNumber = new InvoiceDetailsDto();

		role = await AuthService.GetRole();
			var request = await RequestService.GetRequestDetails(RequestId);
			requestStatus = request.Status;
			isReady = true;
			isUpdatable = await RequestService.IsUpdatable(RequestId);
			var hashedAdjustments = CNInvoice.Concat(ARInvoice);
			inputHash = Utils.Security.ObjectHash(hashedAdjustments);

			isStatusChangeable = role.CanUpdateApprovalStatus(requestStatus);
		Notes = await NoteService.GetRows(RequestId);
		StateHasChanged();

		if (invoiceOffsettingGrids?.CNGrid is not null)
			await invoiceOffsettingGrids.CNGrid.Reload();
	}

	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		var arGrid = invoiceOffsettingGrids?.ARGrid;
		var cnGrid = invoiceOffsettingGrids?.CNGrid;

		if (arGrid is null || cnGrid is null)
			throw new InvalidOperationException("Invoice grids are not ready.");

		await DialogService.OpenAsync<AddARInvoiceOffsetting>(
			"Confirm AR Invoice Number",
			new Dictionary<string, object>()
			{
				{ "ARRows", ARInvoice },
				{ "ARGrid", arGrid },
				{ "CNRows", CNInvoice },
				{ "CNGrid", cnGrid },
				{ "InvoiceDetails", invoiceDetails },

			},
			new DialogOptions() { Width = "800px", Height = "auto" }
		);
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(!ARInvoice.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			bool isConfirmed = await DialogService.Confirm("Would you like to submit the following \"Invoice Adjustment(s)\"?", "Update AR Invoice Offset Request") ?? false;
			if (!isConfirmed)
				return;

			// row-level validation before opening modal
			if (!ValidateARRows(out var message))
			{
				await DialogService.Alert(message, "Validation Failed");
				return;
			}

			if (!ValidateCNRows(out message))
			{
				await DialogService.Alert(message, "Validation Failed");
				return;
			}

			var arTotal = ARInvoice.Sum(a => a.InvoiceBalance);
			var cnTotal = Math.Round(CNInvoice.Sum(a => a.AdjustedAmount), 2);

			Guards.ThrowInvalidOperationIf((Math.Round(arTotal + cnTotal, 2) != 0d), "AR and CN/Sales Invoice amounts must balance to zero.");
			await SubmitRequest();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		IEnumerable<ARInvoiceOffsettingRowDto> data = CNInvoice.Concat(ARInvoice);
		string newHash = Utils.Security.ObjectHash(data);
		bool _isUpdatable = isRequestUpdatable && !newHash.Equals(inputHash);

		Guards.ThrowInvalidOperationIf(newHash.Equals(inputHash), "No changes detected in the current request.");
		await ARInvoiceOffsettingService.Update(_isUpdatable, RequestId, ARInvoice, CNInvoice, Notes);
		RefreshPage();
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

	private async Task AddInvoiceRow()
	{
		var newRow = new ARInvoiceOffsettingRowDto
		{
			Id = Guid.NewGuid().ToString(),
			InvoiceNumber = string.Empty,
			InvoiceAmount = 0.00d
		};

		ARInvoice.Add(newRow);
		newlyAddedRowIds.Add(newRow.Id);
		if (invoiceOffsettingGrids?.ARGrid is not null)
		{
			await invoiceOffsettingGrids.ARGrid.Reload();
			await invoiceOffsettingGrids.ARGrid.EditRow(newRow);
		}
	}

	private async Task OnRemoveARRow(ARInvoiceOffsettingRowDto item)
	{
		ARInvoice.Remove(item);
		newlyAddedRowIds.Remove(item?.Id);
		if (invoiceOffsettingGrids?.ARGrid is not null)
			await invoiceOffsettingGrids.ARGrid.Reload();
		StateHasChanged();
	}

	private async Task OnRemoveCNRow(ARInvoiceOffsettingRowDto item)
	{
		CNInvoice.Remove(item);
		if (invoiceOffsettingGrids?.CNGrid is not null)
			await invoiceOffsettingGrids.CNGrid.Reload();
	}

	private async Task CancelEditRow(ARInvoiceOffsettingRowDto data)
	{
		if (invoiceOffsettingGrids?.CNGrid is null)
			return;

		invoiceOffsettingGrids.CNGrid.CancelEditRow(data);

		if (data != null && !string.IsNullOrEmpty(data.Id) && newlyAddedRowIds.Contains(data.Id))
		{
			if (IsRowEffectivelyEmpty(data))
			{
				CNInvoice.Remove(data);
				newlyAddedRowIds.Remove(data.Id);
				await invoiceOffsettingGrids.CNGrid.Reload();
			}
			else
			{
				newlyAddedRowIds.Remove(data.Id);
			}
		}
	}

	private bool IsRowEffectivelyEmpty(ARInvoiceOffsettingRowDto row)
	{
		if (row == null)
		{
			return true;
		}
		else
		{
			return (row.InvoiceBalance == 0.0 && row.AdjustedAmount == 0.0);
		}
	}

	private bool ValidateARRows(out string message)
	{
		message = string.Empty;

		if (ARInvoice == null || !ARInvoice.Any())
		{
			message = "AR Group has no rows.";
			return false;
		}

		foreach (var ar in ARInvoice)
		{
			if (ar == null)
			{
				message = "AR Group contains an invalid row.";
				return false;
			}
		}

		return true;
	}

	private bool ValidateCNRows(out string message)
	{
		message = string.Empty;

		if (CNInvoice == null || !CNInvoice.Any())
		{
			message = "CN/SI Group has no rows.";
			return false;
		}

		foreach (var cn in CNInvoice)
		{
			if (cn == null)
			{
				message = "CN/SI Group contains an invalid row.";
				return false;
			}

			if (cn.AdjustedAmount == 0)
			{
				message = $"CN/SI Group: Adjusted Amount must not be 0.00 for '{cn.InvoiceNumber ?? "unknown"}'.";
				return false;
			}

			if (Math.Round(cn.AdjustedAmount, 2) != cn.AdjustedAmount)
			{
				message = $"CN/SI Group: Adjusted Amount must use at most 2 decimal places for '{cn.InvoiceNumber ?? "unknown"}'.";
				return false;
			}
		}

		return true;
	}

	protected async Task OnApprove()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"APPROVE\" this request?", "Approve Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Approve(RequestId, Notes, null);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Approval Failed");
		}
	}

	protected async Task OnDecline()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"DECLINE\" this request?", "Decline Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Decline(RequestId, Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Decline Failed");
		}
	}

	protected async Task OnReject()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"REJECT\" this request?", "Reject Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Reject(RequestId, Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Decline Failed");
		}
	}

	protected void RefreshPage()
	{
		var uri = NavigationManager.GetUriWithQueryParameter("q", Queries.Success.CREATE);
		NavigationManager.NavigateTo(uri, true);
	}
}
