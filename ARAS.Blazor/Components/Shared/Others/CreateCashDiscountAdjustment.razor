@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Components.UI
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@inherits ComponentBase
@inject DialogService DialogService

<RadzenFieldset>
    <HeaderTemplate>
		<RadzenStack class="h-100" Gap="1.7em" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
			<RadzenLabel Text="Cash Discount" class="fs-5" />
		</RadzenStack>
    </HeaderTemplate>
    <ChildContent>
		<RadzenRow Gap="1em" JustifyContent="JustifyContent.Start">
			<RadzenColumn Size="12">
				<RadzenRow class="w-100" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Stretch">
					<RadzenColumn Size="12" SizeMD="5">
						<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
							<RadzenFormField class="w-100" Text="Discount Percentage" Variant="Variant.Outlined">
								<RadzenNumeric class="w-100"
									TValue="double"
									Value="@DiscountPercentage"
									Change="@(val => OnPercentageChanged(val))"
									Max="100"
									Disabled="!isAdjustable" />
							</RadzenFormField>
						</RadzenStack>
					</RadzenColumn>

					<RadzenColumn Size="12" SizeMD="1">
						<RadzenStack class="h-100 pb-2" Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
							or
						</RadzenStack>
					</RadzenColumn>

					<RadzenColumn Size="12" SizeMD="6">
						<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
							<RadzenFormField Text="Discount Value" Variant="Variant.Outlined">
								<RadzenNumeric TValue="double"
									@bind-Value="@discountDecimal"
									Max="(decimal)InvoiceAmount"
									Change="(val) => OnDecimalChanged(val)"
									Disabled="!isAdjustable" />
							</RadzenFormField>
						</RadzenStack>
					</RadzenColumn>
				</RadzenRow>
			</RadzenColumn>
		</RadzenRow>

		<RadzenStack Orientation="Orientation.Vertical" Gap="0.2rem">
			<RadzenFormField Text="Remarks" Variant="@Variant.Outlined" Max>
				<RadzenTextArea 
					@bind-Value="remarks" 
					Rows="@RemarksRowCount" 
					Change="OnRemarksChanged"
					Disabled="!isAdjustable" />
			</RadzenFormField>
		</RadzenStack>
	</ChildContent>
</RadzenFieldset>

@code {
	[Parameter] public double InvoiceAmount { get; set; }
	[Parameter] public double InvoiceBalance { get; set; }
	[Parameter] public string AdjustmentActivity { get; set; }
	[Parameter] public int RemarksRowCount { get; set; } = 3;
	[Parameter] public EventCallback<AdjustmentEntry> AdjustmentAmountChanged { get; set; }
	[Parameter] public string? InitialRemarks { get; set; }
	[Parameter] public double InitialDiscount { get; set; } = 0d;

	private IEnumerable<string> invoices = new List<string>();

	private string remarks = string.Empty;
	private double discountDecimal = 0;
	private double DiscountPercentage => InvoiceAmount == 0 ? 0 : Math.Round((discountDecimal / InvoiceAmount) * 100, 2);
	private bool isAdjustable = false;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		Reset();
	}

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
		isAdjustable = InvoiceBalance > 0;
	}

	public void Reset()
	{
		remarks = InitialRemarks ?? string.Empty;
		discountDecimal = InitialDiscount;
	}

	private async Task OnPercentageChanged(double val)
	{
		discountDecimal = Math.Round((val / 100) * InvoiceAmount, 2);
		await InvokeAdjustmentChanged();
	}

	private async Task OnDecimalChanged(double val)
	{
		discountDecimal = val;
		await InvokeAdjustmentChanged();
	}

	private async Task OnRemarksChanged(string val) => await InvokeAdjustmentChanged();

	private async Task InvokeAdjustmentChanged()
	{
		await AdjustmentAmountChanged.InvokeAsync(new()
		{
			Name = "Cash Discount",
			Amount = discountDecimal,
			Remarks = remarks
		});
	}

	public AdjustmentEntry GetCurrentEntry() => new()
	{
		Name = "Cash Discount",
		Amount = discountDecimal,
		Remarks = remarks
	};
}
