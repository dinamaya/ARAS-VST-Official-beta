@page "/submissions/receipt/{TypeCode}/{RequestId:long}"
@page "/approvals/receipt/{TypeCode}/{RequestId:long}"
@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.DataTables
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Repositories.Interfaces
@using ARAS.Blazor.Components.Shared.Others
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Main.Oracle.Api.Models.Dtos
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IRequestService RequestService
@inject IInvoiceService InvoiceService
@inject IQueryService QueryService
@inject IAuthService AuthService

<h2>@adjustmentName</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	@if (isReady)
	{
		<RadzenRow>
			@code { [Parameter, SupplyParameterFromQuery(Name = "q")] public string? QueryAction { get; set; } }
			@if (Utils.Equals(QueryAction, Queries.Success.CREATE))
			{
				<RadzenAlert class="m-0 border-radius-2xl" Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Size="AlertSize.Medium" AllowClose=true>
					@adjustmentName Adjustment updated successfully
				</RadzenAlert>
			}
		@if (isStatusChangeable)
			{
				<RadzenColumn Size="12">
					<RadzenStack JustifyContent="JustifyContent.Right" Orientation="Orientation.Horizontal">
						<RadzenButton ButtonStyle="ButtonStyle.Danger" Text="Reject" class="btn-danger" Icon="cancel" Click="OnReject" />
						<RadzenButton ButtonStyle="ButtonStyle.Warning" Text="Decline" class="btn-dark" Icon="thumb_down" Click="OnDecline" />
						<RadzenButton ButtonStyle="ButtonStyle.Success" Text="Approve" class="btn-success" Icon="thumb_up" Click="OnApprove" />
					</RadzenStack>
				</RadzenColumn>
			}

			<RadzenColumn Size="12" SizeLG="@(isRequestUpdatable ? 4 : 6)">
				<InvoiceSummary InvoiceDetails="invoice"/>
			</RadzenColumn>
			
			@if (isRequestUpdatable)
			{
				<RadzenColumn Size="12" SizeLG="8">
					<CardStandard HeaderIcon="edit" HeaderText="Update Adjustment">
						<HeaderActions>
							<RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Submit" class="btn-primary" Icon="send" Click="OnSubmit" />
						</HeaderActions>
						<BodyTtemplate>
							@if(TypeCode == "cdr")
							{
								<CreateCashDiscountAdjustment 
									@ref="cashDiscountAdjustment"
									AdjustmentAmountChanged="HandleAdjustment"
									InitialRemarks="@details.Remarks"
									InitialDiscount="@details.AdjustmentAmount"
									InvoiceAmount="@invoice.InvoiceAmount"
									InvoiceBalance="@invoice.InvoiceBalance"
									RemarksRowCount="11" />
							}
							else
							{
								<BaseReceiptAdjustment 
									@ref="baseReceiptAdjustment"
									AdjustmentName="@adjustmentName" 
									IsAdjustable="true" 
									InitialRemarks="@details.Remarks"
									InitialAdjustment="@details.AdjustmentAmount"
									AdjustmentAmountChanged="HandleAdjustment" />
							}
						</BodyTtemplate>
					</CardStandard>
				</RadzenColumn>
			}
			else
			{
				<RadzenColumn Size="12" SizeLG="6">
					<CardStandard HeaderIcon="update" HeaderText="Update Adjustment">
						<BodyTtemplate>
							<RadzenColumn Size="12" class="mt-3 mt-lg-0">
								<h4 class="mb-3">Other Information</h4>
								<RadzenRow Gap="1em" class="border-0 p-3 border-radius-md bg-gray-100">
									<RadzenColumn Size="12" SizeXL="6" SizeXS="12">
										@if (TypeCode == "cdr")
										{
											<div class="mb-2 text-sm">Discount Percentage: <div class="text-dark font-weight-bold ms-2">@(invoice.InvoiceAmount == 0 ? 0 : Math.Round((details.AdjustmentAmount / invoice.InvoiceAmount) * 100, 2)) %</div></div>
											<div class="mb-2 text-sm">Discount Value: <div class="text-dark font-weight-bold ms-2">@details.AdjustmentAmount.ToPhp()</div></div>
										}
										else
										{
											<div class="mb-2 text-sm">Adjustment Amount: <div class="text-dark font-weight-bold ms-2">@details.AdjustmentAmount.ToPhp()</div></div>
										}
									</RadzenColumn>
									<RadzenColumn Size="12" SizeXL="6" SizeXS="12">
										<div class="mb-2 text-sm">Remarks: </div>
										<RadzenTextArea class="w-100" Disabled="true" Value="@details.Remarks"/>
									</RadzenColumn>
								</RadzenRow>
							</RadzenColumn>
						</BodyTtemplate>
					</CardStandard>
				</RadzenColumn>
			}
		</RadzenRow>
		
		<RadzenRow>
			<RadzenColumn Size="12" SizeMD="4">
				<Timeline Transactions="details.TransactionHistories" />
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="8">
				<AttachmentsDatatable Notes="@details.Notes" ShowOtherColumns=true />
			</RadzenColumn>
		</RadzenRow>
	}
</RadzenStack>

	@code {
	[Parameter] public long RequestId { get; set; }
	[Parameter] public string TypeCode { get; set; }

	private RequestAuditDto requestAudit;
	private ReceiptAdjustmentUpdateResponseDto details;
	private InvoiceDetailsDto invoice;
	private ReceiptAdjustmentUpdateRequestDto data;
	private BaseReceiptAdjustment? baseReceiptAdjustment;
	private CreateCashDiscountAdjustment? cashDiscountAdjustment;

	private bool isOnSearch;
	private bool isLoading;
	private bool isReady;
	private bool isCashDiscountInitialized;
	private bool isUpdatable;
	private bool isStatusChangeable = false;
	private string role;
	private string requestStatus = string.Empty;
	private string adjustmentName;
	private string inputHash = string.Empty;
	private bool isRequestUpdatable => isUpdatable && role == "Requestor";

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();
	}

	protected override async Task OnInitializedAsync()
	{
		isReady = false;

		switch(TypeCode)
		{
			case "cdr":
				adjustmentName = "Cash Discount";
				isCashDiscountInitialized = true;
				break;
			case "bca":
				adjustmentName = "Bank Charge";
				isCashDiscountInitialized = true;
				break;
			case "sar":
				adjustmentName = "Write Off Small Amount";
				break;
		};

		try
		{
			await base.OnInitializedAsync();
			details = await RequestService.GetReceiptDetails(RequestId);
			role = await AuthService.GetRole();
			var request = await RequestService.GetRequestDetails(RequestId);
			requestStatus = request.Status;
			isUpdatable = await RequestService.IsUpdatable(RequestId);
			isStatusChangeable = role.CanUpdateApprovalStatus(requestStatus);
			data = new ReceiptAdjustmentUpdateRequestDto
			{
				AdjustmentAmount = details.AdjustmentAmount,
				Remarks = details.Remarks
			};
			inputHash = Utils.Security.ObjectHash(data);
			invoice = await InvoiceService.GetDetails(details.Invoice);
		}
		catch(Exception ex)
		{
			await DialogService.Alert(ex.Message, "Initialization Failed");
		}
		isReady = true;
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to submit the changes of the current request?", "Update Submit Confirmation") ?? false;

			if (!isConfirmed) return;

			SynchronizeAdjustmentInput();

			if (isRequestUpdatable)
			{
				string newHash = Utils.Security.ObjectHash(data);
				Guards.ThrowInvalidOperationIf(newHash.Equals(inputHash), "No changes detected in the current request.");
			}

			await RequestService.Update(isRequestUpdatable, RequestId, data, details.Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	private void HandleAdjustment(AdjustmentEntry entry)
	{
		data.AdjustmentAmount = entry.Amount;
		data.Remarks = entry.Remarks;
	}

	private void SynchronizeAdjustmentInput()
	{
		AdjustmentEntry? entry = TypeCode == "cdr"
			? cashDiscountAdjustment?.GetCurrentEntry()
			: baseReceiptAdjustment?.GetCurrentEntry();

		if (entry is null)
			return;

		data.AdjustmentAmount = entry.Amount;
		data.Remarks = entry.Remarks;
	}

	private void HandleSearchChanged(bool value) => isOnSearch = value;
	private void HandleLoadingChanged(bool value) => isLoading = value;

	protected async Task OnApprove()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"APPROVE\" this request?", "Approve Request") ?? false;
			if (!isConfirmed) return;
			var stagingDetails = await RequestService.IsFinalApprover() ? await RequestService.GetReceiptStagingDataByRequestId(RequestId) : null;
			await RequestService.Approve(RequestId, details.Notes, stagingDetails);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Approval Failed");
		}
	}

	protected async Task OnDecline()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"DECLINE\" this request?", "Decline Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Decline(RequestId, details.Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Decline Failed");
		}
	}

	protected async Task OnReject()
	{
		try
		{
			bool isConfirmed = await DialogService.Confirm("Are you sure you want to \"REJECT\" this request?", "Reject Request") ?? false;
			if (!isConfirmed) return;

			await RequestService.Reject(RequestId, details.Notes);
			RefreshPage();
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Decline Failed");
		}
	}

	protected void RefreshPage()
	{
		var uri = NavigationManager.GetUriWithQueryParameter("q", Queries.Success.CREATE);
		NavigationManager.NavigateTo(uri, true);
	}
}
