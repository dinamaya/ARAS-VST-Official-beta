@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.UI
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@inherits ComponentBase
@inject IOpsService OpsService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<RadzenStack Orientation="Orientation.Vertical" Style="height: 100%;">
	<RadzenRow Gap="1rem">
		<RadzenColumn Size="12" SizeMD="6">
			<RadzenFormField class="w-100" Text="First Name" Variant="@Variant.Outlined" Max>
				<RadzenTextBox @bind-Value="@accountEditRequest.FirstName" Disabled="true" />
			</RadzenFormField>
			<ComponentValidator ValidationName="@nameof(accountEditRequest.FirstName)" />
		</RadzenColumn>

		<RadzenColumn Size="12" SizeMD="6">
			<RadzenFormField class="w-100" Text="Last Name" Variant="@Variant.Outlined" Max>
				<RadzenTextBox @bind-Value="@accountEditRequest.LastName" Disabled="true" />
			</RadzenFormField>
			<ComponentValidator ValidationName="@nameof(accountEditRequest.LastName)" />
		</RadzenColumn>
	</RadzenRow>

	<RadzenRow Gap="1rem">
		<RadzenColumn Size="12" SizeMD="6">
			<RadzenFormField class="w-100 mt-3" Text="Role" Variant="@Variant.Outlined" Max>
				<RadzenTextBox Value="Managed by URMS" Disabled="true" />
			</RadzenFormField>
		</RadzenColumn>

		<RadzenColumn Size="12" SizeMD="6">
			<RadzenFormField class="w-100 mt-3" Text="Group Code" Variant="@Variant.Outlined" Max>
				<RadzenTextBox @bind-Value="accountEditRequest.GroupCode" />
			</RadzenFormField>
			<ComponentValidator ValidationName="@nameof(accountEditRequest.GroupCode)" />
		</RadzenColumn>
	</RadzenRow>

	<RadzenRow class="ps-4">
		<RadzenCheckBox @bind-Value="accountEditRequest.IsActive" Name="Active" />
		<RadzenLabel Text="Active" Component="IsActive" class="rz-ms-2" />
	</RadzenRow>

	<RadzenStack Visible="@ShowClose" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
		<button @onclick="@((args) => DialogService.Close(true))" class="btn btn-danger">
			Close
		</button>
		<button @onclick="OnSubmit" class="btn btn-outline-primary">
			Submit
		</button>
	</RadzenStack>
</RadzenStack>

@code {
	[Parameter] public RadzenDataGrid<AccountRowDto> DataGrid { get; set; }
	[Parameter] public string AccountId { get; set; } = string.Empty;
	[Parameter] public bool ShowClose { get; set; } = true;
	private AccountEditRequestDto accountEditRequest;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		accountEditRequest = new AccountEditRequestDto();
	}

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();

		if (!string.IsNullOrEmpty(AccountId))
		{
			accountEditRequest = await OpsService.GetAccountById(AccountId);
		}
	}

	private async Task OnSubmit()
	{
		try
		{
			bool isSuccess = await OpsService.Update(accountEditRequest);
			if (!isSuccess) return;

			DialogService.Close();
			NavigationManager.NavigateTo("/ops/accounts", true);
		}
		catch(Exception ex)
		{
			await DialogService.Alert(ex.Message, "Failed to update account details");
		}

	}
}
