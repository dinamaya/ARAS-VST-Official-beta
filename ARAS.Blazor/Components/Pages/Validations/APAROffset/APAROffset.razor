@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables;
@using Microsoft.AspNetCore.Authorization

@page "/validations/apar-offset"

@attribute [Authorize(Roles = "Validator")]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IAPAROffsetService APAROffsetService

<h3>AP AR: Offset</h3>

<RequestDataTable ViewRoute="validations/apar-offset" SelectButtonTitle="Update" OnDateLoad="@(OnDataLoad)" />

@code {

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	private async Task<IEnumerable<TransactionRequestRowDto>> OnDataLoad()
	{
		return await APAROffsetService.GetValidations();
	}
}
