@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Models.DTOs

<RadzenRow Gap="1.5rem">
	<RadzenColumn Size="6">
		<div class="text-center pb-3">
			<h3 class="pb-0 mb-0">INVOICES</h3>
		</div>
		<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid @ref="arGrid"
							AllowFiltering="false"
							AllowColumnResize="true"
							AllowAlternatingRows="false"
							AllowSorting="true"
							PageSize="20"
							AllowPaging="true"
							PagerHorizontalAlign="HorizontalAlign.Left"
							ShowPagingSummary="true"
							Data="@ARInvoice"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
					<RadzenDataGridColumn Property="@nameof(ARInvoiceOffsettingRowDto.InvoiceNumber)" Title="Invoice No.">
						<FooterTemplate>
							<b>Total Invoice Balance:</b>
						</FooterTemplate>
					</RadzenDataGridColumn>

					<RadzenDataGridColumn Property="@nameof(ARInvoiceOffsettingRowDto.CustomerName)" Title="Customer Name">
						<Template Context="data">
							@((string.IsNullOrWhiteSpace(data.CustomerName) ? data.CustomerNumber : data.CustomerName))
						</Template>
					</RadzenDataGridColumn>

					<RadzenDataGridColumn Property="@nameof(ARInvoiceOffsettingRowDto.InvoiceBalance)" Title="Invoice Balance">
						<Template Context="data">
							@data.InvoiceBalance.ToPhp()
						</Template>
						<FooterTemplate>
							<b>@ARInvoice?.Sum(a => a.InvoiceBalance).ToPhp()</b>
						</FooterTemplate>
					</RadzenDataGridColumn>

					@if (IsEditable)
					{
						<RadzenDataGridColumn TItem="ARInvoiceOffsettingRowDto" Context="data" TextAlign="TextAlign.Right">
							<Template Context="data">
								<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(async args => await OnRemoveARRow.InvokeAsync(data))" />
							</Template>
						</RadzenDataGridColumn>
					}
				</Columns>
			</RadzenDataGrid>
		</div>
	</RadzenColumn>

	<RadzenColumn Size="6">
		<div class="text-center pb-3">
			<h3 class="pb-0 mb-0">@CnTitle</h3>
		</div>

		<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid TItem="ARInvoiceOffsettingRowDto"
							@ref="cnGrid"
							Data="@CNInvoice"
							AllowFiltering="false"
							AllowPaging="false"
							AllowSorting="false"
							EditMode="DataGridEditMode.Single"
							ShowPagingSummary="false"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
					<RadzenDataGridColumn TItem="ARInvoiceOffsettingRowDto" Title="Invoice No.">
						<Template Context="data">
							<div>@data.InvoiceNumber</div>
						</Template>

						<FooterTemplate>
							<b>Total Invoice Balance:</b>
						</FooterTemplate>

						<EditTemplate Context="data">
							<div>@data.InvoiceNumber</div>
						</EditTemplate>
					</RadzenDataGridColumn>

					<RadzenDataGridColumn TItem="ARInvoiceOffsettingRowDto" Title="Customer Name">
						<Template Context="data">
							<div>@data.CustomerName</div>
						</Template>
					</RadzenDataGridColumn>

					<RadzenDataGridColumn TItem="ARInvoiceOffsettingRowDto" Property="@nameof(ARInvoiceOffsettingRowDto.InvoiceBalance)" Title="Invoice Balance">
						<Template Context="data">
							@data.InvoiceBalance.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
						</Template>
						<FooterTemplate>
							<b>@CNInvoice.Sum(a => a.InvoiceBalance).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b>
						</FooterTemplate>
					</RadzenDataGridColumn>

					<RadzenDataGridColumn TItem="ARInvoiceOffsettingRowDto" Property="@nameof(ARInvoiceOffsettingRowDto.AdjustedAmount)" Title="Adjusted Amount">
						<Template Context="data">
							@if (IsEditable)
							{
								<div style="position: relative; z-index: 1;">
									<RadzenNumeric @bind-Value="data.AdjustedAmount"
												   Name="@($"AdjustedAmount_{data.Id}")"
												   Style="width:100%"
												   Step="0.01" />
								</div>
							}
							else
							{
								@data.AdjustedAmount.ToString("C2", new System.Globalization.CultureInfo("en-PH"))
							}
						</Template>

						<FooterTemplate>
							<b>@CNInvoice.Sum(a => a.AdjustedAmount).ToString("C2", new System.Globalization.CultureInfo("en-PH"))</b>
						</FooterTemplate>
					</RadzenDataGridColumn>

					@if (IsEditable)
					{
						<RadzenDataGridColumn TItem="ARInvoiceOffsettingRowDto" Context="data" TextAlign="TextAlign.Right">
							<Template Context="data">
								<RadzenButton Icon="delete"
											  Size="ButtonSize.Small"
											  ButtonStyle="ButtonStyle.Danger"
											  Click="@(async args => await OnRemoveCNRow.InvokeAsync(data))" />
							</Template>
						</RadzenDataGridColumn>
					}
				</Columns>
			</RadzenDataGrid>
		</div>
	</RadzenColumn>
</RadzenRow>

@code {
	[Parameter] public IList<ARInvoiceOffsettingRowDto> ARInvoice { get; set; } = [];
	[Parameter] public IList<ARInvoiceOffsettingRowDto> CNInvoice { get; set; } = [];
	[Parameter] public bool IsEditable { get; set; } = true;
	[Parameter] public string CnTitle { get; set; } = "CN / SI";
	[Parameter] public EventCallback<ARInvoiceOffsettingRowDto> OnRemoveARRow { get; set; }
	[Parameter] public EventCallback<ARInvoiceOffsettingRowDto> OnRemoveCNRow { get; set; }

	private RadzenDataGrid<ARInvoiceOffsettingRowDto>? arGrid;
	private RadzenDataGrid<ARInvoiceOffsettingRowDto>? cnGrid;

	public RadzenDataGrid<ARInvoiceOffsettingRowDto>? ARGrid => arGrid;
	public RadzenDataGrid<ARInvoiceOffsettingRowDto>? CNGrid => cnGrid;
}
