@page "/requests/small-amount"
@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.App_Code.Globals.Extensions
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Requestor")]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject ITestService TestService
@inject IAuthService AuthService
@inject ISearchOptionService SearchOptionService
@inject ISmallAmountService SmallAmountService

<h2>Small Amount Adjustment</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenAdd" OnLoadingChanged="HandleLoadingChanged" OnSearchChanged="HandleSearchChanged" />

	<RadzenRow>
		<div>
			<h3 class="pb-0 mb-0">Small Amount</h3>
		</div>
		<div class="py-4 px-3 w-100 card">
			<RadzenDataGrid class="border-0"
							@ref="adjustmentGrid"
							AllowFiltering="true"
							AllowColumnResize="true"
							AllowAlternatingRows="false"
							FilterMode="FilterMode.Advanced"
							AllowSorting="true"
							PageSize="20"
							AllowPaging="true"
							PagerHorizontalAlign="HorizontalAlign.Left"
							ShowPagingSummary="true"
							Data="@Adjustments"
							LogicalFilterOperator="LogicalFilterOperator.Or"
							SelectionMode="DataGridSelectionMode.Single">
				<Columns>
					<RadzenDataGridColumn Frozen="true" Title="Edit" Sortable="false" Filterable="false" Width="80px" TextAlign="TextAlign.Center">
						<Template Context="data">
							<RadzenButton Icon="Edit" Variant="Variant.Outlined" Click="@(args => OpenEdit(data))" />
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.AdjustmentAmount)" Width="120px" Title="Adjustment Amount">
						<Template Context="data">
							@data.AdjustmentAmount.ToPhp()
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.InvoiceAmount)" Title="Invoice Amount">
						<Template Context="data">
							@data.InvoiceAmount.ToPhp()
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.InvoiceDate)" Title="Invoice Date" />
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.InvoiceNumber)" Title="Invoice Number" />
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.CustomerName)" Title="Customer Name" />
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.CustomerNumber)" Title="Customer Number" />
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.ReasonCode)" Title="Reason Code" />
					<RadzenDataGridColumn Property="@nameof(SmallAmountRowDto.Remarks)" Title="Remarks" />
				</Columns>
			</RadzenDataGrid>
		</div>

	</RadzenRow>

	<AttachmentsDatatable Notes="Notes" IsDownloadable=false />

	<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">

		<RadzenRow>
			<button class="btn btn-primary w-100 mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenRow>
	</RadzenStack>
</RadzenStack>



@code {
	[Parameter] public IList<SmallAmountRowDto> Adjustments { get; set; }
	private IList<NoteRowDto> Notes { get; set; } = new List<NoteRowDto>();
	private IEnumerable<string> reasonCodes { get; set; }

	private InvoiceDetailsDto searchedInvoiceNumber;
	private RadzenDataGrid<SmallAmountRowDto> adjustmentGrid;
	private RequestAuditDto requestAudit;

	private bool isOnSearch;
	private bool isLoading;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		Adjustments = new List<SmallAmountRowDto>();
		searchedInvoiceNumber = new InvoiceDetailsDto();
		requestAudit = new RequestAuditDto();

		reasonCodes = await SearchOptionService.GetReasonCodes();
		await TestService.GenerateAdjustmentRows(Adjustments, reasonCodes);
		await adjustmentGrid.Reload();

		requestAudit.Requestor = await AuthService.GetLastFirstName();
	}

	public async Task OpenAdd(InvoiceDetailsDto invoiceDetails)
	{
		try
		{
			await DialogService.OpenAsync<AddInvoiceAdjustmentModal<SmallAmountRowDto>>(
				"Add Small Amount Adjustment",
				new Dictionary<string, object>()
				{
					{ nameof(AddInvoiceAdjustmentModal<SmallAmountRowDto>.ReasonCodes), reasonCodes },
					{ nameof(AddInvoiceAdjustmentModal<SmallAmountRowDto>.InvoiceDetails), invoiceDetails},
					{ nameof(AddInvoiceAdjustmentModal<SmallAmountRowDto>.OnValidate), OnValidate},
					{ nameof(AddInvoiceAdjustmentModal<SmallAmountRowDto>.OnAdd), OnAdd},
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Add Adjustment Failed");
		}
	}

	public async Task OpenEdit(SmallAmountRowDto data)
	{
		try
		{
			await DialogService.OpenAsync<EditInvoiceAdjustmentModal<SmallAmountRowDto>>(
				"Edit Small Amount Adjustment",
				new Dictionary<string, object>()
				{
					{ nameof(EditInvoiceAdjustmentModal<SmallAmountRowDto>.ReasonCodes), reasonCodes },
					{ nameof(EditInvoiceAdjustmentModal<SmallAmountRowDto>.InvoiceDetails), data},
					{ nameof(EditInvoiceAdjustmentModal<SmallAmountRowDto>.OnEdit), OnEdit},
					{ nameof(EditInvoiceAdjustmentModal<SmallAmountRowDto>.OnDelete), OnDelete},
				},
				new DialogOptions() { Width = "800px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Edit Adjustment Failed");
		}
	}

	public async Task OnSubmit()
	{
		try
		{
			Guards.ThrowInvalidOperationIf(!Adjustments.Any(), "Can't submit request because there are no adjustment in the current request");
			Guards.ThrowInvalidOperationIf(isLoading, "Can't submit request while search operation is ongoing");

			await DialogService.OpenAsync<RequestAdjustmentsModalSummary>(
				"Submit Bank Charge Adjustment",
				new Dictionary<string, object>()
				{
					{ "Rows", Adjustments },
					{ "RequestAudit", requestAudit },
					{ "OnSubmit", SubmitRequest },
					{ "SucccessSubmissionRoute", "/requests/bank-charge" },
				},
				new DialogOptions() { Width = "1500px", Height = "auto" }
			);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}

	public async Task SubmitRequest()
	{
		await SmallAmountService.Create(Adjustments, Notes);
	}

	private void HandleSearchChanged(bool value)
	{
		isOnSearch = value;
	}

	private void HandleLoadingChanged(bool value)
	{
		isLoading = value;
	}

	private async Task OnAdd(double amount, string remarks, string reasonCode, InvoiceDetailsDto details)
	{
		var row = new SmallAmountRowDto(amount, remarks, reasonCode, details);
		Adjustments.Add(row);
		await adjustmentGrid.Reload();
	}

	private async Task OnEdit(double amount, string remarks, string reasonCode, SmallAmountRowDto details)
	{
		var data = Adjustments.FirstOrDefault(r => r.Id == details.Id) ?? throw new Exception("Data is not found in the Small Amount adjustment table");
		data.SetValues((float) amount, remarks, reasonCode);

		await adjustmentGrid.Reload();
	}

	private async Task OnDelete(SmallAmountRowDto details)
	{
		Adjustments.Remove(details);
		await adjustmentGrid.Reload();
	}

	private async Task OnValidate(double amount, string remarks, string reasonCode, InvoiceDetailsDto details)
	{
		var adjustments = Adjustments.Where(a => a.InvoiceNumber.Trim() == details.InvoiceNumber);

		if (!adjustments.Any()) return;

		var sum = adjustments.Sum(a => a.AdjustmentAmount);

		Guards.ThrowInvalidOperationIf(sum > details.InvoiceAmount, "The sum of the adjustment amount already exceeded the invoice amount");
	}
}
