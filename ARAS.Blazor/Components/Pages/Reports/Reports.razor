@page "/reports/all-reports"
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@inject IReportService ReportService

<h3>Latest Requests</h3>

@if (isLoading)
{
	<p>Loading...</p>
}
else if (!string.IsNullOrEmpty(error))
{
	<div class="alert alert-danger">@error</div>
}
else
{
	<RadzenDataGrid AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" AllowSorting="true"
					PageSize="20" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"
					Data="@rows" LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single">
		<Columns>
			<RadzenDataGridColumn Property="RequestNumber" Title="Request Number" Width="200px" />
			<RadzenDataGridColumn Property="AdjustmentTypeCode" Title="Adjustment Type" Width="200px" />
			<RadzenDataGridColumn Property="DateRequested" Title="Date Requested" Width="200px" FormatString="{0:yyyy-MM-dd}" />
			<RadzenDataGridColumn Property="Status" Title="Status" Width="180px" />
		</Columns>
	</RadzenDataGrid>
}
@code {
	private IEnumerable<ReportsDto> rows = Array.Empty<ReportsDto>();
	private bool isLoading;
	private string error = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		isLoading = true;
		try
		{
			rows = await ReportService.GetLatestRequestsAsync();
		}
		catch (Exception ex)
		{
			error = $"Failed to load report: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}
}