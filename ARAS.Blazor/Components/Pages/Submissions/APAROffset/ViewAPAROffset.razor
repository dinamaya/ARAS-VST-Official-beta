@using ARAS.Blazor.Components.Shared
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Pages.Requests.APAROffset.Summaries
@using ARAS.Blazor.Components.Shared.DataTables

@using Microsoft.AspNetCore.Authorization
@page "/submissions/apar-offset/{RequestId:long}"
@attribute [Authorize]
@inject IAPAROffsetService APAROffsetService
@inject IRequestService RequestService
@inject INoteService NoteService
@inject DialogService DialogService

@inherits ComponentBase

<h3>View AP AR : Offset</h3>
<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<RadzenRow>
		<RadzenColumn Size="12">
			<div class="py-4 px-3 w-100 card">
				<APAROffsetSummary APAdjustments="apRows" ARAdjustments="arRows" RequestAudit="requestAudit" />
			</div>
		</RadzenColumn>
		<RadzenColumn Size="4">
			<Timeline RequestId="@RequestId" />
		</RadzenColumn>
		<RadzenColumn Size="8">
			<AttachmentsDatatable Notes="@notes" IsReadOnly="true" ShowOtherColumns=true ShowAddButton=false />
		</RadzenColumn>
	</RadzenRow>
</RadzenStack>

@code {
	[Parameter] public long RequestId { get; set; }
	private IEnumerable<APAROffsetAPRowDto> apRows;
	private IEnumerable<APAROffsetARRowDto> arRows;
	private IList<NoteRowDto> notes;

	private RequestAuditDto requestAudit;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		var request = await APAROffsetService.GetRequestDetails(RequestId);
		(apRows, arRows) = await APAROffsetService.GetAdjustments(RequestId);
		notes = await NoteService.GetRows(RequestId);
		// requestAudit = new RequestAuditDto(request);
	}
}
