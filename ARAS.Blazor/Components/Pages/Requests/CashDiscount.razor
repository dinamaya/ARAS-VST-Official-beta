@page "/requests/cash-discount"
@attribute [Authorize(Roles = "Requestor")]
@inherits CreateReceiptRequestBaseComponent<CashDiscountRowDto>

@using ARAS.Blazor.App_Code.Globals
@using ARAS.Blazor.Components.Shared.Modals
@using ARAS.Blazor.Components.Shared.Others
@using ARAS.Blazor.Components.Shared.Summaries
@using ARAS.Blazor.Models.Complex
@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables
@using Microsoft.AspNetCore.Authorization

@inject DialogService DialogService
@inject ITestService TestService
@inject ICashDiscountService CashDiscountService

<h2>Cash Discount</h2>

<RadzenStack Gap="2.3em" JustifyContent="JustifyContent.Center" Orientation="Orientation.Vertical">
	<SearchInvoiceDetails OnAdd="OpenCreate" OnLoadingChanged="OnLoadingChanged" OnSearchChanged="OnSearchToggle" />
	
	@if (!string.IsNullOrEmpty(SearchedInvoice.CustomerName))
	{
		<RadzenRow>
			<RadzenColumn Size="12" SizeMD="5">
				<InvoiceSummary InvoiceDetails="SearchedInvoice" />
			</RadzenColumn>
			<RadzenColumn Size="12" SizeMD="7">
				<CreateCashDiscountAdjustment InvoiceDetails="SearchedInvoice" @ref="AdjustmentComponent" />
			</RadzenColumn>
		</RadzenRow>

		<AttachmentsDatatable Notes="Notes" IsDownloadable=false />
		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
			<button class="btn btn-dark mt-2" @onclick="OnSubmit">
				Summary
			</button>
			<button class="btn btn-primary mt-2" @onclick="OnSubmit">
				Submit
			</button>
		</RadzenStack>
	}
</RadzenStack>
	@code {

	private CreateCashDiscountAdjustment AdjustmentComponent;
	protected async Task OpenCreate(InvoiceDetailsDto invoiceDetails)
	{
		SearchedInvoice = invoiceDetails;

		AdjustmentComponent?.Reset();
	}

	protected override async Task OnSubmit()
	{
		try
		{
			await base.OnSubmit();

			bool isConfirmed = await DialogService.Confirm("Submit Cash Discount Adjustment?", "Create Cash Discount") ?? false;

			if (!isConfirmed) return;

			var adjustment = AdjustmentComponent.GetAdjustment();

			await CashDiscountService.Create(adjustment, Notes);
		}
		catch (Exception ex)
		{
			await DialogService.Alert(ex.Message, "Request Submission Failed");
		}
	}
}
