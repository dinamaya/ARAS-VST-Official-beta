@using ARAS.Blazor.Models.DTOs
@using ARAS.Blazor.Services.Interfaces
@using ARAS.Blazor.Components.Shared.DataTables;
@using Microsoft.AspNetCore.Authorization

@page "/validations/ar-invoice-offsetting"

@attribute [Authorize(Roles = "Validator")]
@inherits ComponentBase
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IARInvoiceOffsettingService ARInvoiceOffsettingService

<h3>AR Invoice Offsetting</h3>

<RequestDataTable ViewRoute="validations/ar-invoice-offsetting" SelectButtonTitle="Update" OnDateLoad="@(OnDataLoad)" />

@code {

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
	}

	private async Task<IEnumerable<TransactionRequestRowDto>> OnDataLoad()
	{
		return await ARInvoiceOffsettingService.GetValidations();
	}
}
